export global Tema {
    in-out property <string> font-ui;
    in-out property <string> font-mono;
    // true in modul intunecat; doar pentru ce nu e o culoare (ex. opacitatea umbrelor)
    in-out property <bool> intunecat;
    in-out property <color> fundal;
    in-out property <color> strat;
    in-out property <color> panou-sursa;
    in-out property <color> cap-sursa;
    in-out property <color> cap-baza;
    in-out property <color> contur-baza;
    in-out property <color> pe-selectie;
    in-out property <color> accent;
    in-out property <color> pe-accent;
    in-out property <color> accent-text;
    in-out property <color> tine;
    in-out property <color> pe-tine;
    in-out property <color> set-bara;
    in-out property <color> ident;
    in-out property <color> harta-mod;
    in-out property <color> harta-add;
    in-out property <color> harta-del;
    in-out property <color> harta-gol;
    in-out property <color> suprafata;
    in-out property <color> cod-fundal;
    in-out property <color> linie;
    in-out property <color> linie-slaba;
    in-out property <color> text;
    in-out property <color> text-secundar;
    in-out property <color> text-tert;
    in-out property <color> selectie;
    in-out property <color> mod-text;
    in-out property <color> mod-fundal;
    in-out property <color> mod-bara;
    in-out property <color> mod-inlinie;
    in-out property <color> add-text;
    in-out property <color> add-fundal;
    in-out property <color> add-bara;
    in-out property <color> add-inlinie;
    in-out property <color> del-text;
    in-out property <color> del-fundal;
    in-out property <color> del-bara;
    in-out property <color> del-inlinie;
    in-out property <color> hasura-a;
    in-out property <color> hasura-b;
    in-out property <color> s-cuvant;
    in-out property <color> s-sir;
    in-out property <color> s-numar;
    in-out property <color> s-variabila;
    in-out property <color> s-comentariu;

    // Culorile unei stari de rand: 1 modificat, 2 doar in sursa, 3 doar in baza.
    public pure function fundal-stare(stare: int) -> color {
        return stare == 1 ? root.mod-fundal : stare == 2 ? root.add-fundal : root.del-fundal;
    }
    public pure function bara-stare(stare: int) -> color {
        return stare == 1 ? root.mod-bara : stare == 2 ? root.add-bara : root.del-bara;
    }
    public pure function inlinie-stare(stare: int) -> color {
        return stare == 1 ? root.mod-inlinie : stare == 2 ? root.add-inlinie : root.del-inlinie;
    }
    // In interiorul unui bloc diferit, numarul de linie ia culoarea blocului:
    // gri-ul tert ar cadea sub 4,5:1 pe fundalurile tinte (vezi jetoane.rs).
    public pure function numar-stare(stare: int) -> color {
        return stare == 0 ? root.text-tert
             : stare == 1 ? root.mod-text
             : stare == 2 ? root.add-text
             : root.del-text;
    }
}

// Camp de text pe un rand care se deruleaza dupa cursor: un text mai lung
// decat campul nu iese din chenar, iar ce scrii la capat ramane vizibil.
// `TextInput` singur nu face asta (sesizat de Mihai, 2026-11-20).
export component CampText inherits Rectangle {
    in-out property <string> text;
    in property <length> marime: 13px;
    out property <bool> are-focus: camp.has-focus;
    // cat e derulat textul spre stanga (<= 0)
    in-out property <length> dx: 0px;
    callback edited(string);
    public function focuseaza() { camp.focus(); }
    clip: true;
    camp := TextInput {
        // cand incape, sta la inceput; altfel nu lasa gol in dreapta
        x: Math.max(root.width - self.width, Math.min(0px, root.dx));
        width: Math.max(root.width, self.preferred-width + 2px);
        height: root.height;
        text <=> root.text;
        font-family: Tema.font-ui;
        font-size: root.marime;
        color: Tema.text;
        vertical-alignment: center;
        single-line: true;
        edited => { root.edited(self.text); }
        cursor-position-changed(p) => {
            if (p.x + self.x > root.width - 2px) { root.dx = root.width - 2px - p.x; }
            if (p.x + self.x < 0px) { root.dx = -p.x; }
        }
    }
}

export component Despartitor inherits Rectangle {
    width: 1px;
    height: 20px;
    background: Tema.linie;
}

export component Chevron inherits Path {
    in property <string> drum;
    in property <color> culoare: Tema.text;
    width: 12px;
    height: 12px;
    viewbox-width: 16;
    viewbox-height: 16;
    commands: drum;
    stroke: culoare;
    stroke-width: 1.8px;
    fill: transparent;
}

// Buton secundar: pe `strat`, contur de 1 px, colturi de 8 px.
export component Buton inherits Rectangle {
    in property <string> text;
    in property <length> inalt: 32px;
    in property <bool> apasabil: true;
    callback apasat();
    height: inalt;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tema.linie;
    background: zona.has-hover && root.apasabil ? Tema.linie : Tema.strat;
    opacity: root.apasabil ? 1 : 0.5;
    min-width: eticheta.preferred-width + 26px;
    eticheta := Text {
        text: root.text;
        font-family: Tema.font-ui;
        font-size: 13px;
        color: Tema.text;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    zona := TouchArea {
        enabled: root.apasabil;
        clicked => { root.apasat(); }
    }
}

// Butonul principal: chihlimbar (`accent`), scris cu `pe-accent`.
export component ButonPrincipal inherits Rectangle {
    in property <string> text;
    // `false`: cenusiu si fara clic („Deploy (0)" parea apasabil, V15)
    in property <bool> activ: true;
    callback apasat();
    height: 32px;
    border-radius: 8px;
    background: root.activ ? Tema.accent : Tema.strat;
    opacity: root.activ && zona.has-hover ? 0.88 : 1;
    min-width: eticheta.preferred-width + 28px;
    eticheta := Text {
        text: root.text;
        font-family: Tema.font-ui;
        font-size: 13px;
        font-weight: 600;
        color: root.activ ? Tema.pe-accent : Tema.text-tert;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    zona := TouchArea {
        enabled: root.activ;
        clicked => { root.apasat(); }
    }
}

// Tab cu sublinierea de 2 px (Alaturat / Unificat).
export component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> activ;
    callback apasat();
    height: 33px;
    min-width: eticheta.preferred-width;
    eticheta := Text {
        text: root.text;
        font-family: Tema.font-ui;
        font-size: 12.5px;
        font-weight: root.activ ? 600 : 400;
        color: root.activ ? Tema.text : Tema.text-secundar;
        vertical-alignment: center;
    }
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.activ ? Tema.accent : transparent;
    }
    TouchArea { clicked => { root.apasat(); } }
}

export component Bifa inherits Rectangle {
    in property <string> text;
    // `in`, nu `in-out`: bifa nu-si scrie singura starea. Scrisa de ea,
    // randul arata bifat fara sa fie, si un rand reciclat de `ListView`
    // arata apoi starea altui obiect (V9 din auditul QA).
    in property <bool> bifat;
    callback schimbat(bool);
    height: 16px;
    min-width: 13px + 6px + eticheta.preferred-width;
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 13px;
                height: 13px;
                border-radius: 4px;
                border-width: 1px;
                border-color: root.bifat ? Tema.accent : Tema.text-tert;
                background: root.bifat ? Tema.accent : transparent;
                if root.bifat: Path {
                    width: 9px;
                    height: 9px;
                    viewbox-width: 16;
                    viewbox-height: 16;
                    commands: "M 3 8.5 L 6 11.5 L 13 4.5";
                    stroke: Tema.pe-accent;
                    stroke-width: 2px;
                    fill: transparent;
                }
            }
        }
        eticheta := Text {
            text: root.text;
            font-family: Tema.font-ui;
            font-size: 12.5px;
            color: Tema.text;
            vertical-alignment: center;
        }
    }
    TouchArea {
        clicked => {
            root.schimbat(!root.bifat);
        }
    }
}

// --- piesele care tin ecranele impreuna: semnul, antetul, tema

// Semnul g•motion: acelasi pe toate ecranele.
export component Semn inherits HorizontalLayout {
    in property <length> marime: 18px;
    alignment: start;
    spacing: 0px;
    horizontal-stretch: 0;
    Text { text: "g"; font-family: Tema.font-ui; font-size: root.marime; font-weight: 600; color: Tema.text; vertical-alignment: center; }
    Rectangle {
        width: root.marime * 0.47;
        Rectangle {
            width: root.marime * 0.37;
            height: self.width;
            y: parent.height / 2 - 1px;
            border-radius: self.width / 2;
            background: Tema.accent;
        }
    }
    Text { text: "motion"; /* text-permis: marca */ font-family: Tema.font-ui; font-size: root.marime; font-weight: 600; color: Tema.text; vertical-alignment: center; letter-spacing: -0.4px; }
}

// Butonul dedicat temei: o iconita (luna / soare); la clic arata cele doua
// moduri si le alegi de acolo. Modul se schimba in Rust (`aplica_tema`).
export component ButonTema inherits Rectangle {
    callback alege(bool /* intunecat */);
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: zona.has-hover ? Tema.strat : transparent;
    // luna in modul intunecat, soare in cel luminos
    if Tema.intunecat: Path {
        width: 16px; height: 16px; viewbox-width: 16; viewbox-height: 16;
        commands: "M 12.5 10.2 A 5.6 5.6 0 1 1 6.3 3 A 4.6 4.6 0 0 0 12.5 10.2 Z";
        stroke: Tema.text-secundar; stroke-width: 1.5px; fill: transparent;
    }
    if !Tema.intunecat: Path {
        width: 16px; height: 16px; viewbox-width: 16; viewbox-height: 16;
        commands: "M 8 5 A 3 3 0 1 1 7.99 5 M 8 1 L 8 2.5 M 8 13.5 L 8 15 M 1 8 L 2.5 8 M 13.5 8 L 15 8 M 3 3 L 4 4 M 12 12 L 13 13 M 13 3 L 12 4 M 4 12 L 3 13";
        stroke: Tema.text-secundar; stroke-width: 1.5px; fill: transparent;
    }
    zona := TouchArea { clicked => { meniu.show(); } }
    // fereastra mica de alegere: deasupra a tot ce e pe ecran
    meniu := PopupWindow {
        x: root.width - 180px;
        y: root.height + 6px;
        width: 180px;
        Rectangle {
            border-radius: 10px;
            border-width: 1px;
            border-color: Tema.linie;
            background: Tema.suprafata;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Tema.intunecat ? #00000080 : #0f111526;
            VerticalLayout {
                padding: 6px;
                HorizontalLayout {
                    padding-left: 8px;
                    height: 26px;
                    Text { text: Texte.tema; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-tert; vertical-alignment: center; }
                }
                for o in [{ t: Texte.intunecat, intunecat: true }, { t: Texte.luminos, intunecat: false }]: Rectangle {
                    height: 32px;
                    border-radius: 7px;
                    background: z.has-hover ? Tema.strat : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text { text: o.t; font-family: Tema.font-ui; font-size: 13px; color: Tema.text; vertical-alignment: center; horizontal-stretch: 1; }
                        if o.intunecat == Tema.intunecat: VerticalLayout {
                            alignment: center;
                            Path {
                                width: 12px; height: 12px; viewbox-width: 16; viewbox-height: 16;
                                commands: "M 3 8.5 L 6 11.5 L 13 4.5"; stroke: Tema.accent-text; stroke-width: 2px; fill: transparent;
                            }
                        }
                    }
                    z := TouchArea { clicked => { root.alege(o.intunecat); } }
                }
            }
        }
    }
}

// Antetul ecranelor: semnul, locul (sau drumul sursa → baza) si,
// in dreapta, ce pune ecranul (copiii). Acelasi pe conectare, lista, deploy.
// Comutatorul de limba, langa cel de tema. Limbile vin din Rust
// (`texte::Limba::toate`), ca sa nu existe o a doua lista.
export component ButonLimba inherits Rectangle {
    in property <[string]> limbi;
    in property <int> aleasa;
    callback alege(int);
    width: 38px;
    height: 34px;
    border-radius: 8px;
    background: zona.has-hover ? Tema.strat : transparent;
    Text {
        text: root.aleasa >= 0 && root.limbi.length > 0 ? root.limbi[root.aleasa] : "";
        font-family: Tema.font-mono;
        font-size: 11.5px;
        font-weight: 500;
        color: Tema.text-secundar;
    }
    zona := TouchArea { clicked => { meniu.show(); } }
    meniu := PopupWindow {
        x: root.width - 170px;
        y: root.height + 6px;
        width: 170px;
        Rectangle {
            border-radius: 10px;
            border-width: 1px;
            border-color: Tema.linie;
            background: Tema.suprafata;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Tema.intunecat ? #00000080 : #0f111526;
            VerticalLayout {
                padding: 6px;
                for l[i] in root.limbi: Rectangle {
                    height: 32px;
                    border-radius: 7px;
                    background: z.has-hover ? Tema.strat : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text { text: l; font-family: Tema.font-ui; font-size: 13px; color: Tema.text; vertical-alignment: center; horizontal-stretch: 1; }
                        if i == root.aleasa: VerticalLayout {
                            alignment: center;
                            Path {
                                width: 12px; height: 12px; viewbox-width: 16; viewbox-height: 16;
                                commands: "M 3 8.5 L 6 11.5 L 13 4.5"; stroke: Tema.accent-text; stroke-width: 2px; fill: transparent;
                            }
                        }
                    }
                    z := TouchArea { clicked => { root.alege(i); } }
                }
            }
        }
    }
}

export component Antet inherits Rectangle {
    in property <string> loc;
    in property <string> sursa;
    in property <string> tinta;
    height: 60px;
    background: Tema.fundal;
    HorizontalLayout {
        padding-left: 24px;
        padding-right: 16px;
        spacing: 22px;
        VerticalLayout { alignment: center; Semn { } }
        if root.loc != "": Text { text: root.loc; font-family: Tema.font-ui; font-size: 13px; color: Tema.text-secundar; vertical-alignment: center; }
        if root.sursa != "": HorizontalLayout {
            spacing: 10px;
            alignment: start;
            horizontal-stretch: 0;
            Text { text: root.sursa; font-family: Tema.font-ui; font-size: 13px; font-weight: 500; color: Tema.text; vertical-alignment: center; }
            Text { text: "→"; font-family: Tema.font-mono; font-size: 13px; color: Tema.text-tert; vertical-alignment: center; }
            Text { text: root.tinta; font-family: Tema.font-ui; font-size: 13px; font-weight: 500; color: Tema.text; vertical-alignment: center; }
        }
        Rectangle { horizontal-stretch: 1; }
        @children
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Tema.linie; }
}

// Card: suprafata ridicata, colturi de 14 px.
export component Card inherits Rectangle {
    background: Tema.suprafata;
    border-radius: 14px;
    border-width: 1px;
    border-color: Tema.linie;
}

// --- randurile unui diff: aceleasi in editor si in previzualizarea din lista

export struct BucataUi {
    text: string,
    // 0 text, 1 cuvant cheie, 2 variabila, 3 numar, 4 sir, 5 comentariu
    sintaxa: int,
    schimbat: bool,
}

// O bucata colorata din campul de editare (etapa 25), cu pozitia ei in linie:
// cate caractere si cate taburi sunt inaintea ei.
export struct BucataEditareUi {
    text: string,
    sintaxa: int,
    caractere: int,
    taburi: int,
}

// O linie a campului de editare, colorata
export struct LinieUi {
    bucati: [BucataEditareUi],
}

// Bucatile colorate ale unei linii din campul de editare, fara fundal si fara
// italic, puse exact peste glifele campului. Pozitia se socoteste din
// caractere, nu din latimea bucatilor de dinainte: aceea e rotunjita la pixel
// si s-ar aduna pe rand. Un tab are mereu aceeasi latime (Slint n-are opriri
// de tab), dar alta decat un caracter, deci se numara separat.
export component BucatiEditare inherits Rectangle {
    in property <[BucataEditareUi]> bucati;
    in property <length> caracter;
    in property <length> tab;
    for b in bucati: Text {
        x: b.caractere * root.caracter + b.taburi * root.tab;
        y: 0px;
        text: b.text;
        font-family: Tema.font-mono;
        font-size: 12.5px;
        color: b.sintaxa == 1 ? Tema.s-cuvant
             : b.sintaxa == 2 ? Tema.s-variabila
             : b.sintaxa == 3 ? Tema.s-numar
             : b.sintaxa == 4 ? Tema.s-sir
             : b.sintaxa == 5 ? Tema.s-comentariu
             : Tema.text;
        vertical-alignment: top;
    }
}

export struct RandUi {
    // 0 linie, 1 pliere („22 de linii identice, 24-45")
    fel: int,
    pliere: string,
    st-nr: string,
    st: [BucataUi],
    dr-nr: string,
    dr: [BucataUi],
    // 0 egal, 1 modificat, 2 doar in sursa, 3 doar in baza
    stare: int,
    // a cata diferenta e randul, -1 pe context (bara e mai lata pe cea curenta)
    diferenta: int,
    // linia din baza: 0 cum era, 1 adusa din sursa, 2 scrisa de tine
    dr-marcaj: int,
    // primul rand al unei diferente (sageata din canal) sau al unui sir de
    // linii aduse (bifa)
    inceput: bool,
    // cate randuri afisate tine diferenta, pus doar pe randul de inceput:
    // de aici se deseneaza linia de legatura din canal
    linii-bloc: int,
    // in modul unificat: cealalta versiune a liniei, aratata la hover
    pereche: [BucataUi],
    pereche-nr: string,
    // wrap (etapa 19): randul continua linia de deasupra, fara numar; o
    // parte care nu avea linia deloc ramane hasurata si pe continuare
    continuare: bool,
    // pastila de pe primul rand al blocului: ce e si unde ajunge
    eticheta: string,
    // randul nu exista in niciun text: arata unde ar veni un bloc din martor
    fantoma: bool,
    // cate randuri afisate mai jos (sau mai sus, daca e negativ) e locul in
    // care ajunge blocul: din el se deseneaza legatura din canal. 0 = fara
    delta-tinta: int,
    // locul e un gol intre blocuri (se insereaza), nu un bloc de inlocuit
    tinta-gol: bool,
    st-lipsa: bool,
    dr-lipsa: bool,
    // ce se intampla daca lasi un bloc tras pe randul asta (`loc_ui`):
    // >= 0 inlocuieste blocul cu indexul asta, <= -2 se insereaza inaintea
    // liniei -(loc + 2), -1 nimic (eticheta, pliere)
    loc: int,
    // blocul motorului din care face parte randul (-1 = context): tragerea
    // ia doar blocul asta, chiar daca e intr-un grup
    bloc: int,
    // textul randului din Martor, pentru fantoma care urmeaza mouse-ul
    text-st: string,
    // partea din dreapta e locul unde s-ar insera blocurile din Martor:
    // curata, fara hasura (primul rand are si textul, `fantoma`)
    inserare: bool,
    // cutia blocului, ca in v3.4: randul e in cutie pe partea din stanga /
    // din dreapta; `cutie-jos` = ultimul rand (chenarul se inchide);
    // `nr-diferenta` (de la 1) se arata pe randul etichetei, „1 / 3"
    cutie-st: bool,
    cutie-dr: bool,
    cutie-jos: bool,
    nr-diferenta: int,
}

// o linie din previzualizarea la hover: cum ar arata Modificata dupa Aplica
export struct LiniePrevizualizareUi {
    nr: string,
    text: string,
    // linia vine din blocul aplicat (evidentiata); altfel e context
    adusa: bool,
}

export struct MarcajUi {
    // pozitia si inaltimea in obiect, 0..1
    pozitie: float,
    inaltime: float,
    stare: int,
}

// Hasura de 135° a partii fara linii: tigla se deseneaza in Rust din jetoane
// (`hasura-a` / `hasura-b`) si se repeta.
export component Hasura inherits Rectangle {
    in property <image> tigla;
    clip: true;
    background: Tema.hasura-a;
    Image {
        source: root.tigla;
        width: 100%;
        height: 100%;
        horizontal-tiling: repeat;
        vertical-tiling: repeat;
        image-rendering: pixelated;
    }
}

export component Bucati inherits HorizontalLayout {
    in property <[BucataUi]> bucati;
    in property <int> stare;
    spacing: 0px;
    alignment: start;
    for b in bucati: Rectangle {
        background: b.schimbat ? Tema.inlinie-stare(root.stare) : transparent;
        width: t.preferred-width;
        t := Text {
            text: b.text;
            font-family: Tema.font-mono;
            font-size: 12.5px;
            font-italic: b.sintaxa == 5;
            color: b.sintaxa == 1 ? Tema.s-cuvant
                 : b.sintaxa == 2 ? Tema.s-variabila
                 : b.sintaxa == 3 ? Tema.s-numar
                 : b.sintaxa == 4 ? Tema.s-sir
                 : b.sintaxa == 5 ? Tema.s-comentariu
                 : Tema.text;
            vertical-alignment: center;
        }
    }
}

// O jumatate de rand: bara din jgheab, numarul de linie real, textul colorat.
// Fara numar de linie = partea nu are linia: hasura, nu fundal gol.
export component Jumatate inherits Rectangle {
    in property <string> nr;
    // unificat: al doilea jgheab de numere (sursa | baza), ca sa se vada din
    // ce parte vine linia fara sa apara vreun semn nou
    in property <string> nr-baza;
    in property <bool> doua-numere: false;
    in property <[BucataUi]> bucati;
    in property <int> stare;
    in property <bool> curenta;
    in property <bool> margine;
    // partea nu are linia (blocul e mai scurt aici): hasura, nu fundal gol
    in property <bool> fara-linie;
    in property <image> tigla;
    // pastila de pe primul rand al blocului („bloc 4 · DOAR IN MARTOR →
    // fara corespondent: se insereaza")
    in property <string> eticheta;
    // se trage un bloc si aici ar cadea: se aprinde
    in property <bool> tinta-aprinsa;
    // primul rand al tintei: doar acolo scrie ce se intampla, altfel textul
    // s-ar repeta pe fiecare linie a blocului
    in property <bool> tinta-prima;
    in property <string> text-plasare;
    // se trage un bloc si mouse-ul e deasupra randului: daca il lasi aici,
    // ajunge aici (nu neaparat pe locul sugerat)
    in property <bool> tinta-mouse;
    // fondul liniilor identice: `cod-fundal` (baza) sau `panou-sursa` (sursa)
    in property <color> fond: Tema.cod-fundal;
    // linia din baza: 0 cum era, 1 adusa din sursa (verde, ca „doar in
    // sursa"), 2 scrisa de tine (violet, ca eticheta „editabil")
    in property <int> marcaj: 0;
    // cat s-a derulat pe orizontala: liniile mai lungi decat panoul erau
    // taiate fara nimic — fara elipsa, fara derulare (V10 din auditul QA)
    in property <length> decalaj-x: 0px;
    property <int> st: root.marcaj == 1 ? 2 : root.stare;
    clip: true;
    min-width: 0px;
    background: root.fara-linie ? transparent
              : root.marcaj == 2 ? Tema.tine.transparentize(0.86)
              : root.st == 0 ? root.fond
              : Tema.fundal-stare(root.st);
    if root.fara-linie && root.stare != 0: Hasura { tigla: root.tigla; width: 100%; height: 100%; }
    // locul in care ar cadea blocul tras: fundal subtire peste tot blocul,
    // text doar pe primul rand
    if root.tinta-aprinsa: Rectangle {
        background: Tema.add-bara.transparentize(0.88);
        Rectangle { x: 0px; width: 2px; background: Tema.add-bara; }
    }
    if root.tinta-mouse: Rectangle {
        background: Tema.accent.transparentize(0.82);
        border-width: 1px;
        border-color: Tema.accent;
        Rectangle { x: 0px; width: 3px; background: Tema.accent; }
    }
    if root.tinta-aprinsa && root.tinta-prima: Rectangle {
        x: parent.width - self.width - 10px;
        y: 2px;
        height: parent.height - 4px;
        width: plasare-text.preferred-width + 16px;
        border-radius: 4px;
        // opac: pe randul-fantoma, textul de dedesubt nu trebuie sa se vada
        // prin el (sesizat de Mihai: se suprapuneau scrisurile)
        background: Tema.fundal;
        border-width: 1px;
        border-color: Tema.add-bara;
        plasare-text := Text {
            text: root.text-plasare;
            font-family: Tema.font-ui;
            font-size: 11px;
            font-weight: 600;
            color: Tema.add-text;
            vertical-alignment: center;
        }
    }
    HorizontalLayout {
        // jgheabul si numarul raman pe loc; se muta doar codul (mai jos)
        spacing: 0px;
        alignment: start;
        // jgheabul: bara de 3 px a blocului diferit, 5 px pe diferenta curenta
        Rectangle {
            width: 3px;
            background: root.fara-linie || root.st == 0 ? transparent
                      : root.marcaj == 2 ? Tema.tine
                      : Tema.bara-stare(root.st);
            if root.curenta && !root.fara-linie: Rectangle {
                x: 0px;
                width: 5px;
                background: Tema.bara-stare(root.st);
            }
        }
        Text {
            width: 44px;
            text: root.nr;
            font-family: Tema.font-mono;
            font-size: 12.5px;
            color: root.marcaj == 2 ? Tema.tine : Tema.numar-stare(root.st);
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        if root.doua-numere: Text {
            width: 44px;
            text: root.nr-baza;
            font-family: Tema.font-mono;
            font-size: 12.5px;
            color: Tema.numar-stare(root.st);
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Rectangle { width: 10px; }
        Rectangle {
            // latimea ramasa dupa jgheab (3) + numar (44) + numarul al doilea
            // + spatiul (10): `alignment: start` nu intinde nimic singur
            clip: true;
            width: root.width - 57px - (root.doua-numere ? 44px : 0px);
            Bucati {
                x: -root.decalaj-x;
                width: self.preferred-width;
                height: parent.height;
                bucati: root.bucati;
                stare: root.st;
            }
        }
    }
    if root.margine: Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Tema.linie;
    }
    if root.eticheta != "": Rectangle {
        // pastila sta in capatul jumatatii, nu in rand: codul nu se muta
        x: parent.width - self.width - 10px;
        y: 2px;
        height: parent.height - 4px;
        width: pastila-text.preferred-width + 14px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Tema.bara-stare(root.st);
        background: Tema.fundal;
        pastila-text := Text {
            text: root.eticheta;
            font-family: Tema.font-ui;
            font-size: 10px;
            font-weight: 600;
            color: Tema.bara-stare(root.st);
            vertical-alignment: center;
        }
    }

}


// Chenarul cutiei unui bloc, ca in v3.4, desenat bucata cu bucata pe
// randurile listei: laturile pe fiecare rand, sus pe randul etichetei, jos pe
// ultimul rand al blocului. Peste cod, fara sa ia mouse-ul.
export component Chenar inherits Rectangle {
    in property <int> stare;
    in property <bool> sus;
    in property <bool> jos;
    property <color> c: Tema.bara-stare(root.stare);
    Rectangle { x: 0px; width: 1px; background: root.c; }
    Rectangle { x: parent.width - 1px; width: 1px; background: root.c; }
    if root.sus: Rectangle { y: 0px; height: 1px; background: root.c; }
    if root.jos: Rectangle { y: parent.height - 1px; height: 1px; background: root.c; }
}

// Eticheta unui bloc, pe randul ei de deasupra blocului: ce e si unde
// ajunge. In culoarea starii, cu marginea ei; textul nu se taie (randul e al
// ei, nu acopera cod).
export component PastilaBloc inherits Rectangle {
    in property <string> text;
    in property <int> stare;
    y: 3px;
    height: 18px;
    width: pt.preferred-width + 16px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Tema.bara-stare(root.stare);
    background: Tema.fundal;
    pt := Text {
        text: root.text;
        font-family: Tema.font-ui;
        font-size: 10.5px;
        font-weight: 600;
        color: Tema.bara-stare(root.stare);
        vertical-alignment: center;
    }
}

// Fereastra de ajutor (F1). Textul vine din Rust (`gmotion_fereastra::AJUTOR`),
// ca sa fie acelasi pe toate ecranele.
export component Ajutor inherits Rectangle {
    in property <string> text;
    callback inchide();
    // „Despre" (etapa 25) se deschide de aici: antetele raman ca in macheta
    callback despre();
    background: Tema.intunecat ? #00000099 : #0f111566;
    TouchArea { clicked => { root.inchide(); } }
    Rectangle {
        width: Math.min(root.width - 80px, 640px);
        height: Math.min(root.height - 80px, 560px);
        border-radius: 14px;
        border-width: 1px;
        border-color: Tema.linie;
        background: Tema.suprafata;
        VerticalLayout {
            padding: 18px;
            spacing: 10px;
            HorizontalLayout {
                Text { text: Texte.ajutor; font-family: Tema.font-ui; font-size: 16px; font-weight: 600; color: Tema.text; horizontal-stretch: 1; }
                Buton { text: Texte.despre; apasat => { root.despre(); } }
                Buton { text: Texte.inchide-esc; apasat => { root.inchide(); } }
            }
            Flickable {
                vertical-stretch: 1;
                content-height: continut.preferred-height;
                continut := Text {
                    width: parent.width;
                    text: root.text;
                    font-family: Tema.font-ui;
                    font-size: 13px;
                    color: Tema.text-secundar;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// „Despre": versiunea, componentele terte cu licentele lor si unde e jurnalul.
// `AboutSlint` e atribuirea ceruta de licenta Slint Royalty-free 2.0 (vezi
// `JURNAL.md`); textul vine din Rust (`text_despre`), in limba aleasa.
export component Despre inherits Rectangle {
    in property <string> text;
    callback inchide();
    background: Tema.intunecat ? #00000099 : #0f111566;
    TouchArea { clicked => { root.inchide(); } }
    Rectangle {
        width: Math.min(root.width - 80px, 640px);
        height: Math.min(root.height - 80px, 560px);
        border-radius: 14px;
        border-width: 1px;
        border-color: Tema.linie;
        background: Tema.suprafata;
        // clicul in cutie nu o inchide
        TouchArea { }
        VerticalLayout {
            padding: 18px;
            spacing: 10px;
            HorizontalLayout {
                Text { text: Texte.despre; font-family: Tema.font-ui; font-size: 16px; font-weight: 600; color: Tema.text; horizontal-stretch: 1; }
                Buton { text: Texte.inchide-esc; apasat => { root.inchide(); } }
            }
            Flickable {
                vertical-stretch: 1;
                content-height: continut.preferred-height;
                continut := VerticalLayout {
                    width: parent.width;
                    spacing: 12px;
                    Text {
                        text: root.text;
                        font-family: Tema.font-ui;
                        font-size: 13px;
                        color: Tema.text-secundar;
                        wrap: word-wrap;
                    }
                    // `AboutSlint` are culorile lui, gandite pe fond deschis: in
                    // modul intunecat versiunea de sub sigla nu se vedea
                    HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            background: #f4f5f7;
                            border-radius: 10px;
                            HorizontalLayout {
                                padding: 8px;
                                AboutSlint { }
                            }
                        }
                    }
                }
            }
        }
    }
}
