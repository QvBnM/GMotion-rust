// Vocabularul vizual comun al ferestrelor: jetoanele temei si piesele mici
// care apar pe mai multe ecrane (butoane, taburi, bife, chevroane).
//
// Se strica astfel: doua ecrane ajung sa arate altfel acelasi lucru. De-aia
// stau aici, o data, nu copiate in fiecare fereastra.
//
// Culorile NU se scriu aici: jetoanele vin din `src/jetoane.rs` prin
// `aplica_tema`, ca sa existe un singur loc de unde se verifica contrastul.

// Fonturile, incorporate in binar: Geist si Geist Mono (SIL OFL 1.1 — vezi
// `fonturi/LICENSE-OFL-1.1-Geist.txt`). Rezerva, daca lipsesc: Segoe UI / Consolas.
import { AboutSlint } from "std-widgets.slint";
import "../fonturi/Geist-300.ttf";
import "../fonturi/Geist-400.ttf";
import "../fonturi/Geist-500.ttf";
import "../fonturi/Geist-600.ttf";
import "../fonturi/GeistMono-400.ttf";
import "../fonturi/GeistMono-500.ttf";


