// Editorul de diferente, ca panza (`cercetare/schita-slint/ui/panza.slint`),
// pe jetoanele din `Tema`: titlul mare sus, sursa si baza ca doua panouri
// distincte, comenzile in insule care plutesc.
//
// Se strica astfel: panourile nu mai sunt aliniate, culoarea nu mai spune ce
// e diferit (sau e singurul semnal, fara bara si numar), sau derularea pe
// obiecte mari se blocheaza. Un singur ListView (virtualizat) cu ambele
// panouri pe acelasi rand tine derularea sincronizata fara cod.

import { ListView } from "std-widgets.slint";
import { RandListaUi, Stari } from "lista.slint";

// Un tab din bara editorului (etapa 16). `cod`: -1 previzualizarea, altfel
// al catelea fixat; asa il intoarce fereastra in Rust.
export struct TabUi {
    cod: int,
    nume: string,       // taiat pe mijloc
    complet: string,    // la hover: baza / schema.nume
    activ: bool,
    previzualizare: bool,
    editat: bool,
}
import { Texte, Tema, ButonLimba, Semn, ButonTema, Bucati, Jumatate, RandUi, MarcajUi } from "comune.slint";

// Insula care pluteste peste panza.
component Insula inherits Rectangle {
    background: Tema.suprafata;
    border-radius: 14px;
    border-width: 1px;
    border-color: Tema.linie;
    drop-shadow-blur: 26px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: Tema.intunecat ? #00000066 : #0f111529;
}

component Tasta inherits Rectangle {
    in property <string> t;
    in property <bool> pe-accent;
    height: 18px;
    width: tx.preferred-width + 10px;
    border-radius: 5px;
    background: root.pe-accent ? transparent : Tema.strat;
    border-width: root.pe-accent ? 1px : 0;
    border-color: Tema.pe-accent;
    tx := Text { text: root.t; font-family: Tema.font-mono; font-size: 11px; color: root.pe-accent ? Tema.pe-accent : Tema.text-secundar; }
}

// Buton din insula. fel: 0 simplu, 1 principal (chihlimbar), 2 pornit
component ButonInsula inherits Rectangle {
    in property <string> text;
    in property <string> tasta;
    in property <int> fel;
    // inactiv: se vede, dar nu se apasa (Reset fara text final, Anuleaza
    // fara istoric)
    in property <bool> activ: true;
    callback apasat();
    height: 36px;
    width: r.preferred-width + 22px;
    border-radius: 10px;
    background: root.fel == 1 ? Tema.accent : root.fel == 2 ? Tema.strat : (z.has-hover ? Tema.strat : transparent);
    opacity: !root.activ ? 0.4 : root.fel == 1 && z.has-hover ? 0.88 : 1;
    r := HorizontalLayout {
        alignment: center;
        spacing: 7px;
        Text { text: root.text; font-family: Tema.font-ui; font-size: 13px; font-weight: root.fel == 0 ? 400 : 600; color: root.fel == 1 ? Tema.pe-accent : Tema.text; vertical-alignment: center; }
        if root.tasta != "": VerticalLayout { alignment: center; Tasta { t: root.tasta; pe-accent: root.fel == 1; } }
    }
    z := TouchArea { enabled: root.activ; clicked => { root.apasat(); } }
}

// Un punct colorat cu eticheta lui: legenda culorilor, o data pentru ambele
// panouri.
component Punct inherits HorizontalLayout {
    in property <color> c;
    in property <string> t;
    horizontal-stretch: 0;
    spacing: 6px;
    VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.c; } }
    Text { text: root.t; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-secundar; vertical-alignment: center; }
}

// Butonul mic din capul unui panou („Copiaza").
component ButonCap inherits Rectangle {
    in property <string> text;
    callback apasat();
    height: 24px;
    width: bt.preferred-width + 16px;
    border-radius: 7px;
    background: zb.has-hover ? Tema.strat : Tema.suprafata;
    border-width: 1px;
    border-color: Tema.linie;
    bt := Text { text: root.text; font-family: Tema.font-ui; font-size: 12px; color: Tema.text; }
    zb := TouchArea { clicked => { root.apasat(); } }
}

component Despartitor inherits VerticalLayout {
    alignment: center;
    Rectangle { width: 1px; height: 22px; background: Tema.linie; }
}

// Capul unui panou: rolul, baza, serverul si liniile, eticheta.
component CapPanou inherits Rectangle {
    in property <string> rol;
    in property <string> baza;
    in property <string> detaliu;
    in property <string> eticheta;
    in property <color> fond;
    in property <color> linie;
    // „editabil" (violet, ca liniile scrise de tine): clic = editeaza
    in property <bool> editabil: false;
    callback copiaza();
    callback editeaza();
    background: root.fond;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    Rectangle { y: parent.height - 1px; height: 1px; background: root.linie; }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 10px;
        Text { text: root.rol; font-family: Tema.font-ui; font-size: 15px; font-weight: 600; color: Tema.text; vertical-alignment: center; }
        Text { text: root.baza; font-family: Tema.font-mono; font-size: 12px; color: Tema.text; vertical-alignment: center; overflow: elide; }
        Text { text: root.detaliu; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-secundar; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        if root.eticheta != "": VerticalLayout {
            alignment: center;
            Rectangle {
                height: 22px;
                width: et.preferred-width + 16px;
                border-radius: 11px;
                background: Tema.strat;
                et := Text { text: root.eticheta; font-family: Tema.font-ui; font-size: 11.5px; color: Tema.text-secundar; }
            }
        }
        if root.editabil: VerticalLayout {
            alignment: center;
            Rectangle {
                height: 22px;
                width: ee.preferred-width + 16px;
                border-radius: 11px;
                background: Tema.tine;
                ee := Text { text: Texte.editabil; font-family: Tema.font-ui; font-size: 11.5px; font-weight: 500; color: Tema.pe-tine; }
                TouchArea { clicked => { root.editeaza(); } }
            }
        }
        VerticalLayout { alignment: center; ButonCap { text: Texte.copiaza; apasat => { root.copiaza(); } } }
    }
}

export component EditorDiferente inherits Window {
    title: "gmotion — " + root.obiect-nume;
    preferred-width: 1440px;
    preferred-height: 900px;
    background: Tema.fundal;
    default-font-family: Tema.font-ui;
    default-font-size: 13px;

    // obiectul
    in property <string> obiect-schema;
    in property <string> obiect-nume;
    in property <string> tip-obiect;
    in property <string> rezumat;            // „4 diferente, una doar in comentariu"
    // partile comparate
    in property <string> sursa-baza;
    in property <string> sursa-detaliu;      // „srv-dev · 47 linii"
    in property <string> tinta-baza;
    in property <string> tinta-detaliu;
    // continutul
    in property <[RandUi]> randuri;
    in property <[MarcajUi]> marcaje;
    in property <[int]> start-diferente;     // randul de inceput al fiecarei diferente
    in property <int> total-diferente;
    in-out property <int> diferenta-curenta: 0;
    in property <image> tigla-hasura;
    // starea obiectului
    in property <bool> revizuit: false;
    in property <bool> in-plan: false;
    // cheia obiectului deschis, `baza/schema.nume`. Pleaca inapoi cu textul
    // scris de mana, ca Rust sa poata refuza un text venit pentru alt obiect
    // (F-A1 din auditul QA).
    in property <string> obiect-id;
    in-out property <bool> alaturat: true;
    in-out property <bool> pliaza-identicul: true;
    in property <string> stare-obiecte;      // „obiectul 4 din 212 nerevizuite"
    // editarea (vezi `incarca_editarea`)
    in property <bool> omis: false;
    in property <bool> editat: false;         // exista text final: Reset are ce face
    in property <bool> se-poate-anula: false;
    in property <string> text-sursa;
    in property <string> text-final;
    in property <string> salvat;              // „salvat la 14:52"
    in property <bool> ghidat: false;
    in property <bool> ghidat-din-sursa: true;
    in property <bool> ghidat-terminat: false;
    in property <string> ghidat-titlu;
    in-out property <bool> ascunde-diferentele: false;
    in-out property <bool> editeaza-mod: false;

    callback inapoi-lista();
    callback obiect-anterior();
    callback obiect-urmator();
    callback comuta-revizuit();
    callback adauga-in-plan();
    callback comuta-plierea(bool);
    callback comuta-alaturat(bool);
    callback editeaza-textul-final();
    callback alege-tema(bool);
    // comutatorul de limba: etichetele si indicele ales vin din Rust
    in property <[string]> limbi;
    in property <int> limba-aleasa;
    callback alege-limba(int);
    callback ecran-complet();
    callback comuta-omis();
    callback aplica-diferenta(int);
    // blocul tras acum cu mouse-ul (-1 = niciunul) si cat s-a tras spre dreapta
    in-out property <int> trage-diferenta: -1;
    in-out property <length> trage-x;
    callback aplica-toate();
    callback reset();
    callback anuleaza();
    callback salveaza-textul(string, string);   // (obiect-id, text)
    callback ghidat-porneste();
    callback ghidat-opreste();
    callback ghidat-alege(bool);
    callback ghidat-aplica();
    callback ghidat-sari();
    callback resincronizeaza();
    // ---- coloana din stanga: lista, stransa, ca sa nu pleci din ecran cand
    // deschizi un obiect (pachetul B). `latime-lista` 0 = ascunsa.
    in property <[RandListaUi]> randuri-lista;
    in property <int> selectat-lista;
    in property <string> rezumat-lista;
    in-out property <length> latime-lista: 300px;
    // ultima latime trasa cu mouse-ul; la ea revine coloana dupa Esc
    in-out property <length> latime-lista-aleasa: 300px;
    callback alege-randul(int);
    callback cauta(string);
    callback ascunde-lista();
    // ---- taburile (etapa 16): logica e in `model_taburi`, aici doar desenul
    in property <[TabUi]> taburi;
    callback activeaza-tab(int);
    callback inchide-tab(int);
    callback fixeaza-previzualizarea();
    callback inchide-tab-activ();
    // dublu clic pe un rand din coloana listei: obiectul se fixeaza in tab
    callback fixeaza-randul(int);
    property <bool> are-taburi: root.taburi.length > 0;
    // cate taburi incap pe rand; restul, in meniul „+N"
    property <int> taburi-incap: Math.max(1, Math.floor((root.width - root.latime-lista - 120px) / 176px));
    /// „Uneste ciclul cursor": `DECLARE ... CURSOR` pana la `DEALLOCATE`
    /// intr-un singur bloc. Taierea e in `core`, aici doar comutatorul.
    in property <bool> are-cursor;
    in property <bool> uneste-cursorul;
    callback comuta-unirea-cursorului(bool);
    callback diferenta-schimbata(int);

    property <length> inaltime-rand: 22px;
    property <length> jgheab: 28px;
    // latimea panzei tine cont de coloana din stanga: altfel panoul din
    // dreapta iese din ecran cand lista e deschisa
    property <length> latime-cod: Math.min(1280px, root.width - root.latime-lista - 96px);
    // latimea unui panou; 14 px raman pentru harta diferentelor
    property <length> panou: root.alaturat ? (root.latime-cod - root.jgheab - 14px) / 2 : root.latime-cod - 14px;
    // insulele de jos: cat ocupa fiecare si daca mai incap alaturi
    property <length> latime-insula-blocuri: sj.preferred-width + 12px;
    property <length> latime-insula-unelte: sx.preferred-width + 12px;
    property <length> spatiu-insule: root.width - root.latime-lista - 36px;
    // ---- derularea pe orizontala a codului (V10)
    // `latime-continut` vine din Rust: latimea celei mai lungi linii, in
    // pixeli, la fontul mono de 12,5 px. Fara ea nu se stie cat e de derulat.
    in property <length> latime-continut: 0px;
    in-out property <length> derulare-x: 0px;
    property <length> latime-text: root.panou - 57px;
    out property <length> derulare-maxima: max(0px, root.latime-continut - root.latime-text);
    public function deruleaza(cu: length) {
        root.derulare-x = Math.max(0px, Math.min(root.derulare-maxima, root.derulare-x + cu));
    }
    out property <bool> insule-sub-ea:
        root.latime-insula-blocuri + 12px + root.latime-insula-unelte > root.spatiu-insule;

    public function mergi-la(i: int) {
        if (root.total-diferente == 0) { return; }
        root.diferenta-curenta = Math.max(0, Math.min(root.total-diferente - 1, i));
        lista.content-y = -Math.max(0, root.start-diferente[root.diferenta-curenta] - 3) * root.inaltime-rand;
    }
    // la fel, dar spune si aplicatiei (care tine minte diferenta curenta)
    function navigheaza(i: int) {
        root.mergi-la(i);
        root.diferenta-schimbata(root.diferenta-curenta);
    }
    // focusul inapoi pe taste (dupa editarea de mana); public pentru teste
    public function focus-taste() {
        taste.focus();
    }
    function porneste-editarea() {
        root.editeaza-mod = true;
        root.editeaza-textul-final();
    }

    taste := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.F11) { root.ecran-complet(); return accept; }
            // cat se scrie textul de mana: Esc renunta la editare, nu pleaca
            // din ecran, iar restul scurtaturilor nu au ce cauta (F-A1)
            if (root.editeaza-mod) {
                if (e.text == Key.Escape) { root.editeaza-mod = false; taste.focus(); return accept; }
                return accept;
            }
            // modul ghidat: Enter aplica, Esc sare, sus / jos alta diferenta
            if (root.ghidat && root.ghidat-terminat) {
                if (e.text == Key.Return || e.text == Key.Escape) { root.ghidat-opreste(); return accept; }
            }
            if (root.ghidat && !root.ghidat-terminat) {
                if (e.text == Key.Return) { root.ghidat-aplica(); return accept; }
                if (e.text == Key.Escape) { root.ghidat-sari(); return accept; }
                if (e.text == Key.UpArrow) { root.navigheaza(root.diferenta-curenta - 1); return accept; }
                if (e.text == Key.DownArrow) { root.navigheaza(root.diferenta-curenta + 1); return accept; }
            }
            if (e.modifiers.control && (e.text == "z" || e.text == "Z")) { root.anuleaza(); return accept; }
            if (e.modifiers.control && (e.text == "w" || e.text == "W")) { root.inchide-tab-activ(); return accept; }
            if (e.text == "[") { root.ascunde-lista(); return accept; }
            if (e.text == "n" || (e.text == Key.F7 && !e.modifiers.shift)) { root.navigheaza(root.diferenta-curenta + 1); return accept; }
            if (e.text == "p" || (e.text == Key.F7 && e.modifiers.shift)) { root.navigheaza(root.diferenta-curenta - 1); return accept; }
            if (e.text == "j" || e.text == Key.PageDown) { root.obiect-urmator(); return accept; }
            if (e.text == "k" || e.text == Key.PageUp) { root.obiect-anterior(); return accept; }
            if (e.text == "r") { root.comuta-revizuit(); return accept; }
            if (e.text == "o") { root.comuta-omis(); return accept; }
            if (e.text == "i") { root.adauga-in-plan(); return accept; }
            if (e.text == "g") { if (root.ghidat) { root.ghidat-opreste(); } else { root.ghidat-porneste(); } return accept; }
            if (e.text == "e") { root.porneste-editarea(); return accept; }
            if (e.text == "u") { root.alaturat = !root.alaturat; root.comuta-alaturat(root.alaturat); return accept; }
            // liniile lungi: Shift + sageti deruleaza codul pe orizontala,
            // Shift+Home il aduce inapoi la inceput (V10)
            if (e.modifiers.shift && e.text == Key.RightArrow) { root.deruleaza(120px); return accept; }
            if (e.modifiers.shift && e.text == Key.LeftArrow) { root.deruleaza(-120px); return accept; }
            if (e.text == Key.Home) { root.derulare-x = 0px; return accept; }
            // Esc: intai largeste lista inapoi la tot ecranul, nu pleaca direct
            if (e.text == Key.Escape) { root.inapoi-lista(); return accept; }
            return reject;
        }

        // ---- panza: titlul sus, cele doua panouri dedesubt
        VerticalLayout {
            x: root.latime-lista;
            y: 0;
            width: root.width - root.latime-lista;
            height: root.height;
            padding-top: root.are-taburi ? 72px : 84px;
            // bara de taburi, deasupra titlului (etapa 16)
            if root.are-taburi: HorizontalLayout {
                height: 34px;
                // aliniata cu titlul si cu codul, nu cu marginea ferestrei
                padding-left: Math.max(18px, (root.width - root.latime-lista - root.latime-cod) / 2);
                padding-right: 18px;
                spacing: 4px;
                alignment: start;
                for t[i] in root.taburi: Rectangle {
                    visible: i < root.taburi-incap;
                    width: i < root.taburi-incap ? 172px : 0px;
                    height: 32px;
                    border-radius: 8px;
                    background: t.activ ? Tema.strat : zt.has-hover ? Tema.suprafata : transparent;
                    border-width: t.activ ? 1px : 0px;
                    border-color: Tema.linie;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 6px;
                        spacing: 6px;
                        if t.editat: VerticalLayout { alignment: center; Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Tema.accent; } }
                        Text {
                            horizontal-stretch: 1;
                            text: t.nume;
                            font-family: Tema.font-ui;
                            font-size: 12.5px;
                            font-italic: t.previzualizare;
                            color: t.activ ? Tema.text : Tema.text-secundar;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Rectangle {
                            width: 18px;
                            Text { text: "×"; font-size: 14px; color: zx-tab.has-hover ? Tema.text : Tema.text-tert; }
                            zx-tab := TouchArea { clicked => { root.inchide-tab(t.cod); } }
                        }
                    }
                    zt := TouchArea {
                        width: parent.width - 24px;
                        x: 0;
                        clicked => { root.activeaza-tab(t.cod); }
                        double-clicked => { if (t.previzualizare) { root.fixeaza-previzualizarea(); } }
                    }
                    if zt.has-hover: Rectangle {
                        y: parent.height + 4px;
                        x: 0;
                        width: bula-tab.preferred-width + 16px;
                        height: 24px;
                        border-radius: 6px;
                        background: Tema.suprafata;
                        border-width: 1px;
                        border-color: Tema.linie;
                        bula-tab := Text { text: t.complet; font-family: Tema.font-mono; font-size: 12px; color: Tema.text; }
                    }
                }
                // „+N": taburile care nu mai incap, intr-un meniu
                if root.taburi.length > root.taburi-incap: Rectangle {
                    width: plus.preferred-width + 18px;
                    height: 32px;
                    border-radius: 8px;
                    background: zp.has-hover ? Tema.strat : transparent;
                    border-width: 1px;
                    border-color: Tema.linie;
                    plus := Text { text: "+" + (root.taburi.length - root.taburi-incap) + " ▾"; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; }
                    zp := TouchArea { clicked => { meniu-taburi.show(); } }
                    meniu-taburi := PopupWindow {
                        y: parent.height + 4px;
                        x: parent.width - 240px;
                        width: 240px;
                        Rectangle {
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Tema.linie;
                            background: Tema.suprafata;
                            VerticalLayout {
                                padding: 6px;
                                for t[i] in root.taburi: Rectangle {
                                    visible: i >= root.taburi-incap;
                                    height: i >= root.taburi-incap ? 30px : 0px;
                                    border-radius: 7px;
                                    background: zm.has-hover ? Tema.strat : transparent;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        Text { text: t.nume; font-family: Tema.font-ui; font-size: 12.5px; font-italic: t.previzualizare; color: Tema.text; vertical-alignment: center; }
                                    }
                                    zm := TouchArea { clicked => { root.activeaza-tab(t.cod); } }
                                }
                            }
                        }
                    }
                }
            }
            // modul ghidat isi are locul lui sub cod, nu peste el
            // insulele de jos pot sta pe doua randuri: codul le lasa loc
            padding-bottom: (root.ghidat ? 86px + 150px : 86px)
                + (root.insule-sub-ea ? 58px : 0px);
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    width: root.latime-cod;
                    spacing: 2px;
                    HorizontalLayout {
                        Text { text: root.tip-obiect + ", " + root.rezumat; font-family: Tema.font-ui; font-size: 13px; color: Tema.text-secundar; horizontal-stretch: 1; }
                        Text { text: root.stare-obiecte; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-tert; }
                    }
                    // titlul: cel mult doua randuri; un nume lung se scrie mai
                    // mic si se rupe oriunde (numele SQL n-au spatii), ca sa
                    // se vada intreg, nu taiat cu „..." (15 C)
                    HorizontalLayout {
                        alignment: start;
                        property <length> marime: root.obiect-nume.character-count > 80 ? 20px : root.obiect-nume.character-count > 34 ? 26px : 40px;
                        Text { text: root.obiect-schema + "."; font-family: Tema.font-ui; font-size: parent.marime; font-weight: 300; color: Tema.text-tert; letter-spacing: -1px; vertical-alignment: top; }
                        Text {
                            text: root.obiect-nume;
                            font-family: Tema.font-ui;
                            font-size: parent.marime;
                            font-weight: 600;
                            color: Tema.text;
                            letter-spacing: -1px;
                            // fara `elide`: impreuna cu ruperea pe randuri, Slint taia
                            // dupa primul rand si lasa golul; marimea pe trepte tine
                            // numele in doua randuri
                            wrap: char-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                    // legenda culorilor, o data pentru ambele panouri
                    HorizontalLayout {
                        padding-bottom: 12px;
                        spacing: 14px;
                        Text { text: root.salvat; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-tert; horizontal-stretch: 1; vertical-alignment: center; }
                        Punct { c: Tema.mod-bara; t: Texte.modificat; }
                        Punct { c: Tema.add-bara; t: Texte.adus-din-martor; }
                        Punct { c: Tema.del-bara; t: Texte.doar-in-modificata; }
                        Punct { c: Tema.tine; t: Texte.scris-de-tine; }
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                vertical-stretch: 1;
                Rectangle {
                    width: root.latime-cod;
                    // fondurile panourilor
                    Rectangle {
                        x: 0;
                        width: root.panou;
                        border-radius: 14px;
                        background: root.alaturat ? Tema.panou-sursa : Tema.cod-fundal;
                        border-width: 1px;
                        border-color: Tema.linie;
                    }
                    if root.alaturat: Rectangle {
                        x: root.panou + root.jgheab;
                        width: root.panou;
                        border-radius: 14px;
                        background: Tema.cod-fundal;
                        border-width: 1.5px;
                        border-color: Tema.contur-baza;
                    }
                    VerticalLayout {
                        width: parent.width - 14px;
                        HorizontalLayout {
                            height: 46px;
                            spacing: root.jgheab;
                            if root.alaturat: CapPanou {
                                width: root.panou;
                                rol: Texte.martor;
                                baza: root.sursa-baza;
                                detaliu: root.sursa-detaliu;
                                eticheta: Texte.doar-citire;
                                fond: Tema.cap-sursa;
                                linie: Tema.linie;
                                copiaza => { clip-sursa.select-all(); clip-sursa.copy(); }
                            }
                            CapPanou {
                                width: root.panou;
                                rol: root.alaturat ? Texte.modificata : Texte.unificat;
                                baza: root.alaturat ? root.tinta-baza : root.sursa-baza + " → " + root.tinta-baza;
                                detaliu: root.tinta-detaliu;
                                fond: Tema.cap-baza;
                                linie: Tema.contur-baza;
                                editabil: true;
                                copiaza => { clip-final.select-all(); clip-final.copy(); }
                                editeaza => { root.porneste-editarea(); }
                            }
                        }
                        lista := ListView {
                            vertical-stretch: 1;
                            for r in root.randuri: Rectangle {
                                height: root.inaltime-rand;
                                // o pliere: cat s-a ascuns; un clic arata tot
                                if r.fel == 1: Rectangle {
                                    HorizontalLayout {
                                        padding-left: 56px;
                                        alignment: start;
                                        Text {
                                            text: r.pliere;
                                            font-family: Tema.font-ui;
                                            font-size: 11.5px;
                                            color: pliere-zona.has-hover ? Tema.text : Tema.text-secundar;
                                            vertical-alignment: center;
                                        }
                                    }
                                    pliere-zona := TouchArea {
                                        clicked => {
                                            root.pliaza-identicul = false;
                                            root.comuta-plierea(false);
                                        }
                                    }
                                }
                                if r.fel == 0 && root.alaturat: HorizontalLayout {
                                    spacing: 0px;
                                    Rectangle {
                                        width: (parent.width - root.jgheab) / 2;
                                        Jumatate {
                                            width: parent.width;
                                            nr: r.st-nr;
                                            bucati: r.st;
                                            stare: root.ascunde-diferentele ? 0 : r.stare;
                                            curenta: r.diferenta == root.diferenta-curenta;
                                            fara-linie: r.st-nr == "";
                                            fond: Tema.panou-sursa;
                                            decalaj-x: root.derulare-x;
                                            tigla: root.tigla-hasura;
                                        }
                                        // blocul din sursa se poate **trage**
                                        // peste panoul din dreapta; e acelasi
                                        // lucru ca sageata din canal, doar ca
                                        // se face cu mana
                                        if r.diferenta >= 0 && r.stare != 0 && !root.ascunde-diferentele: TouchArea {
                                            mouse-cursor: grab;
                                            moved => {
                                                // se considera tragere abia dupa cativa
                                                // pixeli: altfel un clic obisnuit aprinde
                                                // zona de plasare si pare un bug
                                                if (self.pressed && Math.abs(self.mouse-x - self.pressed-x) > 6px) {
                                                    root.trage-diferenta = r.diferenta;
                                                    root.trage-x = self.mouse-x - self.pressed-x;
                                                }
                                            }
                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.up) {
                                                    // tras destul spre dreapta = pus in baza
                                                    if (root.trage-diferenta >= 0 && root.trage-diferenta == r.diferenta && root.trage-x > root.jgheab) {
                                                        root.aplica-diferenta(r.diferenta);
                                                    }
                                                    root.trage-diferenta = -1;
                                                    root.trage-x = 0px;
                                                }
                                            }
                                        }
                                    }
                                    // canalul dintre panouri: sageata de aplicare a blocului,
                                    // sau bifa unde s-a adus din sursa
                                    Rectangle {
                                        width: root.jgheab;
                                        // linia de legatura: tine cat tine
                                        // blocul, ca sa se vada ce bucata din
                                        // stanga merge peste ce bucata din
                                        // dreapta
                                        if r.inceput && r.stare != 0 && r.linii-bloc > 1 && !root.ascunde-diferentele: Rectangle {
                                            y: root.inaltime-rand / 2;
                                            width: 1px;
                                            height: (r.linii-bloc - 1) * root.inaltime-rand;
                                            background: r.diferenta == root.diferenta-curenta ? Tema.mod-text : Tema.mod-bara;
                                            opacity: r.diferenta == root.diferenta-curenta ? 1 : 0.5;
                                        }
                                        if r.inceput && r.stare != 0 && !root.ascunde-diferentele: Rectangle {
                                            width: 24px;
                                            height: 18px;
                                            border-radius: 9px;
                                            background: r.diferenta == root.diferenta-curenta ? Tema.text : (za.has-hover ? Tema.strat : Tema.cod-fundal);
                                            border-width: r.diferenta == root.diferenta-curenta ? 0px : 1.5px;
                                            border-color: Tema.mod-bara;
                                            Text {
                                                text: "→";
                                                font-family: Tema.font-mono;
                                                font-size: 12px;
                                                color: r.diferenta == root.diferenta-curenta ? Tema.fundal : Tema.mod-text;
                                            }
                                            za := TouchArea { clicked => { root.aplica-diferenta(r.diferenta); } }
                                        }
                                        if r.inceput && r.stare == 0 && r.dr-marcaj == 1 && !root.ascunde-diferentele: Rectangle {
                                            width: 24px;
                                            height: 18px;
                                            border-radius: 9px;
                                            background: Tema.add-fundal;
                                            Text { text: "✓"; font-family: Tema.font-ui; font-size: 11px; color: Tema.add-text; }
                                        }
                                    }
                                    Rectangle {
                                        width: (parent.width - root.jgheab) / 2;
                                        Jumatate {
                                            width: parent.width;
                                            nr: r.dr-nr;
                                            bucati: r.dr;
                                            stare: root.ascunde-diferentele ? 0 : r.stare;
                                            marcaj: root.ascunde-diferentele ? 0 : r.dr-marcaj;
                                            curenta: r.diferenta == root.diferenta-curenta;
                                            fara-linie: r.dr-nr == "";
                                            decalaj-x: root.derulare-x;
                                            tigla: root.tigla-hasura;
                                        }
                                        // unde ajunge blocul tras
                                        // `>= 0` conteaza: randurile de context au
                                        // `diferenta == -1`, adica exact valoarea
                                        // „nu se trage nimic" — fara asta, zona de
                                        // plasare se aprindea pe tot panoul
                                        if root.trage-diferenta >= 0 && root.trage-diferenta == r.diferenta: Rectangle {
                                            border-radius: 4px;
                                            border-width: 1.5px;
                                            border-color: Tema.accent;
                                            background: Tema.mod-fundal;
                                            opacity: 0.85;
                                            if r.inceput: Text {
                                                text: root.trage-x > root.jgheab ? Texte.plaseaza-aici : Texte.trage-peste;
                                                font-family: Tema.font-ui;
                                                font-size: 11.5px;
                                                font-weight: 500;
                                                color: Tema.mod-text;
                                            }
                                        }
                                    }
                                }
                                // unificat: o singura coloana, cu ambele jgheaburi
                                if r.fel == 0 && !root.alaturat: Rectangle {
                                    Jumatate {
                                        width: parent.width;
                                        nr: r.st-nr;
                                        nr-baza: r.dr-nr;
                                        doua-numere: true;
                                        bucati: r.st-nr != "" ? r.st : r.dr;
                                        stare: root.ascunde-diferentele ? 0 : r.stare;
                                        marcaj: root.ascunde-diferentele || r.st-nr != "" ? 0 : r.dr-marcaj;
                                        curenta: r.diferenta == root.diferenta-curenta;
                                        fara-linie: false;
                                        decalaj-x: root.derulare-x;
                                        tigla: root.tigla-hasura;
                                    }
                                    // previzualizare la hover: cealalta
                                    // versiune a liniei, fara sa comuti pe
                                    // alaturat
                                    if r.pereche-nr != "" && !root.ascunde-diferentele: TouchArea {
                                        peste := Rectangle {
                                            x: 56px;
                                            y: root.inaltime-rand - 2px;
                                            width: Math.min(parent.width - 72px, pereche-text.preferred-width + 20px);
                                            height: root.inaltime-rand + 6px;
                                            border-radius: 6px;
                                            border-width: 1px;
                                            border-color: Tema.linie;
                                            background: Tema.suprafata;
                                            drop-shadow-blur: 14px;
                                            drop-shadow-offset-y: 4px;
                                            drop-shadow-color: Tema.intunecat ? #00000080 : #0f111526;
                                            visible: parent.has-hover;
                                            pereche-text := HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 8px;
                                                Text {
                                                    text: r.pereche-nr;
                                                    font-family: Tema.font-mono;
                                                    font-size: 11.5px;
                                                    color: Tema.text-tert;
                                                    vertical-alignment: center;
                                                }
                                                Bucati { bucati: r.pereche; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        // bara de derulare pe orizontala: liniile mai lungi
                        // decat panoul se pot citi tragand-o, sau cu
                        // Shift + sageti (V10 din auditul QA)
                        if root.derulare-maxima > 0px: bara-oriz := Rectangle {
                            height: 12px;
                            property <length> de_la;
                            property <length> util: parent.width - 8px;
                            property <length> cursor: Math.max(40px, bara-oriz.util * root.latime-text / root.latime-continut);
                            Rectangle {
                                x: 4px + (bara-oriz.util - bara-oriz.cursor) * (root.derulare-x / root.derulare-maxima);
                                y: 4px;
                                width: bara-oriz.cursor;
                                height: 5px;
                                border-radius: 2.5px;
                                background: trage-oriz.pressed || trage-oriz.has-hover ? Tema.text-secundar : Tema.text-tert;
                            }
                            trage-oriz := TouchArea {
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down) { bara-oriz.de_la = root.derulare-x; }
                                }
                                moved => {
                                    root.derulare-x = Math.max(0px, Math.min(root.derulare-maxima,
                                        bara-oriz.de_la + (self.mouse-x - self.pressed-x)
                                            * root.derulare-maxima / Math.max(1px, bara-oriz.util - bara-oriz.cursor)));
                                }
                            }
                        }
                    }
                    // „Editeaza": panoul Baza devine un text de scris de mana
                    if root.editeaza-mod: Rectangle {
                        x: root.alaturat ? root.panou + root.jgheab : 0px;
                        y: 46px;
                        width: root.panou;
                        height: parent.height - 46px;
                        background: Tema.cod-fundal;
                        border-radius: 14px;
                        border-width: 1.5px;
                        border-color: Tema.tine;
                        VerticalLayout {
                            padding: 1.5px;
                            ed-flick := Flickable {
                                vertical-stretch: 1;
                                content-width: Math.max(self.width, ed.preferred-width + 32px);
                                content-height: Math.max(self.height, ed.preferred-height + 24px);
                                ed := TextInput {
                                    x: 16px;
                                    y: 12px;
                                    text: root.text-final;
                                    single-line: false;
                                    wrap: no-wrap;
                                    font-family: Tema.font-mono;
                                    font-size: 12.5px;
                                    color: Tema.text;
                                    selection-background-color: Tema.tine.transparentize(0.6);
                                    selection-foreground-color: Tema.text;
                                    init => { self.focus(); }
                                }
                            }
                            Rectangle {
                                height: 48px;
                                background: Tema.cap-baza;
                                border-bottom-left-radius: 13px;
                                border-bottom-right-radius: 13px;
                                HorizontalLayout {
                                    padding: 6px;
                                    padding-left: 14px;
                                    spacing: 6px;
                                    Text { text: Texte.scrii-textul; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-secundar; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                    ButonInsula { text: Texte.renunta; apasat => { root.editeaza-mod = false; taste.focus(); } }
                                    ButonInsula { text: Texte.salveaza; fel: 1; apasat => { root.salveaza-textul(root.obiect-id, ed.text); root.editeaza-mod = false; taste.focus(); } }
                                }
                            }
                        }
                    }
                    // harta diferentelor, la marginea din dreapta
                    Rectangle {
                        x: parent.width - 10px;
                        y: 46px;
                        width: 10px;
                        height: parent.height - 46px;
                        border-radius: 5px;
                        background: Tema.strat;
                        Rectangle {
                            y: root.randuri.length == 0 ? 0px : (-lista.content-y / Math.max(1px, lista.content-height)) * parent.height;
                            height: root.randuri.length == 0 ? parent.height : Math.max(6px, (lista.visible-height / Math.max(1px, lista.content-height)) * parent.height);
                            border-radius: 5px;
                            background: Tema.linie;
                        }
                        for m in root.marcaje: Rectangle {
                            x: 2px;
                            width: parent.width - 4px;
                            y: m.pozitie * parent.height;
                            height: Math.max(3px, m.inaltime * parent.height);
                            border-radius: 1.5px;
                            background: Tema.bara-stare(m.stare);
                        }
                    }
                }
            }
        }

        // ---- coloana din stanga: lista stransa, ca sa nu pleci din ecran
        // cand deschizi un obiect. Un clic pe un rand schimba obiectul pe loc.
        if root.latime-lista > 0px: Rectangle {
            x: 0;
            y: 0;
            width: root.latime-lista;
            height: root.height;
            background: Tema.suprafata;
            Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Tema.linie; }
            VerticalLayout {
                padding-top: 10px;
                padding-bottom: 10px;
                HorizontalLayout {
                    height: 30px;
                    padding-left: 12px;
                    padding-right: 10px;
                    spacing: 8px;
                    Text {
                        text: root.rezumat-lista;
                        font-family: Tema.font-ui;
                        font-size: 12px;
                        font-weight: 600;
                        color: Tema.text-secundar;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    // sageata inapoi la lista intreaga
                    Rectangle {
                        width: ee.preferred-width + 16px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Tema.linie;
                        background: ze.has-hover ? Tema.strat : transparent;
                        ee := Text { text: "↔ Esc"; font-family: Tema.font-ui; font-size: 11.5px; color: Tema.accent-text; }
                        ze := TouchArea { clicked => { root.inapoi-lista(); } }
                    }
                }
                Rectangle { height: 1px; background: Tema.linie-slaba; }
                lista-ingusta := ListView {
                    vertical-stretch: 1;
                    for r[i] in root.randuri-lista: Rectangle {
                        height: 38px;
                        border-radius: 7px;
                        background: i == root.selectat-lista ? Tema.strat : (zr.has-hover ? Tema.fundal : transparent);
                        if i == root.selectat-lista: Rectangle { x: 0; width: 3px; height: 24px; border-radius: 1.5px; background: Tema.accent; }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 2px;
                                    background: Stari.bara(r.stare);
                                    opacity: r.revizuit ? 0.4 : 1;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;
                                horizontal-stretch: 1;
                                Text {
                                    text: r.nume;
                                    font-family: Tema.font-mono;
                                    font-size: 12px;
                                    color: i == root.selectat-lista ? Tema.text : Tema.text-secundar;
                                    overflow: elide;
                                }
                                Text {
                                    text: r.baza + (r.plus == "" ? "" : " · " + r.plus + " " + r.minus);
                                    font-family: Tema.font-ui;
                                    font-size: 10.5px;
                                    color: Tema.text-tert;
                                    overflow: elide;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text { text: r.scor-text; font-family: Tema.font-mono; font-size: 11px; color: Tema.text-secundar; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 13px;
                                    height: 13px;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: r.revizuit ? Tema.accent : Tema.text-tert;
                                    background: r.revizuit ? Tema.accent : transparent;
                                    if r.revizuit: Path {
                                        width: 9px; height: 9px; viewbox-width: 16; viewbox-height: 16;
                                        commands: "M 3 8.5 L 6 11.5 L 13 4.5";
                                        stroke: Tema.pe-accent; stroke-width: 2px; fill: transparent;
                                    }
                                }
                            }
                        }
                        zr := TouchArea {
                            clicked => { root.alege-randul(i); }
                            double-clicked => { root.fixeaza-randul(i); }
                        }
                    }
                }
                Rectangle { height: 1px; background: Tema.linie-slaba; }
                HorizontalLayout {
                    height: 26px;
                    padding-left: 12px;
                    spacing: 10px;
                    Text { text: "j k " + Texte.obiect-mic; font-family: Tema.font-ui; font-size: 11px; color: Tema.text-tert; vertical-alignment: center; }
                }
            }
        }

        // marginea dintre coloana listei si editor: se trage cu mouse-ul
        // (15 B). Latimea aleasa se tine minte, ca Esc sa o readuca.
        if root.latime-lista > 0px: Rectangle {
            x: root.latime-lista - 5px;
            y: 0;
            width: 10px;
            height: root.height;
            maner-lista := TouchArea {
                mouse-cursor: ew-resize;
                moved => {
                    if (self.pressed) {
                        root.latime-lista = Math.max(200px, Math.min(root.width - 640px, root.latime-lista + (self.mouse-x - self.pressed-x)));
                        root.latime-lista-aleasa = root.latime-lista;
                    }
                }
            }
            Rectangle {
                x: (parent.width - 3px) / 2;
                width: 3px;
                height: 48px;
                y: (parent.height - 48px) / 2;
                border-radius: 1.5px;
                background: maner-lista.pressed || maner-lista.has-hover ? Tema.accent : transparent;
            }
        }

        // ---- sus stanga: semnul, inapoi la lista, obiectul anterior / urmator
        Insula {
            x: root.latime-lista + 18px;
            y: 16px;
            height: 50px;
            width: ss.preferred-width + 12px;
            ss := HorizontalLayout {
                padding: 6px;
                padding-left: 14px;
                spacing: 4px;
                VerticalLayout { alignment: center; Semn { marime: 16px; } }
                Rectangle { width: 8px; }
                Despartitor { }
                ButonInsula { text: Texte.lista-scurt; tasta: "Esc"; apasat => { root.inapoi-lista(); } }
                Despartitor { }
                ButonInsula { text: "‹"; tasta: "k"; apasat => { root.obiect-anterior(); } }
                ButonInsula { text: "›"; tasta: "j"; apasat => { root.obiect-urmator(); } }
            }
        }

        // ---- sus dreapta: revizuit, in plan, tema
        Insula {
            x: root.width - self.width - 18px;
            y: 16px;
            height: 50px;
            width: sd.preferred-width + 12px;
            sd := HorizontalLayout {
                padding: 6px;
                spacing: 4px;
                ButonInsula { text: root.revizuit ? Texte.revizuit-bifat : Texte.revizuit; tasta: "r"; fel: root.revizuit ? 2 : 0; apasat => { root.comuta-revizuit(); } }
                ButonInsula { text: root.omis ? Texte.omis-bifat : Texte.omite; tasta: "o"; fel: root.omis ? 2 : 0; apasat => { root.comuta-omis(); } }
                ButonInsula { text: root.in-plan ? Texte.in-plan-bifat : Texte.in-plan; tasta: "i"; fel: root.in-plan ? 2 : 1; apasat => { root.adauga-in-plan(); } }
                Despartitor { }
                VerticalLayout { alignment: center; ButonTema { alege(i) => { root.alege-tema(i); } }
                }
                VerticalLayout {
                    alignment: center;
                    ButonLimba { limbi: root.limbi; aleasa: root.limba-aleasa; alege(i) => { root.alege-limba(i); } } }
            }
        }

        // ---- jos: lucrul pe blocuri, ca bara din v3.4, si a doua insula.
        // Cand nu incap alaturi, a doua trece pe randul de deasupra: asezate
        // pe un singur rand si centrate, la 1024 px jumatate din butoane
        // ieseau din ecran si nu se mai puteau apasa (V3 din auditul QA).
        Insula {
            x: root.insule-sub-ea
                ? root.latime-lista + (root.spatiu-insule - root.latime-insula-blocuri) / 2
                : root.latime-lista
                    + (root.spatiu-insule - root.latime-insula-blocuri - 12px
                        - root.latime-insula-unelte) / 2;
            y: root.height - 50px - 22px - (root.insule-sub-ea ? 58px : 0px);
            height: 50px;
            width: root.latime-insula-blocuri;
                sj := HorizontalLayout {
                    padding: 6px;
                    spacing: 2px;
                    ButonInsula { text: Texte.aplica-toate; fel: 1; activ: root.total-diferente > 0; apasat => { root.aplica-toate(); } }
                    ButonInsula { text: Texte.reset; activ: root.editat; apasat => { root.reset(); } }
                    Despartitor { }
                    ButonInsula { text: "↑"; tasta: "p"; apasat => { root.navigheaza(root.diferenta-curenta - 1); } }
                    Text {
                        text: root.total-diferente == 0 ? "0 / 0" : (root.diferenta-curenta + 1) + " / " + root.total-diferente;
                        font-family: Tema.font-mono;
                        font-size: 12.5px;
                        color: Tema.text-secundar;
                        vertical-alignment: center;
                    }
                    ButonInsula { text: "↓"; tasta: "n"; apasat => { root.navigheaza(root.diferenta-curenta + 1); } }
                    Despartitor { }
                    ButonInsula {
                        text: root.ghidat ? Texte.mod-ghidat-pornit : Texte.mod-ghidat;
                        tasta: "g";
                        fel: root.ghidat ? 2 : 0;
                        activ: root.ghidat || root.total-diferente > 0;
                        apasat => { if (root.ghidat) { root.ghidat-opreste(); } else { root.ghidat-porneste(); } }
                    }
                    Despartitor { }
                    // Alaturat / Unificat: un comutator in doua, cu partea aleasa
                    // pe fundal de accent, ca sa se vada dintr-o privire (15 C)
                    Rectangle {
                        height: 36px;
                        width: comutator.preferred-width + 8px;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Tema.linie;
                        background: Tema.fundal;
                        comutator := HorizontalLayout {
                            padding: 3px;
                            spacing: 2px;
                            ButonInsula {
                                height: 28px;
                                text: Texte.alaturat;
                                fel: root.alaturat ? 1 : 0;
                                apasat => { root.alaturat = true; root.comuta-alaturat(true); }
                            }
                            ButonInsula {
                                height: 28px;
                                text: Texte.unificat;
                                tasta: "u";
                                fel: root.alaturat ? 0 : 1;
                                apasat => { root.alaturat = false; root.comuta-alaturat(false); }
                            }
                        }
                    }
                    Despartitor { }
                    ButonInsula {
                        text: root.pliaza-identicul ? Texte.pliaza-identicul-bifat : Texte.pliaza-identicul;
                        fel: root.pliaza-identicul ? 2 : 0;
                        apasat => {
                            root.pliaza-identicul = !root.pliaza-identicul;
                            root.comuta-plierea(root.pliaza-identicul);
                        }
                    }
                }
        }
        Insula {
            x: root.insule-sub-ea
                ? root.latime-lista + (root.spatiu-insule - root.latime-insula-unelte) / 2
                : root.latime-lista
                    + (root.spatiu-insule - root.latime-insula-blocuri - 12px
                        - root.latime-insula-unelte) / 2
                    + root.latime-insula-blocuri + 12px;
            y: root.height - 50px - 22px;
            height: 50px;
            width: root.latime-insula-unelte;
            sx := HorizontalLayout {
                    padding: 6px;
                    spacing: 2px;
                    ButonInsula { text: Texte.editeaza; tasta: "e"; fel: root.editeaza-mod ? 2 : 0; apasat => { root.porneste-editarea(); } }
                    ButonInsula {
                        text: root.ascunde-diferentele ? Texte.arata-diferentele : Texte.ascunde-diferentele;
                        fel: root.ascunde-diferentele ? 2 : 0;
                        apasat => { root.ascunde-diferentele = !root.ascunde-diferentele; }
                    }
                    ButonInsula { text: Texte.resincronizeaza; apasat => { root.resincronizeaza(); } }
                    // butonul apare doar pe obiectele care chiar au cursor
                    if root.are-cursor: ButonInsula {
                        text: root.uneste-cursorul ? Texte.desparte-cursor : Texte.uneste-cursor;
                        fel: root.uneste-cursorul ? 2 : 0;
                        apasat => { root.comuta-unirea-cursorului(!root.uneste-cursorul); }
                    }
                ButonInsula { text: Texte.anuleaza-ctrlz; tasta: "Ctrl Z"; activ: root.se-poate-anula; apasat => { root.anuleaza(); } }
            }
        }

        // ---- modul ghidat: ce pui in baza pentru blocul curent
        if root.ghidat: Rectangle {
            x: (root.width - self.width) / 2;
            y: root.height - 72px - 14px - self.height;
            width: Math.min(760px, root.width - 80px);
            height: gc.preferred-height;
            background: Tema.text;
            border-radius: 16px;
            drop-shadow-blur: 40px;
            drop-shadow-offset-y: 14px;
            drop-shadow-color: Tema.intunecat ? #00000080 : #0f111559;
            gc := VerticalLayout {
                padding: 18px;
                spacing: 12px;
                HorizontalLayout {
                    Text { text: root.ghidat-titlu; font-family: Tema.font-ui; font-size: 13px; font-weight: 600; color: Tema.fundal; horizontal-stretch: 1; }
                    if !root.ghidat-terminat: Text { text: Texte.sus-jos; font-family: Tema.font-ui; font-size: 12px; color: Tema.fundal.transparentize(0.25); }
                }
                if !root.ghidat-terminat: Text { text: Texte.ce-pui-in-baza; font-family: Tema.font-ui; font-size: 15px; color: Tema.fundal; }
                if root.ghidat-terminat: Text { text: Texte.gata-diferentele; font-family: Tema.font-ui; font-size: 15px; color: Tema.fundal; }
                HorizontalLayout {
                    spacing: 6px;
                    for o[i] in (root.ghidat-terminat ? [] : [Texte.din-martor, Texte.din-modificata, Texte.editeaza]): Rectangle {
                        height: 34px;
                        width: ot.preferred-width + 24px;
                        border-radius: 9px;
                        background: (i == 0 && root.ghidat-din-sursa) || (i == 1 && !root.ghidat-din-sursa) ? Tema.fundal.transparentize(0.85) : transparent;
                        border-width: 1px;
                        border-color: Tema.fundal.transparentize(0.8);
                        ot := Text { text: o; font-family: Tema.font-ui; font-size: 13px; color: Tema.fundal; }
                        TouchArea {
                            clicked => {
                                if (i == 2) { root.porneste-editarea(); } else { root.ghidat-alege(i == 0); }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if !root.ghidat-terminat: Rectangle {
                        height: 34px;
                        width: gs.preferred-width + 24px;
                        border-radius: 9px;
                        gs := Text { text: Texte.sari-peste-esc; font-family: Tema.font-ui; font-size: 13px; color: Tema.fundal.transparentize(0.25); }
                        TouchArea { clicked => { root.ghidat-sari(); } }
                    }
                    Rectangle {
                        height: 34px;
                        width: ga.preferred-width + 28px;
                        border-radius: 9px;
                        background: Tema.accent;
                        ga := Text { text: root.ghidat-terminat ? Texte.inchide-enter : Texte.aplica-enter; font-family: Tema.font-ui; font-size: 13px; font-weight: 600; color: Tema.pe-accent; }
                        TouchArea { clicked => { if (root.ghidat-terminat) { root.ghidat-opreste(); } else { root.ghidat-aplica(); } } }
                    }
                }
            }
        }

        // „Copiaza": textul trece prin clipboard-ul sistemului, fara dependinta
        // noua (TextInput stie select-all / copy)
        clip-sursa := TextInput { x: 0; y: 0; width: 0px; height: 0px; opacity: 0; read-only: true; text: root.text-sursa; }
        clip-final := TextInput { x: 0; y: 0; width: 0px; height: 0px; opacity: 0; read-only: true; text: root.text-final; }
    }

    init => { taste.focus(); }
}
