// Editorul de diferente, pe designul aprobat (`cercetare/design-aprobat.md`,
// macheta `cercetare/machete/Editor.dc.html`): unealta densa, linii de 1 px,
// colturi de 3 px, fara umbre si fara insigne rotunjite.
//
// Se strica astfel: panourile nu mai sunt aliniate, culoarea nu mai spune ce
// e diferit (sau e singurul semnal, fara bara si litera), sau derularea pe
// obiecte mari se blocheaza. Un singur ListView (virtualizat) cu ambele
// panouri pe acelasi rand tine derularea sincronizata fara cod.
//
// Culorile NU se scriu aici: jetoanele vin din `src/jetoane.rs` prin
// `aplica_tema`, ca sa existe un singur loc de unde se verifica contrastul;
// jetoanele si piesele comune mai multor ecrane stau in `comune.slint`.

import { ListView } from "std-widgets.slint";
import { ListView } from "std-widgets.slint";
import { Tema, Despartitor, Chevron, Buton, ButonPrincipal, Tab, Bifa } from "comune.slint";

export struct BucataUi {
    text: string,
    // 0 text, 1 cuvant cheie, 2 variabila, 3 numar, 4 sir, 5 comentariu
    sintaxa: int,
    schimbat: bool,
}

export struct RandUi {
    // 0 linie, 1 pliere („22 de linii identice, 24-45")
    fel: int,
    pliere: string,
    st-nr: string,
    st: [BucataUi],
    dr-nr: string,
    dr: [BucataUi],
    // 0 egal, 1 modificat, 2 doar in sursa, 3 doar in baza
    stare: int,
    // a cata diferenta e randul, -1 pe context (bara e mai lata pe cea curenta)
    diferenta: int,
}

export struct MarcajUi {
    // pozitia si inaltimea in obiect, 0..1
    pozitie: float,
    inaltime: float,
    stare: int,
}

// --- piese mici -------------------------------------------------------------

// Hasura de 135° a partii fara linii: tigla se deseneaza in Rust din jetoane
// (`hasura-a` / `hasura-b`) si se repeta.
component Hasura inherits Rectangle {
    in property <image> tigla;
    clip: true;
    background: Tema.hasura-a;
    Image {
        source: root.tigla;
        width: 100%;
        height: 100%;
        horizontal-tiling: repeat;
        vertical-tiling: repeat;
        image-rendering: pixelated;
    }
}

component Bucati inherits HorizontalLayout {
    in property <[BucataUi]> bucati;
    in property <int> stare;
    spacing: 0px;
    alignment: start;
    for b in bucati: Rectangle {
        background: b.schimbat ? Tema.inlinie-stare(root.stare) : transparent;
        width: t.preferred-width;
        t := Text {
            text: b.text;
            font-family: Tema.font-mono;
            font-size: 12.5px;
            font-italic: b.sintaxa == 5;
            color: b.sintaxa == 1 ? Tema.s-cuvant
                 : b.sintaxa == 2 ? Tema.s-variabila
                 : b.sintaxa == 3 ? Tema.s-numar
                 : b.sintaxa == 4 ? Tema.s-sir
                 : b.sintaxa == 5 ? Tema.s-comentariu
                 : Tema.text;
            vertical-alignment: center;
        }
    }
}

// O jumatate de rand: bara din jgheab, numarul de linie real, textul colorat.
// Fara numar de linie = partea nu are linia: hasura, nu fundal gol.
component Jumatate inherits Rectangle {
    in property <string> nr;
    // unificat: al doilea jgheab de numere (sursa | baza), ca sa se vada din
    // ce parte vine linia fara sa apara vreun semn nou
    in property <string> nr-baza;
    in property <bool> doua-numere: false;
    in property <[BucataUi]> bucati;
    in property <int> stare;
    in property <bool> curenta;
    in property <bool> margine;
    // partea nu are linia (blocul e mai scurt aici): hasura, nu fundal gol
    in property <bool> fara-linie;
    in property <image> tigla;
    clip: true;
    min-width: 0px;
    background: root.fara-linie ? transparent
              : root.stare == 0 ? Tema.cod-fundal
              : Tema.fundal-stare(root.stare);
    if root.fara-linie && root.stare != 0: Hasura { tigla: root.tigla; width: 100%; height: 100%; }
    HorizontalLayout {
        spacing: 0px;
        alignment: start;
        // jgheabul: bara de 3 px a blocului diferit, 5 px pe diferenta curenta
        Rectangle {
            width: 3px;
            background: root.fara-linie || root.stare == 0 ? transparent : Tema.bara-stare(root.stare);
            if root.curenta && !root.fara-linie: Rectangle {
                x: 0px;
                width: 5px;
                background: Tema.bara-stare(root.stare);
            }
        }
        Text {
            width: 44px;
            text: root.nr;
            font-family: Tema.font-mono;
            font-size: 12.5px;
            color: Tema.numar-stare(root.stare);
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        if root.doua-numere: Text {
            width: 44px;
            text: root.nr-baza;
            font-family: Tema.font-mono;
            font-size: 12.5px;
            color: Tema.numar-stare(root.stare);
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Rectangle { width: 10px; }
        Bucati { bucati: root.bucati; stare: root.stare; }
    }
    if root.margine: Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Tema.linie;
    }
}

// Antetul unui panou de cod: baza, serverul, numarul de linii, mediul.
component AntetPanou inherits Rectangle {
    in property <length> retras: 47px;
    in property <string> baza;
    in property <string> detaliu;
    in property <string> mediu;
    in property <int> cod-mediu;
    in property <bool> margine;
    background: Tema.suprafata;
    HorizontalLayout {
        padding-left: root.retras;
        spacing: 8px;
        alignment: start;
        Text {
            text: root.baza;
            font-family: Tema.font-ui;
            font-size: 12px;
            font-weight: 500;
            color: Tema.text;
            vertical-alignment: center;
        }
        Text {
            text: root.detaliu;
            font-family: Tema.font-ui;
            font-size: 12px;
            color: Tema.text-secundar;
            vertical-alignment: center;
        }
        if root.mediu != "": Text {
            text: root.mediu;
            font-family: Tema.font-mono;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.6px;
            color: Tema.culoare-mediu(root.cod-mediu);
            vertical-alignment: center;
        }
    }
    if root.margine: Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Tema.linie;
    }
}

component Scurtatura inherits HorizontalLayout {
    in property <string> tasta;
    in property <string> ce;
    spacing: 5px;
    Text {
        text: root.tasta;
        font-family: Tema.font-mono;
        font-size: 11.5px;
        color: Tema.text-secundar;
        vertical-alignment: center;
    }
    Text {
        text: root.ce;
        font-family: Tema.font-ui;
        font-size: 11.5px;
        color: Tema.text-secundar;
        vertical-alignment: center;
    }
}

// --- fereastra --------------------------------------------------------------

export component EditorDiferente inherits Window {
    title: "gmotion — " + root.obiect-nume;
    preferred-width: 1440px;
    preferred-height: 900px;
    background: Tema.fundal;
    default-font-family: Tema.font-ui;
    default-font-size: 13px;

    // obiectul
    in property <string> obiect-schema;
    in property <string> obiect-nume;
    in property <string> tip-obiect;
    in property <string> rezumat;            // „4 diferente, una doar in comentariu"
    // partile comparate
    in property <string> sursa-baza;
    in property <string> sursa-detaliu;      // „srv-dev · 47 linii"
    in property <string> tinta-baza;
    in property <string> tinta-detaliu;
    in property <string> eticheta-mediu;     // PROD / TEST / DEV
    in property <int> mediu: 0;              // 0 dev, 1 test, 2 prod
    // continutul
    in property <[RandUi]> randuri;
    in property <[MarcajUi]> marcaje;
    in property <[int]> start-diferente;     // randul de inceput al fiecarei diferente
    in property <int> total-diferente;
    in-out property <int> diferenta-curenta: 0;
    in property <image> tigla-hasura;
    // starea obiectului
    in property <bool> revizuit: false;
    in-out property <bool> alaturat: true;
    in-out property <bool> pliaza-identicul: true;
    in property <string> stare-obiecte;      // „obiectul 4 din 212 nerevizuite"

    callback inapoi-lista();
    callback obiect-anterior();
    callback obiect-urmator();
    callback comuta-revizuit();
    callback adauga-in-plan();
    callback comuta-plierea(bool);
    callback comuta-alaturat(bool);
    callback editeaza-textul-final();

    property <length> inaltime-rand: 22px;

    public function mergi-la(i: int) {
        if (root.total-diferente == 0) { return; }
        root.diferenta-curenta = Math.max(0, Math.min(root.total-diferente - 1, i));
        lista.content-y = -Math.max(0, root.start-diferente[root.diferenta-curenta] - 3) * root.inaltime-rand;
    }

    taste := FocusScope {
        key-pressed(e) => {
            if (e.text == "n") { root.mergi-la(root.diferenta-curenta + 1); return accept; }
            if (e.text == "p") { root.mergi-la(root.diferenta-curenta - 1); return accept; }
            if (e.text == "j") { root.obiect-urmator(); return accept; }
            if (e.text == "k") { root.obiect-anterior(); return accept; }
            if (e.text == "u") { root.alaturat = !root.alaturat; root.comuta-alaturat(root.alaturat); return accept; }
            if (e.text == Key.Escape) { root.inapoi-lista(); return accept; }
            return reject;
        }

        VerticalLayout {
            // banda mediului tintei, pe toata latimea
            Rectangle {
                height: 3px;
                background: Tema.culoare-mediu(root.mediu);
            }

            // ---- antetul
            Rectangle {
                height: 48px;
                background: Tema.suprafata;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 14px;
                    // inapoi la lista
                    VerticalLayout {
                        horizontal-stretch: 0;
                        alignment: center;
                        Rectangle {
                            min-width: 14px + 6px + lista-et.preferred-width;
                            height: 20px;
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    Chevron { drum: "M 10 3 L 5 8 L 10 13"; culoare: Tema.text-secundar; width: 14px; height: 14px; stroke-width: 1.5px; }
                                }
                                lista-et := Text {
                                    text: "Listă";
                                    font-size: 13px;
                                    color: Tema.text-secundar;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea { clicked => { root.inapoi-lista(); } }
                        }
                    }
                    VerticalLayout { horizontal-stretch: 0; alignment: center; Despartitor {} }
                    // numele obiectului: schema estompata, numele in mono
                    VerticalLayout {
                        horizontal-stretch: 0;
                        alignment: center;
                        HorizontalLayout {
                            spacing: 0px;
                            alignment: start;
                            Text {
                                text: root.obiect-schema + ".";
                                font-family: Tema.font-mono;
                                font-size: 13px;
                                color: Tema.text-tert;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.obiect-nume;
                                font-family: Tema.font-mono;
                                font-size: 13px;
                                font-weight: 600;
                                color: Tema.text;
                                vertical-alignment: center;
                            }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 0;
                        alignment: center;
                        Text {
                            text: root.tip-obiect + " · " + root.rezumat;
                            font-size: 12px;
                            color: Tema.text-secundar;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // navigarea intre diferente
                    VerticalLayout {
                        horizontal-stretch: 0;
                        alignment: center;
                        HorizontalLayout {
                            spacing: 2px;
                            Rectangle {
                                width: 26px;
                                height: 26px;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Tema.linie;
                                background: sus.has-hover ? Tema.fundal : Tema.cod-fundal;
                                Chevron { drum: "M 3 10 L 8 5 L 13 10"; }
                                sus := TouchArea { clicked => { root.mergi-la(root.diferenta-curenta - 1); } }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.total-diferente == 0
                                        ? "0/0"
                                        : (root.diferenta-curenta + 1) + "/" + root.total-diferente;
                                    font-family: Tema.font-mono;
                                    font-size: 12px;
                                    color: Tema.text;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 42px;
                                }
                            }
                            Rectangle {
                                width: 26px;
                                height: 26px;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Tema.linie;
                                background: jos.has-hover ? Tema.fundal : Tema.cod-fundal;
                                Chevron { drum: "M 3 6 L 8 11 L 13 6"; }
                                jos := TouchArea { clicked => { root.mergi-la(root.diferenta-curenta + 1); } }
                            }
                        }
                    }
                    VerticalLayout { horizontal-stretch: 0; alignment: center; Despartitor {} }
                    VerticalLayout {
                        horizontal-stretch: 0;
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            Buton {
                                text: root.revizuit ? "Revizuit ✓" : "Revizuit";
                                apasat => { root.comuta-revizuit(); }
                            }
                            ButonPrincipal {
                                text: "În plan";
                                apasat => { root.adauga-in-plan(); }
                            }
                        }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Tema.linie;
                }
            }

            // ---- bara de unelte
            Rectangle {
                height: 34px;
                background: Tema.fundal;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 18px;
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 14px;
                        Tab {
                            text: "Alăturat";
                            activ: root.alaturat;
                            apasat => { root.alaturat = true; root.comuta-alaturat(true); }
                        }
                        Tab {
                            text: "Unificat";
                            activ: !root.alaturat;
                            apasat => { root.alaturat = false; root.comuta-alaturat(false); }
                        }
                    }
                    VerticalLayout { horizontal-stretch: 0; alignment: center; Rectangle { width: 1px; height: 16px; background: Tema.linie; } }
                    VerticalLayout {
                        horizontal-stretch: 0;
                        alignment: center;
                        Bifa {
                            text: "pliază identicul";
                            bifat: root.pliaza-identicul;
                            schimbat(v) => { root.pliaza-identicul = v; root.comuta-plierea(v); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        horizontal-stretch: 0;
                        alignment: center;
                        Rectangle {
                            min-width: editeaza.preferred-width;
                            height: 18px;
                            editeaza := Text {
                                text: "editează textul final";
                                font-size: 12.5px;
                                color: Tema.selectie;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                y: editeaza.y + editeaza.height - 1px;
                                x: editeaza.x;
                                width: editeaza.preferred-width;
                                height: 1px;
                                background: Tema.selectie;
                            }
                            TouchArea { clicked => { root.editeaza-textul-final(); } }
                        }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Tema.linie;
                }
            }

            // ---- corpul: antetele panourilor, codul, harta
            HorizontalLayout {
                vertical-stretch: 1;
                VerticalLayout {
                    horizontal-stretch: 1;
                    // antetele, pe aceeasi grila ca randurile de cod
                    Rectangle {
                        height: 26px;
                        background: Tema.suprafata;
                        AntetPanou {
                            retras: root.alaturat ? 47px : 91px;
                            x: 0px;
                            width: root.alaturat ? parent.width / 2 : parent.width;
                            height: parent.height;
                            // unificat: un singur antet, deci spune ambele baze
                            baza: root.alaturat
                                ? root.sursa-baza
                                : root.sursa-baza + " → " + root.tinta-baza;
                            detaliu: root.alaturat ? root.sursa-detaliu : root.tinta-detaliu;
                            mediu: root.alaturat ? "" : root.eticheta-mediu;
                            cod-mediu: root.mediu;
                            margine: root.alaturat;
                        }
                        if root.alaturat: AntetPanou {
                            x: parent.width / 2;
                            width: parent.width / 2;
                            height: parent.height;
                            baza: root.tinta-baza;
                            detaliu: root.tinta-detaliu;
                            mediu: root.eticheta-mediu;
                            cod-mediu: root.mediu;
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Tema.linie;
                        }
                    }
                    // codul
                    Rectangle {
                        background: Tema.cod-fundal;
                        vertical-stretch: 1;
                        // despartitorul dintre panouri merge pana jos, si sub
                        // ultimul rand: altfel se opreste unde se termina codul
                        if root.alaturat: Rectangle {
                            x: lista.visible-width / 2;
                            width: 1px;
                            background: Tema.linie;
                        }
                        lista := ListView {
                            for r in root.randuri: Rectangle {
                                height: root.inaltime-rand;
                                // o pliere: cat s-a ascuns, pe fundalul ferestrei
                                if r.fel == 1: Rectangle {
                                    background: pliere-zona.has-hover ? Tema.linie-slaba : Tema.fundal;
                                    HorizontalLayout {
                                        padding-left: 47px;
                                        alignment: start;
                                        Text {
                                            text: r.pliere;
                                            font-size: 11.5px;
                                            color: Tema.text-secundar;
                                            vertical-alignment: center;
                                        }
                                    }
                                    pliere-zona := TouchArea {
                                        clicked => {
                                            root.pliaza-identicul = false;
                                            root.comuta-plierea(false);
                                        }
                                    }
                                }
                                if r.fel == 0 && root.alaturat: Rectangle {
                                    Jumatate {
                                        x: 0px;
                                        width: parent.width / 2;
                                        nr: r.st-nr;
                                        bucati: r.st;
                                        stare: r.stare;
                                        curenta: r.diferenta == root.diferenta-curenta;
                                        fara-linie: r.st-nr == "";
                                        margine: true;
                                        tigla: root.tigla-hasura;
                                    }
                                    Jumatate {
                                        x: parent.width / 2;
                                        width: parent.width / 2;
                                        nr: r.dr-nr;
                                        bucati: r.dr;
                                        stare: r.stare;
                                        curenta: r.diferenta == root.diferenta-curenta;
                                        fara-linie: r.dr-nr == "";
                                        tigla: root.tigla-hasura;
                                    }
                                }
                                // unificat: o singura coloana, cu ambele jgheaburi
                                if r.fel == 0 && !root.alaturat: Jumatate {
                                    nr: r.st-nr;
                                    nr-baza: r.dr-nr;
                                    doua-numere: true;
                                    bucati: r.st-nr != "" ? r.st : r.dr;
                                    stare: r.stare;
                                    curenta: r.diferenta == root.diferenta-curenta;
                                    fara-linie: false;
                                    tigla: root.tigla-hasura;
                                }
                            }
                        }
                    }
                }
                // harta diferentelor
                Rectangle {
                    width: 14px;
                    background: Tema.fundal;
                    Rectangle {
                        x: 0px;
                        width: 1px;
                        background: Tema.linie;
                    }
                    // fereastra vizibila
                    Rectangle {
                        x: 1px;
                        width: parent.width - 1px;
                        y: root.randuri.length == 0 ? 0px
                           : (-lista.content-y / Math.max(1px, lista.content-height)) * parent.height;
                        height: root.randuri.length == 0 ? parent.height
                           : Math.max(6px, (lista.visible-height / Math.max(1px, lista.content-height)) * parent.height);
                        background: Tema.text.with-alpha(0.06);
                    }
                    for m in root.marcaje: Rectangle {
                        x: 3px;
                        width: parent.width - 6px;
                        y: m.pozitie * parent.height;
                        height: Math.max(2px, m.inaltime * parent.height);
                        background: Tema.bara-stare(m.stare);
                    }
                }
            }

            // ---- bara de jos: scurtaturile si locul in lista
            Rectangle {
                height: 24px;
                background: Tema.fundal;
                Rectangle {
                    height: 1px;
                    background: Tema.linie;
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 16px;
                    VerticalLayout { horizontal-stretch: 0; alignment: center; Scurtatura { tasta: "n p"; ce: "diferență"; } }
                    VerticalLayout { horizontal-stretch: 0; alignment: center; Scurtatura { tasta: "j k"; ce: "obiect"; } }
                    VerticalLayout { horizontal-stretch: 0; alignment: center; Scurtatura { tasta: "u"; ce: "unificat"; } }
                    VerticalLayout { horizontal-stretch: 0; alignment: center; Scurtatura { tasta: "esc"; ce: "listă"; } }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        horizontal-stretch: 0;
                        alignment: center;
                        Text {
                            text: root.stare-obiecte;
                            font-size: 11.5px;
                            color: Tema.text-secundar;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    init => { taste.focus(); }
}
