// Editorul de diferente, ca panza (`cercetare/schita-slint/ui/panza.slint`),
// pe jetoanele din `Tema`: titlul mare sus, sursa si baza ca doua panouri
// distincte, comenzile in insule care plutesc.
//
// Se strica astfel: panourile nu mai sunt aliniate, culoarea nu mai spune ce
// e diferit (sau e singurul semnal, fara bara si numar), sau derularea pe
// obiecte mari se blocheaza. Un singur ListView (virtualizat) cu ambele
// panouri pe acelasi rand tine derularea sincronizata fara cod.

import { ListView } from "std-widgets.slint";
import { RandListaUi, NodUi, Stari } from "lista.slint";

// Un tab din bara editorului (etapa 16). `cod`: -1 previzualizarea, altfel
// al catelea fixat; asa il intoarce fereastra in Rust.
export struct TabUi {
    cod: int,
    nume: string,       // taiat pe mijloc
    complet: string,    // la hover: baza / schema.nume
    activ: bool,
    previzualizare: bool,
    editat: bool,
}
import { Texte, Tema, ButonLimba, Semn, ButonTema, Bucati, Jumatate, RandUi, MarcajUi, LiniePrevizualizareUi, CampText, PastilaBloc, Chenar } from "comune.slint";

// Insula care pluteste peste panza.
component Tasta inherits Rectangle {
    in property <string> t;
    in property <bool> pe-accent;
    height: 18px;
    width: tx.preferred-width + 10px;
    border-radius: 5px;
    background: root.pe-accent ? transparent : Tema.strat;
    border-width: root.pe-accent ? 1px : 0;
    border-color: Tema.pe-accent;
    tx := Text { text: root.t; font-family: Tema.font-mono; font-size: 11px; color: root.pe-accent ? Tema.pe-accent : Tema.text-secundar; }
}

// Buton din insula. fel: 0 simplu, 1 principal (chihlimbar), 2 pornit
component ButonInsula inherits Rectangle {
    in property <string> text;
    in property <string> tasta;
    in property <int> fel;
    // inactiv: se vede, dar nu se apasa (Reset fara text final, Anuleaza
    // fara istoric)
    in property <bool> activ: true;
    callback apasat();
    height: 36px;
    width: r.preferred-width + 22px;
    border-radius: 10px;
    background: root.fel == 1 ? Tema.accent : root.fel == 2 ? Tema.strat : (z.has-hover ? Tema.strat : transparent);
    opacity: !root.activ ? 0.4 : root.fel == 1 && z.has-hover ? 0.88 : 1;
    r := HorizontalLayout {
        alignment: center;
        spacing: 7px;
        Text { text: root.text; font-family: Tema.font-ui; font-size: 13px; font-weight: root.fel == 0 ? 400 : 600; color: root.fel == 1 ? Tema.pe-accent : Tema.text; vertical-alignment: center; }
        if root.tasta != "": VerticalLayout { alignment: center; Tasta { t: root.tasta; pe-accent: root.fel == 1; } }
    }
    z := TouchArea { enabled: root.activ; clicked => { root.apasat(); } }
}

// Un punct colorat cu eticheta lui: legenda culorilor, o data pentru ambele
// panouri.
component Punct inherits HorizontalLayout {
    in property <color> c;
    in property <string> t;
    horizontal-stretch: 0;
    spacing: 6px;
    VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.c; } }
    Text { text: root.t; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-secundar; vertical-alignment: center; }
}

// Butonul mic din capul unui panou („Copiaza").
component ButonCap inherits Rectangle {
    in property <string> text;
    callback apasat();
    height: 24px;
    width: bt.preferred-width + 16px;
    border-radius: 7px;
    background: zb.has-hover ? Tema.strat : Tema.suprafata;
    border-width: 1px;
    border-color: Tema.linie;
    bt := Text { text: root.text; font-family: Tema.font-ui; font-size: 12px; color: Tema.text; }
    zb := TouchArea { clicked => { root.apasat(); } }
}

// Un rand din meniul „Actiuni" al antetului (etapa 18): ce statea in barele
// de jos, cu tasta lui alaturi.
component RandMeniu inherits Rectangle {
    in property <string> text;
    in property <string> tasta;
    in property <bool> activ: true;
    callback apasat();
    height: 30px;
    border-radius: 7px;
    background: zm.has-hover && root.activ ? Tema.strat : transparent;
    opacity: root.activ ? 1 : 0.4;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        Text { text: root.text; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text; vertical-alignment: center; horizontal-stretch: 1; }
        if root.tasta != "": VerticalLayout { alignment: center; Tasta { t: root.tasta; } }
    }
    zm := TouchArea { enabled: root.activ; clicked => { root.apasat(); } }
}

component Despartitor inherits VerticalLayout {
    alignment: center;
    Rectangle { width: 1px; height: 22px; background: Tema.linie; }
}

// Capul unui panou: rolul, baza, serverul si liniile, eticheta.
component CapPanou inherits Rectangle {
    in property <string> rol;
    in property <string> baza;
    in property <string> detaliu;
    in property <string> eticheta;
    in property <color> fond;
    in property <color> linie;
    // „editabil" (violet, ca liniile scrise de tine): clic = editeaza
    in property <bool> editabil: false;
    callback copiaza();
    callback editeaza();
    background: root.fond;
    Rectangle { y: parent.height - 1px; height: 1px; background: Tema.linie-slaba; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 8px;
        Text { text: root.rol; font-family: Tema.font-ui; font-size: 12px; font-weight: 600; color: Tema.text; vertical-alignment: center; }
        Text { text: root.baza; font-family: Tema.font-mono; font-size: 12px; color: Tema.text; vertical-alignment: center; overflow: elide; }
        Text { text: root.detaliu; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-secundar; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        if root.eticheta != "": VerticalLayout {
            alignment: center;
            Rectangle {
                height: 20px;
                width: et.preferred-width + 8px;
                et := Text { text: root.eticheta; font-family: Tema.font-ui; font-size: 11.5px; color: Tema.text-tert; }
            }
        }
        if root.editabil: VerticalLayout {
            alignment: center;
            Rectangle {
                height: 20px;
                width: ee.preferred-width + 14px;
                border-radius: 4px;
                background: Tema.tine;
                ee := Text { text: Texte.editabil; font-family: Tema.font-ui; font-size: 11.5px; font-weight: 500; color: Tema.pe-tine; }
                TouchArea { clicked => { root.editeaza(); } }
            }
        }
        VerticalLayout { alignment: center; ButonCap { text: Texte.copiaza; apasat => { root.copiaza(); } } }
    }
}

export component EditorDiferente inherits Window {
    title: "gmotion — " + root.obiect-nume; // text-permis: marca
    preferred-width: 1440px;
    preferred-height: 900px;
    background: Tema.fundal;
    default-font-family: Tema.font-ui;
    default-font-size: 13px;

    // obiectul
    in property <string> obiect-schema;
    in property <string> obiect-nume;
    in property <string> tip-obiect;
    in property <string> rezumat;            // „4 diferente, una doar in comentariu"
    // partile comparate
    in property <string> sursa-baza;
    in property <string> sursa-detaliu;      // „srv-dev · 47 linii"
    in property <string> tinta-baza;
    in property <string> tinta-detaliu;
    // continutul
    in property <[RandUi]> randuri;
    in property <[MarcajUi]> marcaje;
    in property <[int]> start-diferente;     // randul de inceput al fiecarei diferente
    // locul in care ajunge fiecare diferenta, pe randuri afisate: [de-la,
    // pana-la), -1 cand n-are. Pe diferenta, nu pe rand: doua blocuri pot
    // cadea in acelasi loc (acelasi rand-fantoma)
    in property <[int]> tinte-de-la;
    in property <[int]> tinte-pana-la;
    in property <int> total-diferente;
    in-out property <int> diferenta-curenta: 0;
    // ce randuri sunt incarcate acum (model + optiuni), din Rust (C6)
    in-out property <string> semnatura-randuri;
    in property <image> tigla-hasura;
    // starea obiectului
    in property <bool> revizuit: false;
    in property <bool> in-plan: false;
    // cheia obiectului deschis, `baza/schema.nume`. Pleaca inapoi cu textul
    // scris de mana, ca Rust sa poata refuza un text venit pentru alt obiect
    // (F-A1 din auditul QA).
    in property <string> obiect-id;
    in-out property <bool> alaturat: true;
    // implicit se vede tot codul (Mihai, 2026-11-20); aplicatia pune
    // alegerea tinuta minte in configurare
    in-out property <bool> pliaza-identicul: false;
    // wrap (etapa 19): liniile lungi continua pe randul urmator; Rust le
    // rupe la `coloane-wrap` caractere, calculat aici din latimea panoului
    in-out property <bool> impacheteaza: false;
    out property <int> coloane-wrap: Math.floor((root.panou - 60px - (root.alaturat ? 0px : 44px)) / 7.52px);
    callback comuta-wrap(bool);
    changed coloane-wrap => {
        if (root.impacheteaza) { root.comuta-wrap(true); }
    }
    in property <string> stare-obiecte;      // „obiectul 4 din 212 nerevizuite"
    // editarea (vezi `incarca_editarea`)
    in property <bool> omis: false;
    in property <bool> editat: false;         // exista text final: Reset are ce face
    in property <bool> se-poate-anula: false;
    in property <string> text-sursa;
    in property <string> text-final;
    in property <string> salvat;              // „salvat la 14:52"
    in property <bool> ghidat: false;
    in property <bool> ghidat-din-sursa: true;
    in property <bool> ghidat-terminat: false;
    in property <string> ghidat-titlu;
    in-out property <bool> ascunde-diferentele: false;
    in-out property <bool> editeaza-mod: false;

    callback inapoi-lista();
    callback obiect-anterior();
    callback obiect-urmator();
    callback comuta-revizuit();
    callback adauga-in-plan();
    callback comuta-plierea(bool);
    callback comuta-alaturat(bool);
    callback editeaza-textul-final();
    callback alege-tema(bool);
    // comutatorul de limba: etichetele si indicele ales vin din Rust
    in property <[string]> limbi;
    in property <int> limba-aleasa;
    callback alege-limba(int);
    callback ecran-complet();
    callback comuta-omis();
    callback aplica-diferenta(int);
    // blocul tras acum cu mouse-ul (-1 = niciunul) si cat s-a tras spre dreapta
    in-out property <int> trage-diferenta: -1;
    // ce se trage: blocul motorului (o singura instructiune, chiar dintr-un
    // grup) si textul randului apucat; randul de sub mouse si unde e mouse-ul,
    // in coordonatele zonei de cod (pentru fantoma care il urmeaza)
    in-out property <int> trage-bloc: -1;
    in-out property <string> trage-text;
    in-out property <int> trage-rand: -1;
    in-out property <length> trage-gx;
    in-out property <length> trage-gy;
    // lasat pe locul sugerat, sau ce face locul de sub mouse (`loc` al randului)
    out property <bool> trage-pe-sugerat: root.trage-diferenta >= 0 && root.trage-rand >= 0
        && root.trage-rand >= root.tinte-de-la[root.trage-diferenta]
        && root.trage-rand < root.tinte-pana-la[root.trage-diferenta];
    out property <int> trage-loc: root.trage-rand >= 0 && root.trage-rand < root.randuri.length
        ? root.randuri[root.trage-rand].loc : -1;
    // lasarea unui bloc tras: (bloc, loc); loc -1 = pe locul sugerat
    callback plaseaza(int, int);
    // previzualizarea la hover pe sageata din canal: ce diferenta, unde
    // (sub sageata, in coordonatele zonei de cod) si liniile, puse din Rust
    // de `previzualizeaza`
    in-out property <int> previzualizare-diferenta: -1;
    in-out property <length> previzualizare-y;
    in property <[LiniePrevizualizareUi]> previzualizare-linii;
    callback previzualizeaza(int);
    in-out property <length> trage-x;
    callback aplica-toate();
    callback reset();
    callback anuleaza();
    callback salveaza-textul(string, string);   // (obiect-id, text)
    callback ghidat-porneste();
    callback ghidat-opreste();
    callback ghidat-alege(bool);
    callback ghidat-aplica();
    callback ghidat-sari();
    callback resincronizeaza();
    // ---- coloana din stanga: lista, stransa, ca sa nu pleci din ecran cand
    // deschizi un obiect (pachetul B). `latime-lista` 0 = ascunsa.
    in property <[RandListaUi]> randuri-lista;
    in property <int> selectat-lista;
    // coloana e arborele din lista, ca Object Explorer din SSMS (Mihai,
    // 2026-11-19): baza › dosar pe tip › obiect; `pozitie` alege randul din
    // `randuri-lista`, care sta in ordinea listei
    in property <[NodUi]> noduri-lista;
    // randul selectat in arbore: coloana se deruleaza la el (in `lista-ingusta`)
    in property <int> nod-selectat-lista: -1;
    callback comuta-nod(string);
    property <RandListaUi> rand-gol;
    in property <string> rezumat-lista;
    in property <int> numar-obiecte;
    in-out property <length> latime-lista: 320px;
    // ultima latime trasa cu mouse-ul; la ea revine coloana dupa Esc
    in-out property <length> latime-lista-aleasa: 320px;
    // pin / banda / partea (etapa 16). Fara pin, coloana apare peste editor
    // la hover pe margine; ca banda, ramane o fasie ingusta cu contoare.
    in-out property <bool> lista-fixata: true;
    in-out property <bool> lista-dreapta: false;
    in-out property <bool> lista-banda: false;
    in property <string> banda-text;          // contoarele pe stari, pe randuri
    in-out property <string> detalii-hover;
    property <bool> lista-peste: false;
    property <length> latime-coloana: root.lista-banda ? 44px : root.latime-lista;
    // cat ia coloana din latimea editorului, si de unde incepe editorul
    property <length> ocupat: root.latime-lista == 0px ? 0px
        : (root.lista-fixata || root.lista-banda ? root.latime-coloana : 0px);
    property <length> stanga: root.lista-dreapta ? 0px : root.ocupat;
    callback coloana-schimbata();
    callback alege-randul(int);
    callback cauta(string);
    callback ascunde-lista();
    // ---- taburile (etapa 16): logica e in `model_taburi`, aici doar desenul
    in property <[TabUi]> taburi;
    callback activeaza-tab(int);
    callback inchide-tab(int);
    callback fixeaza-previzualizarea();
    callback inchide-tab-activ();
    // dublu clic pe un rand din coloana listei: obiectul se fixeaza in tab
    callback fixeaza-randul(int);
    property <bool> are-taburi: root.taburi.length > 0;
    // cate taburi incap pe rand; restul, in meniul „+N"
    property <int> taburi-incap: Math.max(1, Math.floor((root.width - root.ocupat - 80px) / 190px));
    // antetul obiectului (etapa 18): +/- si unde difera, ca in macheta
    in property <string> plus;
    in property <string> minus;
    in property <[string]> difera-in;
    // bara de sus: progresul revizuirii si planul
    in property <string> progres-text;        // „5/18 revizuite"
    in property <float> progres-fractie;
    in property <int> numar-deploy;
    callback deschide-deploy();
    /// „Uneste ciclul cursor": `DECLARE ... CURSOR` pana la `DEALLOCATE`
    /// intr-un singur bloc. Taierea e in `core`, aici doar comutatorul.
    in property <bool> are-cursor;
    in property <bool> uneste-cursorul;
    callback comuta-unirea-cursorului(bool);
    callback diferenta-schimbata(int);

    property <length> inaltime-rand: 22px;
    // canalul dintre panouri: destul de lat cat sa se vada curba unei legaturi
    property <length> jgheab: 44px;
    // etapa 18, ca in macheta: bara de sus, taburi, antetul obiectului, apoi
    // panourile pe toata suprafata ramasa; jos, linia de scurtaturi
    property <length> sus: 56px;
    property <length> jos: 26px;
    // panourile umplu latimea editorului, lipite de margini
    property <length> latime-cod: root.width - root.ocupat;
    // latimea unui panou; 14 px raman pentru harta diferentelor
    property <length> panou: root.alaturat ? (root.latime-cod - root.jgheab - 14px) / 2 : root.latime-cod - 14px;
    // ---- derularea pe orizontala a codului (V10)
    // `latime-continut` vine din Rust: latimea celei mai lungi linii, in
    // pixeli, la fontul mono de 12,5 px. Fara ea nu se stie cat e de derulat.
    in property <length> latime-continut: 0px;
    in-out property <length> derulare-x: 0px;
    property <length> latime-text: root.panou - 57px;
    out property <length> derulare-maxima: max(0px, root.latime-continut - root.latime-text);
    public function deruleaza(cu: length) {
        root.derulare-x = Math.max(0px, Math.min(root.derulare-maxima, root.derulare-x + cu));
    }

    public function mergi-la(i: int) {
        if (root.total-diferente == 0) { return; }
        root.diferenta-curenta = Math.max(0, Math.min(root.total-diferente - 1, i));
        lista.content-y = -Math.max(0, root.start-diferente[root.diferenta-curenta] - 3) * root.inaltime-rand;
    }
    // la fel, dar spune si aplicatiei (care tine minte diferenta curenta)
    function navigheaza(i: int) {
        root.mergi-la(i);
        root.diferenta-schimbata(root.diferenta-curenta);
    }
    // focusul inapoi pe taste (dupa editarea de mana); public pentru teste
    public function focus-taste() {
        taste.focus();
    }
    function porneste-editarea() {
        root.editeaza-mod = true;
        root.editeaza-textul-final();
    }

    taste := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.F11) { root.ecran-complet(); return accept; }
            // cat se scrie textul de mana: Esc renunta la editare, nu pleaca
            // din ecran, iar restul scurtaturilor nu au ce cauta (F-A1)
            if (root.editeaza-mod) {
                if (e.text == Key.Escape) { root.editeaza-mod = false; taste.focus(); return accept; }
                return accept;
            }
            // modul ghidat: Enter aplica, Esc sare, sus / jos alta diferenta
            if (root.ghidat && root.ghidat-terminat) {
                if (e.text == Key.Return || e.text == Key.Escape) { root.ghidat-opreste(); return accept; }
            }
            if (root.ghidat && !root.ghidat-terminat) {
                if (e.text == Key.Return) { root.ghidat-aplica(); return accept; }
                if (e.text == Key.Escape) { root.ghidat-sari(); return accept; }
                if (e.text == Key.UpArrow) { root.navigheaza(root.diferenta-curenta - 1); return accept; }
                if (e.text == Key.DownArrow) { root.navigheaza(root.diferenta-curenta + 1); return accept; }
            }
            if (e.modifiers.control && (e.text == "z" || e.text == "Z")) { root.anuleaza(); return accept; }
            if (e.modifiers.control && (e.text == "w" || e.text == "W")) { root.inchide-tab-activ(); return accept; }
            // Scurtaturile cu litera cer Ctrl (Mihai, 2026-11-20): o litera
            // singura, scrisa in cautarea din coloana, pornea si actiunea.
            // Ctrl+W ramane „inchide tabul", deci wrap-ul e pe Ctrl+L, iar
            // „ascunde lista" ([) pe Ctrl+B.
            if (e.modifiers.control && (e.text == "b" || e.text == "B")) { root.ascunde-lista(); return accept; }
            if ((e.modifiers.control && (e.text == "n" || e.text == "N")) || (e.text == Key.F7 && !e.modifiers.shift)) { root.navigheaza(root.diferenta-curenta + 1); return accept; }
            if ((e.modifiers.control && (e.text == "p" || e.text == "P")) || (e.text == Key.F7 && e.modifiers.shift)) { root.navigheaza(root.diferenta-curenta - 1); return accept; }
            if ((e.modifiers.control && (e.text == "j" || e.text == "J")) || e.text == Key.PageDown) { root.obiect-urmator(); return accept; }
            if ((e.modifiers.control && (e.text == "k" || e.text == "K")) || e.text == Key.PageUp) { root.obiect-anterior(); return accept; }
            if (e.modifiers.control && (e.text == "r" || e.text == "R")) { root.comuta-revizuit(); return accept; }
            if (e.modifiers.control && (e.text == "o" || e.text == "O")) { root.comuta-omis(); return accept; }
            if (e.modifiers.control && (e.text == "i" || e.text == "I")) { root.adauga-in-plan(); return accept; }
            if (e.modifiers.control && (e.text == "g" || e.text == "G")) { if (root.ghidat) { root.ghidat-opreste(); } else { root.ghidat-porneste(); } return accept; }
            if (e.modifiers.control && (e.text == "e" || e.text == "E")) { root.porneste-editarea(); return accept; }
            if (e.modifiers.control && (e.text == "u" || e.text == "U")) { root.alaturat = !root.alaturat; root.comuta-alaturat(root.alaturat); return accept; }
            if (e.modifiers.control && (e.text == "l" || e.text == "L")) { root.impacheteaza = !root.impacheteaza; root.derulare-x = 0px; root.comuta-wrap(root.impacheteaza); return accept; }
            // liniile lungi: Shift + sageti deruleaza codul pe orizontala,
            // Shift+Home il aduce inapoi la inceput (V10)
            if (e.modifiers.shift && e.text == Key.RightArrow) { root.deruleaza(120px); return accept; }
            if (e.modifiers.shift && e.text == Key.LeftArrow) { root.deruleaza(-120px); return accept; }
            if (e.text == Key.Home) { root.derulare-x = 0px; return accept; }
            // Esc: intai largeste lista inapoi la tot ecranul, nu pleaca direct
            if (e.text == Key.Escape) { root.inapoi-lista(); return accept; }
            return reject;
        }

        // ---- panza (etapa 18, ca in macheta): taburile lipite de antetul
        // obiectului, apoi cele doua panouri pe toata suprafata ramasa
        VerticalLayout {
            x: root.stanga;
            y: root.sus;
            width: root.width - root.ocupat;
            height: root.height - root.sus - root.jos;
            // modul ghidat isi are locul lui sub cod, nu peste el
            padding-bottom: root.ghidat ? 150px : 0px;
            // taburile, lipite de antetul de dedesubt
            Rectangle {
                height: 36px;
                Rectangle { y: parent.height - 1px; height: 1px; background: Tema.linie-slaba; }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 2px;
                    alignment: start;
                    for t[i] in root.taburi: Rectangle {
                        visible: i < root.taburi-incap;
                        width: i < root.taburi-incap ? Math.min(220px, tt.preferred-width + 44px) : 0px;
                        y: 4px;
                        height: 32px;
                        border-top-left-radius: 8px;
                        border-top-right-radius: 8px;
                        background: t.activ ? Tema.suprafata : zt.has-hover ? Tema.strat.transparentize(0.5) : transparent;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 8px;
                            spacing: 8px;
                            // fixat: punctul de accent (cu text final: plin)
                            if !t.previzualizare: VerticalLayout {
                                alignment: center;
                                Rectangle { width: 6px; height: 6px; border-radius: 3px; background: t.editat ? Tema.accent : Tema.accent.transparentize(0.5); }
                            }
                            tt := Text {
                                horizontal-stretch: 1;
                                text: t.nume;
                                font-family: Tema.font-ui;
                                font-size: 12px;
                                font-italic: t.previzualizare;
                                color: t.activ ? Tema.text : Tema.text-tert;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            // previzualizarea se inlocuieste la urmatorul clic in lista;
                            // pinul o pastreaza ca tab (ca dublu clicul pe tab)
                            if t.previzualizare: Rectangle {
                                width: 18px;
                                Text { text: "◆"; font-size: 11px; color: zpin.has-hover ? Tema.accent-text : Tema.text-tert; }
                                zpin := TouchArea { clicked => { root.fixeaza-previzualizarea(); } }
                            }
                            Rectangle {
                                width: 16px;
                                Text { text: "×"; font-size: 13px; color: zx-tab.has-hover ? Tema.text : Tema.text-tert; }
                                zx-tab := TouchArea { clicked => { root.inchide-tab(t.cod); } }
                            }
                        }
                        zt := TouchArea {
                            width: parent.width - (t.previzualizare ? 42px : 24px);
                            x: 0;
                            // dublul clic pe previzualizare (o fixeaza) il numara Rust-ul
                            clicked => { root.activeaza-tab(t.cod); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // „+N": taburile care nu mai incap, intr-un meniu
                    if root.taburi.length > root.taburi-incap: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: plus-tab.preferred-width + 16px;
                            height: 22px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Tema.linie;
                            background: zp.has-hover ? Tema.strat : transparent;
                            plus-tab := Text { text: "+" + (root.taburi.length - root.taburi-incap) + " ▾"; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-tert; }
                            zp := TouchArea { clicked => { meniu-taburi.show(); } }
                            meniu-taburi := PopupWindow {
                                y: parent.height + 4px;
                                x: parent.width - 240px;
                                width: 240px;
                                Rectangle {
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: Tema.linie;
                                    background: Tema.suprafata;
                                    VerticalLayout {
                                        padding: 6px;
                                        for t[i] in root.taburi: Rectangle {
                                            visible: i >= root.taburi-incap;
                                            height: i >= root.taburi-incap ? 30px : 0px;
                                            border-radius: 7px;
                                            background: zm.has-hover ? Tema.strat : transparent;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                Text { text: t.nume; font-family: Tema.font-ui; font-size: 12.5px; font-italic: t.previzualizare; color: Tema.text; vertical-alignment: center; }
                                            }
                                            zm := TouchArea { clicked => { root.activeaza-tab(t.cod); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // antetul obiectului, pe un rand: nume, +/-, unde difera,
            // navigarea intre diferente, Revizuit, Alaturat / Unificat, Actiuni
            Rectangle {
                height: 44px;
                background: Tema.suprafata;
                Rectangle { y: parent.height - 1px; height: 1px; background: Tema.linie-slaba; }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 12px;
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        min-width: 180px;
                        alignment: start;
                        Text { text: root.obiect-schema + "."; font-family: Tema.font-mono; font-size: 14px; color: Tema.text-tert; vertical-alignment: center; }
                        Text { text: root.obiect-nume; font-family: Tema.font-mono; font-size: 14px; color: Tema.text; vertical-alignment: center; overflow: elide; }
                    }
                    if root.plus != "": HorizontalLayout {
                        spacing: 6px;
                        Text { text: root.plus; font-family: Tema.font-mono; font-size: 12px; color: Tema.add-text; vertical-alignment: center; }
                        Text { text: root.minus; font-family: Tema.font-mono; font-size: 12px; color: Tema.del-text; vertical-alignment: center; }
                    }
                    if root.difera-in.length > 0 && root.width - root.ocupat > 900px: Text { text: Texte.difera-in-mic; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-tert; vertical-alignment: center; }
                    for d in (root.width - root.ocupat > 900px ? root.difera-in : []): VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 22px;
                            width: dc.preferred-width + 16px;
                            border-radius: 11px;
                            border-width: 1px;
                            border-color: Tema.accent;
                            dc := Text { text: d; font-family: Tema.font-ui; font-size: 11px; color: Tema.accent-text; }
                        }
                    }
                    // diferenta curenta si navigarea (n / p)
                    HorizontalLayout {
                        spacing: 2px;
                        VerticalLayout { alignment: center; ButonCap { text: "↑"; apasat => { root.navigheaza(root.diferenta-curenta - 1); } } }
                        Text {
                            text: root.total-diferente == 0 ? "0 / 0" : (root.diferenta-curenta + 1) + " / " + root.total-diferente;
                            font-family: Tema.font-mono;
                            font-size: 12px;
                            color: Tema.text-secundar;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            min-width: 44px;
                        }
                        VerticalLayout { alignment: center; ButonCap { text: "↓"; apasat => { root.navigheaza(root.diferenta-curenta + 1); } } }
                    }
                    VerticalLayout {
                        alignment: center;
                        ButonCap {
                            text: root.revizuit ? Texte.revizuit-bifat : Texte.revizuit;
                            apasat => { root.comuta-revizuit(); }
                        }
                    }
                    // Alaturat / Unificat
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 28px;
                            width: comutator.preferred-width + 4px;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Tema.linie;
                            background: Tema.cod-fundal;
                            comutator := HorizontalLayout {
                                padding: 2px;
                                spacing: 2px;
                                for o[k] in [Texte.alaturat, Texte.unificat]: Rectangle {
                                    width: oc.preferred-width + 20px;
                                    border-radius: 6px;
                                    background: (k == 0) == root.alaturat ? Tema.strat : transparent;
                                    oc := Text { text: o; font-family: Tema.font-ui; font-size: 12px; color: (k == 0) == root.alaturat ? Tema.text : Tema.text-secundar; }
                                    TouchArea { clicked => { root.alaturat = k == 0; root.comuta-alaturat(root.alaturat); } }
                                }
                            }
                        }
                    }
                    // plierea liniilor identice: comutator vizibil, nu doar in meniu
                    VerticalLayout {
                        alignment: center;
                        ButonCap {
                            text: root.pliaza-identicul ? Texte.pliaza-identicul-bifat : Texte.pliaza-identicul;
                            apasat => { root.pliaza-identicul = !root.pliaza-identicul; root.comuta-plierea(root.pliaza-identicul); }
                        }
                    }
                    // wrap: liniile lungi continua dedesubt, fara derulare
                    VerticalLayout {
                        alignment: center;
                        ButonCap {
                            text: root.impacheteaza ? Texte.impacheteaza-bifat : Texte.impacheteaza;
                            apasat => { root.impacheteaza = !root.impacheteaza; root.derulare-x = 0px; root.comuta-wrap(root.impacheteaza); }
                        }
                    }
                    // tot ce statea in barele de jos, cu tastele pastrate
                    VerticalLayout {
                        alignment: center;
                        ButonCap { text: Texte.actiuni; apasat => { meniu-actiuni.show(); } }
                    }
                }
                meniu-actiuni := PopupWindow {
                    x: parent.width - 300px;
                    y: parent.height + 2px;
                    width: 288px;
                    Rectangle {
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Tema.linie;
                        background: Tema.suprafata;
                        drop-shadow-blur: 24px;
                        drop-shadow-color: Tema.intunecat ? #00000080 : #0f111526;
                        VerticalLayout {
                            padding: 6px;
                            spacing: 1px;
                            RandMeniu { text: Texte.fixeaza-tab; apasat => { root.fixeaza-previzualizarea(); } }
                            Rectangle { height: 1px; background: Tema.linie-slaba; }
                            RandMeniu { text: Texte.aplica-toate; activ: root.total-diferente > 0; apasat => { root.aplica-toate(); } }
                            RandMeniu { text: Texte.reset; activ: root.editat; apasat => { root.reset(); } }
                            RandMeniu { text: Texte.anuleaza-ctrlz; tasta: "Ctrl Z"; activ: root.se-poate-anula; apasat => { root.anuleaza(); } }
                            Rectangle { height: 1px; background: Tema.linie-slaba; }
                            RandMeniu { text: Texte.editeaza; tasta: "Ctrl E"; apasat => { root.porneste-editarea(); } }
                            RandMeniu {
                                text: root.ghidat ? Texte.mod-ghidat-pornit : Texte.mod-ghidat;
                                tasta: "Ctrl G";
                                activ: root.ghidat || root.total-diferente > 0;
                                apasat => { if (root.ghidat) { root.ghidat-opreste(); } else { root.ghidat-porneste(); } }
                            }
                            RandMeniu { text: root.omis ? Texte.omis-bifat : Texte.omite; tasta: "Ctrl O"; apasat => { root.comuta-omis(); } }
                            Rectangle { height: 1px; background: Tema.linie-slaba; }
                            RandMeniu {
                                text: root.pliaza-identicul ? Texte.pliaza-identicul-bifat : Texte.pliaza-identicul;
                                apasat => { root.pliaza-identicul = !root.pliaza-identicul; root.comuta-plierea(root.pliaza-identicul); }
                            }
                            RandMeniu {
                                text: root.ascunde-diferentele ? Texte.arata-diferentele : Texte.ascunde-diferentele;
                                apasat => { root.ascunde-diferentele = !root.ascunde-diferentele; }
                            }
                            RandMeniu { text: Texte.resincronizeaza; apasat => { root.resincronizeaza(); } }
                            // doar pe obiectele care chiar au cursor
                            if root.are-cursor: RandMeniu {
                                text: root.uneste-cursorul ? Texte.desparte-cursor : Texte.uneste-cursor;
                                apasat => { root.comuta-unirea-cursorului(!root.uneste-cursorul); }
                            }
                            Rectangle { height: 1px; background: Tema.linie-slaba; }
                            // legenda culorilor, o data pentru ambele panouri
                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                Punct { c: Tema.mod-bara; t: Texte.modificat; }
                                Punct { c: Tema.add-bara; t: Texte.adus-din-martor; }
                                Punct { c: Tema.del-bara; t: Texte.doar-in-modificata; }
                                Punct { c: Tema.tine; t: Texte.scris-de-tine; }
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                vertical-stretch: 1;
                zona-cod := Rectangle {
                    width: root.latime-cod;
                    // fondurile panourilor: lipite, fara colturi, pe tot spatiul
                    Rectangle {
                        x: 0;
                        width: root.panou + (root.alaturat ? root.jgheab / 2 : 0px);
                        background: root.alaturat ? Tema.panou-sursa : Tema.cod-fundal;
                    }
                    if root.alaturat: Rectangle {
                        x: root.panou + root.jgheab / 2;
                        width: parent.width - self.x;
                        background: Tema.cod-fundal;
                    }
                    if root.alaturat: Rectangle { x: root.panou + root.jgheab / 2; width: 1px; background: Tema.linie; }
                    VerticalLayout {
                        width: parent.width - 14px;
                        HorizontalLayout {
                            height: 30px;
                            spacing: root.jgheab;
                            if root.alaturat: CapPanou {
                                width: root.panou;
                                rol: Texte.martor;
                                baza: root.sursa-baza;
                                detaliu: root.sursa-detaliu;
                                eticheta: Texte.doar-citire;
                                fond: Tema.cap-sursa;
                                linie: Tema.linie;
                                copiaza => { clip-sursa.select-all(); clip-sursa.copy(); }
                            }
                            CapPanou {
                                width: root.panou;
                                rol: root.alaturat ? Texte.modificata : Texte.unificat;
                                baza: root.alaturat ? root.tinta-baza : root.sursa-baza + " → " + root.tinta-baza;
                                detaliu: root.tinta-detaliu;
                                fond: Tema.cap-baza;
                                linie: Tema.contur-baza;
                                editabil: true;
                                copiaza => { clip-final.select-all(); clip-final.copy(); }
                                editeaza => { root.porneste-editarea(); }
                            }
                        }
                        lista := ListView {
                            vertical-stretch: 1;
                            for r[idx] in root.randuri: Rectangle {
                                height: root.inaltime-rand;
                                // o pliere: cat s-a ascuns; un clic arata tot
                                if r.fel == 1: Rectangle {
                                    HorizontalLayout {
                                        padding-left: 56px;
                                        alignment: start;
                                        Text {
                                            text: r.pliere;
                                            font-family: Tema.font-ui;
                                            font-size: 11.5px;
                                            color: pliere-zona.has-hover ? Tema.text : Tema.text-secundar;
                                            vertical-alignment: center;
                                        }
                                    }
                                    pliere-zona := TouchArea {
                                        clicked => {
                                            root.pliaza-identicul = false;
                                            root.comuta-plierea(false);
                                        }
                                    }
                                }
                                // eticheta blocului, pe randul ei, deasupra blocului:
                                // in Martor pentru ce vine de acolo, in Modificata
                                // pentru ce e doar acolo (stare 3)
                                // antetul cutiei blocului (ca in v3.4): eticheta in
                                // colt, „1 / 3" in dreapta, chenarul de sus; pe
                                // fiecare parte unde blocul are cod
                                if r.fel == 2 && !root.ascunde-diferentele && root.alaturat: HorizontalLayout {
                                    spacing: 0px;
                                    Rectangle {
                                        width: (parent.width - root.jgheab) / 2;
                                        if r.cutie-st: Rectangle {
                                            background: Tema.fundal-stare(r.stare);
                                            Chenar { stare: r.stare; sus: true; }
                                            if r.stare != 3: PastilaBloc { x: 8px; text: r.eticheta; stare: r.stare; }
                                            Text {
                                                x: parent.width - self.width - 10px;
                                                text: r.nr-diferenta + " / " + root.total-diferente;
                                                font-family: Tema.font-mono;
                                                font-size: 10.5px;
                                                color: Tema.bara-stare(r.stare);
                                                vertical-alignment: center;
                                                height: parent.height;
                                            }
                                        }
                                    }
                                    Rectangle { width: root.jgheab; }
                                    Rectangle {
                                        width: (parent.width - root.jgheab) / 2;
                                        if r.cutie-dr: Rectangle {
                                            background: Tema.fundal-stare(r.stare);
                                            Chenar { stare: r.stare; sus: true; }
                                            if r.stare == 3: PastilaBloc { x: 8px; text: r.eticheta; stare: r.stare; }
                                            Text {
                                                x: parent.width - self.width - 10px;
                                                text: r.nr-diferenta + " / " + root.total-diferente;
                                                font-family: Tema.font-mono;
                                                font-size: 10.5px;
                                                color: Tema.bara-stare(r.stare);
                                                vertical-alignment: center;
                                                height: parent.height;
                                            }
                                        }
                                    }
                                }
                                if r.fel == 2 && !root.ascunde-diferentele && !root.alaturat: Rectangle {
                                    PastilaBloc { x: 92px; text: r.eticheta; stare: r.stare; }
                                }
                                if r.fel == 0 && root.alaturat: HorizontalLayout {
                                    spacing: 0px;
                                    Rectangle {
                                        width: (parent.width - root.jgheab) / 2;
                                        Jumatate {
                                            // blocul luat se stinge cat timp e tras
                                            opacity: root.trage-diferenta >= 0 && r.bloc >= 0 && r.bloc == root.trage-bloc ? 0.4 : 1;
                                            width: parent.width;
                                            nr: r.st-nr;
                                            bucati: r.st;
                                            stare: root.ascunde-diferentele ? 0 : r.stare;
                                            curenta: r.diferenta == root.diferenta-curenta;
                                            fara-linie: r.continuare ? r.st-lipsa : r.st-nr == "";
                                            fond: Tema.panou-sursa;
                                            decalaj-x: root.derulare-x;
                                            tigla: root.tigla-hasura;
                                            eticheta: root.ascunde-diferentele || r.stare == 3 ? "" : r.eticheta;
                                        }
                                        if r.cutie-st && !root.ascunde-diferentele: Chenar { stare: r.stare; jos: r.cutie-jos; }
                                        // blocul din sursa se poate **trage**
                                        // peste panoul din dreapta; e acelasi
                                        // lucru ca sageata din canal, doar ca
                                        // se face cu mana
                                        // (un rand gol, bloc doar in Modificata,
                                        // n-are ce sa traga)
                                        if r.diferenta >= 0 && r.stare != 0 && r.stare != 3 && !root.ascunde-diferentele: TouchArea {
                                            mouse-cursor: self.pressed ? grabbing : grab;
                                            moved => {
                                                // se considera tragere abia dupa cativa
                                                // pixeli: altfel un clic obisnuit aprinde
                                                // zona de plasare si pare un bug
                                                if (self.pressed && Math.abs(self.mouse-x - self.pressed-x) > 6px) {
                                                    root.trage-diferenta = r.diferenta;
                                                    root.trage-bloc = r.bloc;
                                                    root.trage-text = r.text-st;
                                                    root.trage-x = self.mouse-x - self.pressed-x;
                                                    root.trage-rand = Math.max(0, Math.min(root.randuri.length - 1,
                                                        idx + Math.floor(self.mouse-y / root.inaltime-rand)));
                                                    root.trage-gx = self.absolute-position.x + self.mouse-x - zona-cod.absolute-position.x;
                                                    root.trage-gy = self.absolute-position.y + self.mouse-y - zona-cod.absolute-position.y;
                                                }
                                            }
                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.up) {
                                                    // tras peste Modificata: pe locul sugerat, sau
                                                    // oriunde se poate lasa (Mihai: „daca aia nu e
                                                    // buna, sa o poata pune oriunde")
                                                    if (root.trage-diferenta >= 0 && root.trage-diferenta == r.diferenta && root.trage-x > root.jgheab) {
                                                        if (root.trage-pe-sugerat) {
                                                            root.plaseaza(root.trage-bloc, -1);
                                                        } else if (root.trage-loc != -1) {
                                                            root.plaseaza(root.trage-bloc, root.trage-loc);
                                                        }
                                                    }
                                                    root.trage-diferenta = -1;
                                                    root.trage-bloc = -1;
                                                    root.trage-rand = -1;
                                                    root.trage-x = 0px;
                                                }
                                            }
                                        }
                                    }
                                    // canalul dintre panouri: sageata de aplicare a blocului,
                                    // sau bifa unde s-a adus din sursa
                                    Rectangle {
                                        width: root.jgheab;
                                        // linia de legatura: tine cat tine
                                        // blocul, ca sa se vada ce bucata din
                                        // stanga merge peste ce bucata din
                                        // dreapta
                                        // legatura spre locul unde ajunge blocul: cat
                                        // tine drumul pe verticala, cu un capat plin
                                        // (inlocuieste un bloc) sau gol (se insereaza)
                                        // legatura spre locul unde ajunge blocul: o
                                        // curba, desenata peste canal de stratul de
                                        // mai jos (`legaturi`), ca sa treaca de la un
                                        // rand la altul
                                        if r.inceput && r.stare != 0 && r.linii-bloc > 1 && !root.ascunde-diferentele: Rectangle {
                                            y: root.inaltime-rand / 2;
                                            width: 1px;
                                            height: (r.linii-bloc - 1) * root.inaltime-rand;
                                            background: r.diferenta == root.diferenta-curenta ? Tema.mod-text : Tema.mod-bara;
                                            opacity: r.diferenta == root.diferenta-curenta ? 1 : 0.5;
                                        }
                                        if r.inceput && r.stare != 0 && !root.ascunde-diferentele: Rectangle {
                                            width: 24px;
                                            height: 18px;
                                            border-radius: 9px;
                                            background: r.diferenta == root.diferenta-curenta ? Tema.text : (za.has-hover ? Tema.strat : Tema.cod-fundal);
                                            border-width: r.diferenta == root.diferenta-curenta ? 0px : 1.5px;
                                            border-color: Tema.mod-bara;
                                            Text {
                                                text: "→";
                                                font-family: Tema.font-mono;
                                                font-size: 12px;
                                                color: r.diferenta == root.diferenta-curenta ? Tema.fundal : Tema.mod-text;
                                            }
                                            za := TouchArea {
                                                clicked => {
                                                    root.previzualizare-diferenta = -1;
                                                    root.aplica-diferenta(r.diferenta);
                                                }
                                                // previzualizarea: cum ar arata Modificata
                                                // daca apesi, fara sa apesi
                                                changed has-hover => {
                                                    if (self.has-hover) {
                                                        root.previzualizare-y = self.absolute-position.y + self.height - zona-cod.absolute-position.y;
                                                        root.previzualizare-diferenta = r.diferenta;
                                                        root.previzualizeaza(r.diferenta);
                                                    } else if (root.previzualizare-diferenta == r.diferenta) {
                                                        root.previzualizare-diferenta = -1;
                                                    }
                                                }
                                            }
                                        }
                                        if r.inceput && r.stare == 0 && r.dr-marcaj == 1 && !root.ascunde-diferentele: Rectangle {
                                            width: 24px;
                                            height: 18px;
                                            border-radius: 9px;
                                            background: Tema.add-fundal;
                                            Text { text: "✓"; font-family: Tema.font-ui; font-size: 11px; color: Tema.add-text; }
                                        }
                                    }
                                    Rectangle {
                                        width: (parent.width - root.jgheab) / 2;
                                        Jumatate {
                                            width: parent.width;
                                            nr: r.dr-nr;
                                            bucati: r.dr;
                                            stare: root.ascunde-diferentele || r.inserare ? 0 : r.stare;
                                            marcaj: root.ascunde-diferentele ? 0 : r.dr-marcaj;
                                            curenta: r.diferenta == root.diferenta-curenta;
                                            fara-linie: r.inserare ? false : r.continuare ? r.dr-lipsa : r.dr-nr == "";
                                            decalaj-x: root.derulare-x;
                                            tigla: root.tigla-hasura;
                                            eticheta: root.ascunde-diferentele || r.stare != 3 ? "" : r.eticheta;
                                            fantoma: r.fantoma && !root.ascunde-diferentele;
                                            // cat tragi un bloc, locul lui se aprinde
                                            tinta-aprinsa: root.trage-diferenta >= 0
                                                && idx >= root.tinte-de-la[root.trage-diferenta]
                                                && idx < root.tinte-pana-la[root.trage-diferenta];
                                            tinta-prima: idx == root.tinte-de-la[root.trage-diferenta];
                                            // locul de sub mouse, cand nu e cel sugerat
                                            tinta-mouse: root.trage-diferenta >= 0 && root.trage-x > root.jgheab
                                                && !root.trage-pe-sugerat && r.loc != -1 && r.loc == root.trage-loc;
                                            text-plasare: root.trage-x <= root.jgheab ? Texte.trage-peste
                                                : r.fantoma ? Texte.plaseaza-aici-insereaza
                                                : Texte.plaseaza-aici-inlocuieste;
                                        }
                                        if r.cutie-dr && !root.ascunde-diferentele: Chenar { stare: r.stare; jos: r.cutie-jos; }
                                        // Zona de plasare se aprindea pe randurile
                                        // blocului tras, adica acolo unde ar cadea
                                        // daca ar cadea pe pozitie. De la etapa 21
                                        // se aprinde **locul calculat de motor**
                                        // (`tinte-de-la` / `tinte-pana-la`), ca sa
                                        // nu promita alt loc decat cel in care scrie.
                                    }
                                }
                                // unificat: o singura coloana, cu ambele jgheaburi
                                if r.fel == 0 && !root.alaturat: Rectangle {
                                    Jumatate {
                                        width: parent.width;
                                        nr: r.st-nr;
                                        nr-baza: r.dr-nr;
                                        doua-numere: true;
                                        bucati: r.st-nr != "" || (r.continuare && !r.st-lipsa) ? r.st : r.dr;
                                        stare: root.ascunde-diferentele ? 0 : r.stare;
                                        marcaj: root.ascunde-diferentele || r.st-nr != "" ? 0 : r.dr-marcaj;
                                        curenta: r.diferenta == root.diferenta-curenta;
                                        fara-linie: false;
                                        decalaj-x: root.derulare-x;
                                        tigla: root.tigla-hasura;
                                    }
                                    // previzualizare la hover: cealalta
                                    // versiune a liniei, fara sa comuti pe
                                    // alaturat
                                    if r.pereche-nr != "" && !root.ascunde-diferentele: TouchArea {
                                        peste := Rectangle {
                                            x: 56px;
                                            y: root.inaltime-rand - 2px;
                                            width: Math.min(parent.width - 72px, pereche-text.preferred-width + 20px);
                                            height: root.inaltime-rand + 6px;
                                            border-radius: 6px;
                                            border-width: 1px;
                                            border-color: Tema.linie;
                                            background: Tema.suprafata;
                                            drop-shadow-blur: 14px;
                                            drop-shadow-offset-y: 4px;
                                            drop-shadow-color: Tema.intunecat ? #00000080 : #0f111526;
                                            visible: parent.has-hover;
                                            pereche-text := HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 8px;
                                                Text {
                                                    text: r.pereche-nr;
                                                    font-family: Tema.font-mono;
                                                    font-size: 11.5px;
                                                    color: Tema.text-tert;
                                                    vertical-alignment: center;
                                                }
                                                Bucati { bucati: r.pereche; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        // bara de derulare pe orizontala: liniile mai lungi
                        // decat panoul se pot citi tragand-o, sau cu
                        // Shift + sageti (V10 din auditul QA)
                        if root.derulare-maxima > 0px: bara-oriz := Rectangle {
                            height: 12px;
                            property <length> de_la;
                            property <length> util: parent.width - 8px;
                            property <length> cursor: Math.max(40px, bara-oriz.util * root.latime-text / root.latime-continut);
                            Rectangle {
                                x: 4px + (bara-oriz.util - bara-oriz.cursor) * (root.derulare-x / root.derulare-maxima);
                                y: 4px;
                                width: bara-oriz.cursor;
                                height: 5px;
                                border-radius: 2.5px;
                                background: trage-oriz.pressed || trage-oriz.has-hover ? Tema.text-secundar : Tema.text-tert;
                            }
                            trage-oriz := TouchArea {
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down) { bara-oriz.de_la = root.derulare-x; }
                                }
                                moved => {
                                    root.derulare-x = Math.max(0px, Math.min(root.derulare-maxima,
                                        bara-oriz.de_la + (self.mouse-x - self.pressed-x)
                                            * root.derulare-maxima / Math.max(1px, bara-oriz.util - bara-oriz.cursor)));
                                }
                            }
                        }
                    }
                    // legaturile curbe din canal (v3.4, cerute de Mihai inapoi): de
                    // la primul rand al fiecarei diferente la locul ei din
                    // Modificata; plina = inlocuieste, stinsa cu capat gol = se
                    // insereaza. Urmaresc derularea listei (`content-y`); fara
                    // TouchArea, deci nu iau clicul sagetilor de dedesubt
                    if root.alaturat && !root.ascunde-diferentele: legaturi := Rectangle {
                        x: root.panou;
                        y: 30px;
                        width: root.jgheab;
                        height: lista.height;
                        clip: true;
                        for t[k] in root.tinte-de-la: Path {
                            property <float> h: root.inaltime-rand / 1px;
                            property <float> y1: (root.start-diferente[k] + 0.5) * self.h + lista.content-y / 1px;
                            property <bool> gol: t >= 0 && root.randuri[t].fantoma;
                            // la inserare, spre randul cu textul (in dreptul
                            // blocului); la inlocuire, spre mijlocul blocului
                            property <float> y2: (self.gol ? t + 0.5 : (t + root.tinte-pana-la[k]) / 2) * self.h + lista.content-y / 1px;
                            property <bool> curenta: k == root.diferenta-curenta;
                            visible: t >= 0 && root.start-diferente[k] >= 0
                                && Math.max(self.y1, self.y2) > -20 && Math.min(self.y1, self.y2) < legaturi.height / 1px + 20;
                            width: parent.width;
                            height: parent.height;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: self.width / 1px;
                            viewbox-height: self.height / 1px;
                            fill: transparent;
                            stroke: self.gol ? Tema.del-bara : Tema.mod-bara;
                            stroke-width: self.curenta ? 2.2px : 1.4px;
                            opacity: self.curenta ? 1 : (self.gol ? 0.55 : 0.75);
                            MoveTo { x: 0; y: parent.y1; }
                            CubicTo {
                                control-1-x: parent.width / 1px * 0.55;
                                control-1-y: parent.y1;
                                control-2-x: parent.width / 1px * 0.45;
                                control-2-y: parent.y2;
                                x: parent.width / 1px;
                                y: parent.y2;
                            }
                        }
                        // capatul legaturii: plin la inlocuire, gol la inserare
                        for t[k] in root.tinte-de-la: Rectangle {
                            property <length> y2: (t >= 0 && root.randuri[t].fantoma ? t + 0.5 : (t + root.tinte-pana-la[k]) / 2) * root.inaltime-rand + lista.content-y;
                            visible: t >= 0 && root.start-diferente[k] >= 0 && self.y2 > -10px && self.y2 < legaturi.height + 10px;
                            x: parent.width - 4px;
                            y: self.y2 - 3px;
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: t >= 0 && root.randuri[t].fantoma ? Tema.fundal : Tema.mod-bara;
                            border-width: t >= 0 && root.randuri[t].fantoma ? 1.5px : 0px;
                            border-color: Tema.del-bara;
                        }
                    }
                    // ce tragi: o fantoma care urmeaza mouse-ul, cu ce se intampla
                    // daca o lasi acum si primul rand al blocului (Mihai: „nu are
                    // nicio animatie sa-mi indice ca am luat blocul")
                    if root.trage-diferenta >= 0 && root.trage-bloc >= 0: Rectangle {
                        x: root.trage-gx + 16px;
                        y: root.trage-gy + 12px;
                        width: Math.min(460px, Math.max(fantoma-actiune.preferred-width, fantoma-cod.preferred-width) + 24px);
                        height: 50px;
                        border-radius: 7px;
                        border-width: 1.5px;
                        border-color: root.trage-x <= root.jgheab ? Tema.linie : (root.trage-pe-sugerat || root.trage-loc != -1 ? Tema.accent : Tema.del-bara);
                        background: Tema.suprafata;
                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 3px;
                            fantoma-actiune := Text {
                                text: root.trage-x <= root.jgheab ? Texte.trage-peste
                                    : root.trage-pe-sugerat ? Texte.lasa-pe-sugerat
                                    : root.trage-loc >= 0 ? Texte.lasa-inlocuieste
                                    : root.trage-loc <= -2 ? Texte.lasa-insereaza
                                    : Texte.lasa-nimic;
                                font-family: Tema.font-ui;
                                font-size: 11px;
                                font-weight: 600;
                                color: Tema.accent-text;
                            }
                            fantoma-cod := Text {
                                text: root.trage-text;
                                font-family: Tema.font-mono;
                                font-size: 12px;
                                color: Tema.text;
                                overflow: elide;
                            }
                        }
                    }
                    // previzualizarea la hover: peste panoul Martor, sub
                    // sageata (deasupra, daca jos nu incape). Fara TouchArea:
                    // nu ia mouse-ul de pe sageata, deci nu clipeste
                    if root.previzualizare-diferenta >= 0 && root.alaturat && root.trage-diferenta < 0
                        && !root.editeaza-mod && root.previzualizare-linii.length > 0: Rectangle {
                        property <length> inaltime: 46px + root.previzualizare-linii.length * 20px + 8px;
                        x: 40px;
                        width: Math.max(200px, root.panou - 60px);
                        height: self.inaltime;
                        y: root.previzualizare-y + 4px + self.inaltime <= parent.height
                            ? root.previzualizare-y + 4px
                            : Math.max(30px, root.previzualizare-y - root.inaltime-rand - self.inaltime - 4px);
                        border-radius: 8px;
                        border-width: 1.5px;
                        border-color: Tema.accent;
                        background: Tema.suprafata;
                        clip: true;
                        VerticalLayout {
                            Rectangle {
                                height: 44px;
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 10px;
                                    Text { text: Texte.previzualizare; font-family: Tema.font-ui; font-size: 12.5px; font-weight: 700; color: Tema.accent-text; vertical-alignment: center; }
                                    Text { text: "— " + Texte.previzualizare-explicatie; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-secundar; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; overflow: elide; }
                                }
                            }
                            Rectangle { height: 1px; background: Tema.linie; }
                            Rectangle { height: 4px; }
                            for l in root.previzualizare-linii: Rectangle {
                                height: 20px;
                                background: l.adusa ? Tema.add-fundal : transparent;
                                if l.adusa: Rectangle { x: 0px; width: 3px; background: Tema.add-bara; }
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 10px;
                                    Text { width: 32px; text: l.nr; horizontal-alignment: right; font-family: Tema.font-mono; font-size: 11.5px; color: Tema.text-tert; vertical-alignment: center; }
                                    Text { text: l.text; font-family: Tema.font-mono; font-size: 12px; color: l.adusa ? Tema.text : Tema.text-secundar; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                }
                            }
                        }
                    }
                    // „Editeaza": panoul Baza devine un text de scris de mana
                    if root.editeaza-mod: Rectangle {
                        x: root.alaturat ? root.panou + root.jgheab : 0px;
                        y: 30px;
                        width: root.panou;
                        height: parent.height - 30px;
                        background: Tema.cod-fundal;
                        border-width: 1.5px;
                        border-color: Tema.tine;
                        VerticalLayout {
                            padding: 1.5px;
                            ed-flick := Flickable {
                                vertical-stretch: 1;
                                content-width: Math.max(self.width, ed.preferred-width + 32px);
                                content-height: Math.max(self.height, ed.preferred-height + 24px);
                                ed := TextInput {
                                    x: 16px;
                                    y: 12px;
                                    text: root.text-final;
                                    single-line: false;
                                    wrap: no-wrap;
                                    font-family: Tema.font-mono;
                                    font-size: 12.5px;
                                    color: Tema.text;
                                    selection-background-color: Tema.tine.transparentize(0.6);
                                    selection-foreground-color: Tema.text;
                                    init => { self.focus(); }
                                }
                            }
                            Rectangle {
                                height: 48px;
                                background: Tema.cap-baza;
                                HorizontalLayout {
                                    padding: 6px;
                                    padding-left: 14px;
                                    spacing: 6px;
                                    Text { text: Texte.scrii-textul; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-secundar; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                    ButonInsula { text: Texte.renunta; apasat => { root.editeaza-mod = false; taste.focus(); } }
                                    ButonInsula { text: Texte.salveaza; fel: 1; apasat => { root.salveaza-textul(root.obiect-id, ed.text); root.editeaza-mod = false; taste.focus(); } }
                                }
                            }
                        }
                    }
                    // harta diferentelor, la marginea din dreapta
                    Rectangle {
                        x: parent.width - 10px;
                        y: 30px;
                        width: 10px;
                        height: parent.height - 30px;
                        border-radius: 5px;
                        background: Tema.strat;
                        Rectangle {
                            y: root.randuri.length == 0 ? 0px : (-lista.content-y / Math.max(1px, lista.content-height)) * parent.height;
                            height: root.randuri.length == 0 ? parent.height : Math.max(6px, (lista.visible-height / Math.max(1px, lista.content-height)) * parent.height);
                            border-radius: 5px;
                            background: Tema.linie;
                        }
                        for m in root.marcaje: Rectangle {
                            x: 2px;
                            width: parent.width - 4px;
                            y: m.pozitie * parent.height;
                            height: Math.max(3px, m.inaltime * parent.height);
                            border-radius: 1.5px;
                            background: Tema.bara-stare(m.stare);
                        }
                    }
                }
            }
        }

        // ---- coloana listei: stransa langa editor, ca sa nu pleci din ecran
        // cand deschizi un obiect (15 B). Etapa 16: grupata pe stare, cu pin
        // (fara pin apare peste editor la hover pe margine), banda ingusta
        // (`[`, «) si mutarea pe partea cealalta (⇄).
        // marginea pe care, fara pin, se arata coloana
        if root.latime-lista > 0px && !root.lista-fixata && !root.lista-banda && !root.lista-peste: TouchArea {
            x: root.lista-dreapta ? root.width - 8px : 0px;
            y: root.sus;
            width: 8px;
            height: root.height - root.sus - root.jos;
            changed has-hover => { if (self.has-hover) { root.lista-peste = true; } }
        }
        // fara pin: iesirea cu mouse-ul de pe coloana o ascunde la loc
        if root.latime-lista > 0px && !root.lista-fixata && !root.lista-banda && root.lista-peste: TouchArea {
            x: root.lista-dreapta ? root.width - root.latime-lista - 28px : root.latime-lista + 4px;
            y: root.sus;
            width: 24px;
            height: root.height - root.sus - root.jos;
            changed has-hover => { if (self.has-hover) { root.lista-peste = false; } }
        }
        if root.latime-lista > 0px && (root.lista-fixata || root.lista-banda || root.lista-peste): Rectangle {
            x: root.lista-dreapta ? root.width - root.latime-coloana : 0px;
            y: root.sus;
            width: root.latime-coloana;
            height: root.height - root.sus - root.jos;
            background: Tema.suprafata;
            drop-shadow-blur: root.lista-fixata || root.lista-banda ? 0px : 24px;
            drop-shadow-color: Tema.intunecat ? #00000080 : #0f111526;
            Rectangle { x: root.lista-dreapta ? 0px : parent.width - 1px; width: 1px; height: parent.height; background: Tema.linie; }
            // ---- banda ingusta: contoarele pe stari si » inapoi
            if root.lista-banda: VerticalLayout {
                padding-top: 12px;
                spacing: 10px;
                alignment: start;
                Rectangle {
                    height: 26px;
                    Text { text: root.lista-dreapta ? "«" : "»"; font-size: 15px; color: zb.has-hover ? Tema.text : Tema.text-secundar; }
                    zb := TouchArea { clicked => { root.lista-banda = false; root.coloana-schimbata(); } }
                }
                Text { text: root.banda-text; font-family: Tema.font-mono; font-size: 11px; color: Tema.text-secundar; horizontal-alignment: center; }
            }
            if !root.lista-banda: VerticalLayout {
                padding-top: 10px;
                // capul coloanei, ca in macheta: „Obiecte N" si iconitele
                HorizontalLayout {
                    height: 28px;
                    padding-left: 14px;
                    padding-right: 8px;
                    spacing: 2px;
                    Text { text: Texte.obiecte-titlu; font-family: Tema.font-ui; font-size: 12px; font-weight: 500; color: Tema.text; vertical-alignment: center; }
                    Text { text: " " + root.numar-obiecte; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-tert; vertical-alignment: center; horizontal-stretch: 1; }
                    // pin, muta pe partea cealalta, banda
                    for b[k] in [root.lista-fixata ? "◆" : "◇", "⇄", root.lista-dreapta ? "»" : "«"]: Rectangle {
                        width: 24px;
                        border-radius: 6px;
                        background: zbtn.has-hover ? Tema.strat : transparent;
                        Text { text: b; font-size: 13px; color: k == 0 && root.lista-fixata ? Tema.accent-text : Tema.text-secundar; }
                        zbtn := TouchArea {
                            clicked => {
                                if (k == 0) { root.lista-fixata = !root.lista-fixata; root.lista-peste = false; }
                                if (k == 1) { root.lista-dreapta = !root.lista-dreapta; }
                                if (k == 2) { root.lista-banda = true; root.lista-peste = false; }
                                root.coloana-schimbata();
                            }
                        }
                    }
                }
                // cautarea, ca in lista mare
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 6px;
                    padding-bottom: 8px;
                    Rectangle {
                        height: 32px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: camp-cauta.are-focus ? Tema.accent : Tema.linie;
                        clip: true;
                        if camp-cauta.text == "": Text {
                            x: 10px;
                            text: Texte.cauta-obiect;
                            font-family: Tema.font-ui;
                            font-size: 12.5px;
                            color: Tema.text-tert;
                            vertical-alignment: center;
                        }
                        camp-cauta := CampText {
                            x: 10px;
                            width: parent.width - 20px;
                            marime: 12.5px;
                            edited(t) => { root.cauta(t); }
                        }
                    }
                }
                lista-ingusta := ListView {
                    vertical-stretch: 1;
                    property <int> tinta: root.nod-selectat-lista;
                    changed tinta => {
                        if (self.tinta < 0) { return; }
                        if (self.tinta * 28px < -self.content-y) {
                            self.content-y = -self.tinta * 28px;
                        } else if ((self.tinta + 1) * 28px > -self.content-y + self.visible-height) {
                            self.content-y = -((self.tinta + 1) * 28px - self.visible-height);
                        }
                    }
                    for n in root.noduri-lista: Rectangle {
                        property <RandListaUi> r: n.pozitie >= 0 ? root.randuri-lista[n.pozitie] : root.rand-gol;
                        property <bool> sel: n.fel == 2 && n.pozitie == root.selectat-lista;
                        height: 28px;
                        border-radius: 6px;
                        background: sel ? Tema.strat : (zr.has-hover ? Tema.fundal : transparent);
                        if sel: Rectangle { x: 0; width: 3px; height: 20px; border-radius: 1.5px; background: Tema.accent; }
                        HorizontalLayout {
                            padding-left: 6px + n.nivel * 14px;
                            padding-right: 8px;
                            spacing: 6px;
                            // sageata bazei / dosarului; obiectul n-are
                            Rectangle {
                                width: 12px;
                                if n.fel != 2: Text {
                                    text: n.deschis ? "▾" : "▸";
                                    font-size: 11px;
                                    color: Tema.text-tert;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }
                            if n.fel == 2: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 12px;
                                    height: 12px;
                                    border-radius: 6px;
                                    border-width: 1.5px;
                                    border-color: r.revizuit ? Tema.add-bara : Tema.text-tert;
                                    if r.revizuit: Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Tema.add-bara; }
                                }
                            }
                            if n.fel == 2: Text { text: r.litera; font-family: Tema.font-mono; font-size: 11px; color: Stari.culoare(r.stare); vertical-alignment: center; }
                            Text {
                                horizontal-stretch: 1;
                                text: n.fel == 2 ? r.nume-scurt : n.eticheta;
                                font-family: n.fel == 1 ? Tema.font-ui : Tema.font-mono;
                                font-size: n.fel == 0 ? 12.5px : 12px;
                                font-weight: n.fel == 0 ? 600 : n.fel == 1 ? 500 : 400;
                                color: n.fel != 2 || sel ? Tema.text : Tema.text-secundar;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if n.fel != 2: Text { text: n.numar; font-family: Tema.font-ui; font-size: 11px; color: Tema.text-tert; vertical-alignment: center; }
                            if n.fel == 2: Text { text: r.plus; font-family: Tema.font-mono; font-size: 11px; color: Tema.add-text; vertical-alignment: center; }
                            if n.fel == 2: Text { text: r.minus; font-family: Tema.font-mono; font-size: 11px; color: Tema.del-text; vertical-alignment: center; }
                        }
                        // „+": deschide obiectul intr-un tab nou (ca dublu clicul,
                        // care nu se vede); apare la mouse
                        if n.fel == 2 && zr.has-hover: Rectangle {
                            x: parent.width - self.width - 6px;
                            y: (parent.height - self.height) / 2;
                            width: 22px;
                            height: 22px;
                            border-radius: 6px;
                            background: zplus.has-hover ? Tema.accent : Tema.suprafata;
                            border-width: 1px;
                            border-color: Tema.accent;
                            Text { text: "+"; font-size: 14px; color: zplus.has-hover ? Tema.pe-accent : Tema.accent-text; }
                            zplus := TouchArea { clicked => { root.fixeaza-randul(n.pozitie); } }
                        }
                        zr := TouchArea {
                            // baza / dosar: se deschide sau se inchide; obiectul se
                            // alege (dublul clic, tab nou, il numara Rust-ul)
                            clicked => {
                                if (n.fel == 2) {
                                    root.alege-randul(n.pozitie);
                                } else {
                                    root.comuta-nod(n.cheie);
                                }
                            }
                            changed has-hover => {
                                if (self.has-hover && n.fel == 2) {
                                    root.detalii-hover = r.schema + "." + r.nume + " · " + r.baza + "\n" + r.tip + " · " + r.plus + " " + r.minus + " · " + r.scor-text + " · " + r.difera-in;
                                }
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Tema.linie-slaba; }
                // la hover: numele complet si ce se stie despre rand
                Text {
                    height: 44px;
                    text: root.detalii-hover != "" ? root.detalii-hover : root.rezumat-lista;
                    font-family: Tema.font-mono;
                    font-size: 11px;
                    color: Tema.text-tert;
                    vertical-alignment: center;
                    wrap: char-wrap;
                    x: 12px;
                    width: parent.width - 24px;
                }
            }
        }

        // marginea dintre coloana listei si editor: se trage cu mouse-ul,
        // intre 200 si 520 px (15 B, etapa 16; mai lata de la arbore, etapa 19). Latimea aleasa se tine minte,
        // ca Esc sa o readuca.
        if root.latime-lista > 0px && !root.lista-banda && (root.lista-fixata || root.lista-peste): Rectangle {
            x: root.lista-dreapta ? root.width - root.latime-lista - 5px : root.latime-lista - 5px;
            y: root.sus;
            width: 10px;
            height: root.height - root.sus - root.jos;
            maner-lista := TouchArea {
                mouse-cursor: ew-resize;
                moved => {
                    if (self.pressed) {
                        root.latime-lista = Math.max(200px, Math.min(520px, root.width - 640px,
                            root.latime-lista + (root.lista-dreapta ? -1 : 1) * (self.mouse-x - self.pressed-x)));
                        root.latime-lista-aleasa = root.latime-lista;
                    }
                }
                changed pressed => { if (!self.pressed) { root.coloana-schimbata(); } }
            }
            Rectangle {
                x: (parent.width - 3px) / 2;
                width: 3px;
                height: 48px;
                y: (parent.height - 48px) / 2;
                border-radius: 1.5px;
                background: maner-lista.pressed || maner-lista.has-hover ? Tema.accent : transparent;
            }
        }

        // ---- bara de sus, pe toata latimea (etapa 18, ca in macheta): semnul,
        // lista si obiectul anterior / urmator, martor -> modificata, progresul
        // revizuirii, apoi Revizuit / In plan / Deploy, tema si limba
        Rectangle {
            x: 0;
            y: 0;
            width: root.width;
            height: root.sus;
            background: Tema.fundal;
            Rectangle { y: parent.height - 1px; height: 1px; background: Tema.linie-slaba; }
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 14px;
                spacing: 10px;
                VerticalLayout { alignment: center; Semn { marime: 17px; } }
                Despartitor { }
                VerticalLayout { alignment: center; ButonInsula { height: 32px; text: Texte.lista-scurt; tasta: "Esc"; apasat => { root.inapoi-lista(); } } }
                VerticalLayout { alignment: center; ButonInsula { height: 32px; text: "‹"; tasta: "Ctrl K"; apasat => { root.obiect-anterior(); } } }
                VerticalLayout { alignment: center; ButonInsula { height: 32px; text: "›"; tasta: "Ctrl J"; apasat => { root.obiect-urmator(); } } }
                Despartitor { }
                HorizontalLayout {
                    spacing: 8px;
                    horizontal-stretch: 1;
                    alignment: start;
                    Text { text: root.sursa-baza; font-family: Tema.font-mono; font-size: 13px; color: Tema.text; vertical-alignment: center; overflow: elide; }
                    Text { text: "→"; font-family: Tema.font-ui; font-size: 13px; color: Tema.text-secundar; vertical-alignment: center; }
                    Text { text: root.tinta-baza; font-family: Tema.font-mono; font-size: 13px; color: Tema.text; vertical-alignment: center; overflow: elide; }
                }
                // progresul revizuirii; pe ecrane inguste lasa loc numelor
                if root.width > 1200px: VerticalLayout {
                    width: 150px;
                    alignment: center;
                    spacing: 4px;
                    HorizontalLayout {
                        Text { text: root.progres-text; font-family: Tema.font-ui; font-size: 11px; color: Tema.text-tert; horizontal-stretch: 1; }
                        Text { text: Math.round(root.progres-fractie * 100) + "%"; font-family: Tema.font-ui; font-size: 11px; color: Tema.text-tert; }
                    }
                    Rectangle {
                        height: 3px;
                        border-radius: 1.5px;
                        background: Tema.strat;
                        Rectangle { x: 0; width: parent.width * Math.max(0, Math.min(1, root.progres-fractie)); border-radius: 1.5px; background: Tema.accent; }
                    }
                }
                Despartitor { }
                VerticalLayout { alignment: center; ButonInsula { height: 32px; text: root.revizuit ? Texte.revizuit-bifat : Texte.revizuit; tasta: "Ctrl R"; fel: root.revizuit ? 2 : 0; apasat => { root.comuta-revizuit(); } } }
                VerticalLayout { alignment: center; ButonInsula { height: 32px; text: root.in-plan ? Texte.in-plan-bifat : Texte.in-plan; tasta: "Ctrl I"; fel: 1; apasat => { root.adauga-in-plan(); } } }
                VerticalLayout { alignment: center; ButonInsula { height: 32px; text: Texte.deploy + " (" + root.numar-deploy + ")"; activ: root.numar-deploy > 0; apasat => { root.deschide-deploy(); } } }
                VerticalLayout { alignment: center; ButonTema { alege(i) => { root.alege-tema(i); } } }
                VerticalLayout { alignment: center; ButonLimba { limbi: root.limbi; aleasa: root.limba-aleasa; alege(i) => { root.alege-limba(i); } } }
            }
        }

        // ---- jos: o singura linie cu scurtaturile, ca in macheta; in
        // dreapta, cand s-a salvat ultima data
        Rectangle {
            x: 0;
            y: root.height - root.jos;
            width: root.width;
            height: root.jos;
            background: Tema.fundal;
            Rectangle { height: 1px; y: 0; background: Tema.linie-slaba; }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 18px;
                for k in [{ t: "Ctrl J K", e: Texte.obiect-mic }, { t: "Ctrl N P", e: Texte.diferenta-mic }, { t: "Ctrl E", e: Texte.text-final-mic }, { t: "Ctrl R", e: Texte.revizuit-mic }, { t: "Ctrl B", e: Texte.ascunde-lista-mic }, { t: "Ctrl W", e: Texte.inchide-tab-mic }]: HorizontalLayout {
                    spacing: 5px;
                    Text { text: k.t; font-family: Tema.font-mono; font-size: 11px; font-weight: 500; color: Tema.text-secundar; vertical-alignment: center; }
                    Text { text: k.e; font-family: Tema.font-ui; font-size: 11px; color: Tema.text-tert; vertical-alignment: center; }
                }
                Rectangle { horizontal-stretch: 1; }
                // pozitia si ce s-a intamplat cu ultima comanda pe taburi
                // (capat, tab refuzat, obiect fara editor)
                Text { text: root.stare-obiecte; font-family: Tema.font-ui; font-size: 11px; color: Tema.text-secundar; vertical-alignment: center; overflow: elide; min-width: 0; horizontal-stretch: 1; horizontal-alignment: right; }
                Text { text: root.salvat; font-family: Tema.font-ui; font-size: 11px; color: Tema.text-tert; vertical-alignment: center; overflow: elide; }
            }
        }

        // ---- modul ghidat: ce pui in baza pentru blocul curent
        if root.ghidat: Rectangle {
            x: root.stanga + (root.width - root.ocupat - self.width) / 2;
            y: root.height - root.jos - 14px - self.height;
            width: Math.min(760px, root.width - 80px);
            height: gc.preferred-height;
            background: Tema.text;
            border-radius: 16px;
            drop-shadow-blur: 40px;
            drop-shadow-offset-y: 14px;
            drop-shadow-color: Tema.intunecat ? #00000080 : #0f111559;
            gc := VerticalLayout {
                padding: 18px;
                spacing: 12px;
                HorizontalLayout {
                    Text { text: root.ghidat-titlu; font-family: Tema.font-ui; font-size: 13px; font-weight: 600; color: Tema.fundal; horizontal-stretch: 1; }
                    if !root.ghidat-terminat: Text { text: Texte.sus-jos; font-family: Tema.font-ui; font-size: 12px; color: Tema.fundal.transparentize(0.25); }
                }
                if !root.ghidat-terminat: Text { text: Texte.ce-pui-in-baza; font-family: Tema.font-ui; font-size: 15px; color: Tema.fundal; }
                if root.ghidat-terminat: Text { text: Texte.gata-diferentele; font-family: Tema.font-ui; font-size: 15px; color: Tema.fundal; }
                HorizontalLayout {
                    spacing: 6px;
                    for o[i] in (root.ghidat-terminat ? [] : [Texte.din-martor, Texte.din-modificata, Texte.editeaza]): Rectangle {
                        height: 34px;
                        width: ot.preferred-width + 24px;
                        border-radius: 9px;
                        background: (i == 0 && root.ghidat-din-sursa) || (i == 1 && !root.ghidat-din-sursa) ? Tema.fundal.transparentize(0.85) : transparent;
                        border-width: 1px;
                        border-color: Tema.fundal.transparentize(0.8);
                        ot := Text { text: o; font-family: Tema.font-ui; font-size: 13px; color: Tema.fundal; }
                        TouchArea {
                            clicked => {
                                if (i == 2) { root.porneste-editarea(); } else { root.ghidat-alege(i == 0); }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if !root.ghidat-terminat: Rectangle {
                        height: 34px;
                        width: gs.preferred-width + 24px;
                        border-radius: 9px;
                        gs := Text { text: Texte.sari-peste-esc; font-family: Tema.font-ui; font-size: 13px; color: Tema.fundal.transparentize(0.25); }
                        TouchArea { clicked => { root.ghidat-sari(); } }
                    }
                    Rectangle {
                        height: 34px;
                        width: ga.preferred-width + 28px;
                        border-radius: 9px;
                        background: Tema.accent;
                        ga := Text { text: root.ghidat-terminat ? Texte.inchide-enter : Texte.aplica-enter; font-family: Tema.font-ui; font-size: 13px; font-weight: 600; color: Tema.pe-accent; }
                        TouchArea { clicked => { if (root.ghidat-terminat) { root.ghidat-opreste(); } else { root.ghidat-aplica(); } } }
                    }
                }
            }
        }

        // „Copiaza": textul trece prin clipboard-ul sistemului, fara dependinta
        // noua (TextInput stie select-all / copy)
        clip-sursa := TextInput { x: 0; y: 0; width: 0px; height: 0px; opacity: 0; read-only: true; text: root.text-sursa; }
        clip-final := TextInput { x: 0; y: 0; width: 0px; height: 0px; opacity: 0; read-only: true; text: root.text-final; }
    }

    init => { taste.focus(); }
}
