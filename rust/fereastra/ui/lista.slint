// Ecranul principal: harta sus (fiecare obiect afisat e un patrat, pe tipuri),
// tabelul dedesubt, previzualizarea obiectului selectat in dreapta. Dupa
// schita aprobata (`cercetare/schita-slint/ui/lista.slint`), pe jetoanele
// din `Tema`. Harta e legata de tabel: patratul selectat e randul selectat.
//
// Se strica astfel: randul evidentiat nu e cel pe care il arata
// previzualizarea, sau un patrat de pe harta deschide alt obiect. Indicele
// selectat vine din `model_lista` (testat fara fereastra); asezarea si
// clicul pe harta, din `src/harta.rs`.

import { ListView } from "std-widgets.slint";
import { Tema, Buton, ButonPrincipal, Bifa, Antet, ButonTema, Card, Chevron, Jumatate, RandUi } from "comune.slint";

export struct RandListaUi {
    schema: string,
    nume: string,
    // numele tipului pentru utilizator („procedura")
    tip: string,
    litera: string,
    // 0 modificat, 1 doar in sursa, 2 doar in baza, 3 identic, 4 criptat
    stare: int,
    // „+48" / „−31"; goale cand nu se stiu inca
    plus: string,
    minus: string,
    difera-in: string,
    revizuit: bool,
    // pus in planul de deploy
    in-plan: bool,
    // omis: analizat, lasat in afara deploy-ului
    omis: bool,
    // similaritatea, 0..1; `scor-text` e gol cand obiectul n-are scor
    scor: float,
    scor-text: string,
    // 0 neintrodus, 1 pregatit (in plan), 2 trimis, 3 versiune noua, 4 omis
    deploy: int,
}

export struct CategorieUi {
    litera: string,
    nume: string,
    numar: string,
    stare: int,
}

export struct TipUi {
    nume: string,
    numar: string,
}

// Un grup de pe harta: titlul, pozitia, imaginea pictata in Rust si, pentru
// fiecare patrat (pe coloane), randul lui din tabel.
export struct GrupHartaUi {
    titlu: string,
    numar: string,
    x: length,
    y: length,
    latime: length,
    imagine: image,
    randuri: [int],
}

// Culoarea unei stari: M chihlimbar, S verde, B rosu, = / # gri.
global Stari {
    public pure function culoare(stare: int) -> color {
        return stare == 0 ? Tema.mod-text
             : stare == 1 ? Tema.add-text
             : stare == 2 ? Tema.del-text
             : Tema.text-secundar;
    }
    public pure function bara(stare: int) -> color {
        return stare == 0 ? Tema.mod-bara
             : stare == 1 ? Tema.add-bara
             : stare == 2 ? Tema.del-bara
             : stare == 3 ? Tema.ident
             : Tema.text-tert;
    }
}

// Latimile coloanelor tabelului, aceleasi in cap si pe randuri.
global Coloane {
    out property <length> stare: 34px;
    out property <length> tip: 92px;
    out property <length> linii: 84px;
    out property <length> scor: 118px;
    out property <length> difera: 124px;
    out property <length> revizuit: 62px;
    out property <length> deploy: 100px;
}

// Codurile coloanelor sortabile; aceeasi ordine ca `model_lista::Ordine`.
global Sortare {
    out property <int> nume: 0;
    out property <int> tip: 1;
    out property <int> linii: 2;
    out property <int> scor: 3;
    out property <int> difera: 4;
    out property <int> revizuit: 5;
    out property <int> deploy: 6;
}

// Un cap de coloana: clic = sorteaza; a doua oara, invers. Sageata arata
// sensul, ca in v3.4.
component CapColoana inherits Rectangle {
    in property <string> titlu;
    // 0 = stretch (coloana „Obiect")
    in property <length> latime;
    in property <bool> sortata;
    in property <bool> descrescator;
    callback apasat();
    // latime 0 = coloana care se intinde (Obiect); `width` ar strivi-o la zero
    min-width: root.latime;
    max-width: root.latime == 0px ? 100000px : root.latime;
    horizontal-stretch: root.latime == 0px ? 1 : 0;
    HorizontalLayout {
        spacing: 4px;
        alignment: start;
        Text {
            text: root.titlu;
            font-family: Tema.font-ui;
            font-size: 12px;
            font-weight: 600;
            color: root.sortata ? Tema.text : Tema.text-tert;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.sortata: Text {
            text: root.descrescator ? "↓" : "↑";
            font-family: Tema.font-mono;
            font-size: 12px;
            color: Tema.accent-text;
            vertical-alignment: center;
        }
    }
    TouchArea { clicked => { root.apasat(); } }
}

// Filtru cu meniu derulant (v3.4: „Stare"). `-1` = fara filtru.
component MeniuFiltru inherits Rectangle {
    in property <string> eticheta;
    in property <[string]> optiuni;
    in property <int> ales: -1;
    callback alege(int);
    height: 30px;
    width: rand.preferred-width + 22px;
    border-radius: 15px;
    border-width: 1px;
    border-color: root.ales >= 0 ? Tema.accent : Tema.linie;
    background: root.ales >= 0 || zona.has-hover ? Tema.strat : transparent;
    rand := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        Text {
            text: root.ales >= 0 ? root.optiuni[root.ales] : root.eticheta;
            font-family: Tema.font-ui;
            font-size: 12.5px;
            color: root.ales >= 0 ? Tema.text : Tema.text-secundar;
            vertical-alignment: center;
        }
        VerticalLayout { alignment: center; Chevron { drum: "M 3 6 L 8 11 L 13 6"; culoare: Tema.text-tert; } }
    }
    zona := TouchArea { clicked => { meniu.show(); } }
    meniu := PopupWindow {
        y: root.height + 6px;
        width: 190px;
        Rectangle {
            border-radius: 10px;
            border-width: 1px;
            border-color: Tema.linie;
            background: Tema.suprafata;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Tema.intunecat ? #00000080 : #0f111526;
            VerticalLayout {
                padding: 6px;
                Rectangle {
                    height: 30px;
                    border-radius: 7px;
                    background: zt.has-hover ? Tema.strat : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        Text { text: root.eticheta; font-family: Tema.font-ui; font-size: 13px; color: root.ales < 0 ? Tema.text : Tema.text-secundar; vertical-alignment: center; }
                    }
                    zt := TouchArea { clicked => { root.alege(-1); } }
                }
                for o[i] in root.optiuni: Rectangle {
                    height: 30px;
                    border-radius: 7px;
                    background: z.has-hover ? Tema.strat : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text { text: o; font-family: Tema.font-ui; font-size: 13px; color: Tema.text; vertical-alignment: center; horizontal-stretch: 1; }
                        if i == root.ales: VerticalLayout {
                            alignment: center;
                            Path {
                                width: 12px; height: 12px; viewbox-width: 16; viewbox-height: 16;
                                commands: "M 3 8.5 L 6 11.5 L 13 4.5"; stroke: Tema.accent-text; stroke-width: 2px; fill: transparent;
                            }
                        }
                    }
                    z := TouchArea { clicked => { root.alege(i); } }
                }
            }
        }
    }
}

// „Toate in plan", cu alegerea din v3.4: se includ si obiectele deja trimise
// la deploy, sau se sar.
component MeniuPlan inherits Rectangle {
    callback alege(bool /* cu deployate */);
    height: 30px;
    width: et.preferred-width + 22px;
    border-radius: 15px;
    border-width: 1px;
    border-color: Tema.linie;
    background: zona.has-hover ? Tema.strat : transparent;
    et := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        Text { text: "Toate in plan"; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; vertical-alignment: center; }
        VerticalLayout { alignment: center; Chevron { drum: "M 3 6 L 8 11 L 13 6"; culoare: Tema.text-tert; } }
    }
    zona := TouchArea { clicked => { meniu.show(); } }
    meniu := PopupWindow {
        y: root.height + 6px;
        width: 260px;
        Rectangle {
            border-radius: 10px;
            border-width: 1px;
            border-color: Tema.linie;
            background: Tema.suprafata;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Tema.intunecat ? #00000080 : #0f111526;
            VerticalLayout {
                padding: 6px;
                for o in [
                    { t: "Fara cele deja trimise la deploy", cu: false },
                    { t: "Include si ce a fost deja trimis", cu: true },
                ]: Rectangle {
                    height: 32px;
                    border-radius: 7px;
                    background: z.has-hover ? Tema.strat : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text { text: o.t; font-family: Tema.font-ui; font-size: 13px; color: Tema.text; vertical-alignment: center; }
                    }
                    z := TouchArea { clicked => { root.alege(o.cu); } }
                }
            }
        }
    }
}

// Un capat al intervalului de similaritate.
component CampProcent inherits Rectangle {
    in-out property <string> valoare;
    callback schimbat(string);
    width: 38px;
    height: 22px;
    border-radius: 6px;
    background: Tema.strat;
    camp := TextInput {
        text <=> root.valoare;
        font-family: Tema.font-mono;
        font-size: 12px;
        color: Tema.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        single-line: true;
        input-type: number;
        edited => { root.schimbat(self.text); }
    }
}

component RandTabel inherits Rectangle {
    in property <RandListaUi> r;
    in property <bool> selectat;
    callback apasat();
    callback comuta-revizuit();
    height: 34px;
    border-radius: 8px;
    background: root.selectat ? Tema.strat : zona.has-hover ? Tema.suprafata : transparent;
    zona := TouchArea { clicked => { root.apasat(); } }
    if root.selectat: Rectangle { x: 0; width: 3px; height: 20px; border-radius: 1.5px; background: Tema.accent; }
    // in plan: o crestatura pe marginea din dreapta
    if root.r.in-plan: Rectangle { x: parent.width - 4px; width: 4px; height: 22px; border-radius: 2px; background: Tema.accent; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        // starea: patratul de pe harta, cu litera alaturi
        HorizontalLayout {
            width: Coloane.stare;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 2.5px;
                    background: Stari.bara(root.r.stare);
                    opacity: root.r.revizuit ? 0.4 : 1;
                }
            }
            Text { text: root.r.litera; font-family: Tema.font-mono; font-size: 12px; font-weight: 500; color: Stari.culoare(root.r.stare); vertical-alignment: center; }
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: start;
            Text { text: root.r.schema + "."; font-family: Tema.font-mono; font-size: 12.5px; color: Tema.text-tert; vertical-alignment: center; }
            Text { text: root.r.nume; font-family: Tema.font-mono; font-size: 12.5px; color: root.r.revizuit ? Tema.text-secundar : Tema.text; vertical-alignment: center; overflow: elide; }
        }
        Text { width: Coloane.tip; text: root.r.tip; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; vertical-alignment: center; }
        HorizontalLayout {
            width: Coloane.linii;
            spacing: 8px;
            Text { text: root.r.plus; font-family: Tema.font-mono; font-size: 12px; color: Tema.add-text; vertical-alignment: center; }
            Text { text: root.r.minus; font-family: Tema.font-mono; font-size: 12px; color: Tema.del-text; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
        }
        // similaritatea: bara + procent; gol pentru obiectele fara scor
        HorizontalLayout {
            width: Coloane.scor;
            spacing: 8px;
            padding-right: 12px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: Tema.ident;
                    Rectangle {
                        x: 0;
                        width: parent.width * root.r.scor;
                        border-radius: 2px;
                        background: Stari.bara(root.r.stare);
                    }
                }
            }
            Text { width: 38px; text: root.r.scor-text; font-family: Tema.font-mono; font-size: 12px; color: Tema.text; horizontal-alignment: right; vertical-alignment: center; }
        }
        Text { width: Coloane.difera; text: root.r.difera-in; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; vertical-alignment: center; overflow: elide; }
        HorizontalLayout {
            width: Coloane.revizuit;
            alignment: center;
            VerticalLayout {
                alignment: center;
                Bifa {
                    text: "";
                    bifat: root.r.revizuit;
                    schimbat => { root.comuta-revizuit(); }
                }
            }
        }
        Text {
            width: Coloane.deploy;
            text: root.r.deploy == 1 ? "Pregatit" : root.r.deploy == 2 ? "Trimis" : root.r.deploy == 3 ? "Versiune noua" : root.r.deploy == 4 ? "Omis" : "Neintrodus";
            color: root.r.deploy == 1 ? Tema.accent-text : root.r.deploy == 2 ? Tema.add-text : root.r.deploy == 3 ? Tema.mod-text : Tema.text-tert;
            font-family: Tema.font-ui;
            font-size: 12.5px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Un filtru: eticheta cu numar; activ = conturat in chihlimbar.
component Filtru inherits Rectangle {
    in property <string> text;
    in property <string> numar;
    in property <color> culoare-numar: Tema.text-secundar;
    in property <bool> activ;
    callback apasat();
    height: 30px;
    width: rand.preferred-width + 22px;
    border-radius: 15px;
    border-width: 1px;
    border-color: root.activ ? Tema.accent : Tema.linie;
    background: root.activ ? Tema.strat : zona.has-hover ? Tema.strat : transparent;
    rand := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        Text { text: root.numar; font-family: Tema.font-mono; font-size: 12px; font-weight: 500; color: root.culoare-numar; vertical-alignment: center; }
        Text { text: root.text; font-family: Tema.font-ui; font-size: 12.5px; color: root.activ ? Tema.text : Tema.text-secundar; vertical-alignment: center; }
    }
    zona := TouchArea { clicked => { root.apasat(); } }
}

export component FereastraLista inherits Window {
    title: "gmotion";
    preferred-width: 1440px;
    preferred-height: 900px;
    background: Tema.fundal;
    default-font-family: Tema.font-ui;
    default-font-size: 13px;

    in property <string> sursa-baza;
    in property <string> tinta-baza;
    in property <string> servere;          // „srv-dev → srv-prod · comparat la 14:32"
    in property <string> eticheta-mediu;
    in property <int> mediu: 0;
    in-out property <string> cautare;
    in property <string> numar-deploy;

    in property <string> progres-revizuite;   // „124/336"
    in property <float> progres-fractie;      // 0..1
    in property <[CategorieUi]> categorii;
    in property <[TipUi]> tipuri;
    in property <int> categorie-activa: -1;   // indice in `categorii`, -1 = toate
    in property <int> tip-activ: -1;

    in property <string> rezumat-lista;       // „212 nerevizuite din 312"
    // coloana sortata (`Sortare`) si sensul ei
    in property <int> coloana-sortata;
    in property <bool> sens-descrescator;
    // filtrul pe stare: indice in `stari`, -1 = toate
    in property <[string]> stari;
    in property <int> stare-activa: -1;
    in-out property <string> scor-min: "0";
    in-out property <string> scor-max: "100";
    in property <string> progres-deployate;   // „8/336"
    // unde s-a scris ultimul CSV, sau de ce n-a mers
    in property <string> mesaj-csv;
    in property <float> progres-deploy;       // 0..1
    in property <[RandListaUi]> randuri;
    in-out property <int> selectat: 0;

    // harta: grupurile asezate in Rust (`src/harta.rs`) si patratul selectat
    in property <[GrupHartaUi]> harta;
    in property <length> harta-inaltime;
    in property <length> sel-x;
    in property <length> sel-y;
    in property <bool> sel-pe-harta;

    in property <string> obiect-schema;
    in property <string> obiect-nume;
    in property <string> ce-difera;           // „un singur caracter, intr-un sir: Nu → nu"
    in property <bool> obiect-revizuit;
    in property <bool> obiect-in-plan;
    in property <[RandUi]> previzualizare;
    in property <image> tigla-hasura;

    callback recompara();
    callback deschide-deploy();
    callback alege-categoria(int);
    callback alege-tipul(int);
    callback alege-randul(int);
    callback comuta-revizuit(int);
    callback deschide-obiectul();
    callback adauga-in-plan();
    callback cauta(string);
    callback sorteaza-coloana(int);
    callback alege-starea(int);
    callback schimba-scorul(string, string);
    callback exporta-csv();
    callback pune-vizibilele-in-plan(bool);
    callback alege-tema(bool);

    // bula de pe harta: numele patratului de sub mouse, pusa din Rust
    in-out property <string> bula;
    in-out property <length> bula-x;
    in-out property <length> bula-y;
    callback peste-harta(int, length, length);
    callback clic-harta(int, length, length);

    public function muta-selectia(pas: int) {
        if (root.randuri.length == 0) { return; }
        root.selectat = Math.max(0, Math.min(root.randuri.length - 1, root.selectat + pas));
        root.alege-randul(root.selectat);
        tabel.content-y = -Math.max(0, root.selectat - 6) * 34px;
    }

    taste := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.DownArrow || e.text == "j") { root.muta-selectia(1); return accept; }
            if (e.text == Key.UpArrow || e.text == "k") { root.muta-selectia(-1); return accept; }
            if (e.text == Key.Return) { root.deschide-obiectul(); return accept; }
            if (e.text == "r") { root.comuta-revizuit(root.selectat); return accept; }
            if (e.text == "i") { root.adauga-in-plan(); return accept; }
            // Ctrl+F: cursorul in cautare, ca in v3.4
            if (e.text == "f" && e.modifiers.control) { camp.focus(); return accept; }
            return reject;
        }

        VerticalLayout {
            // ---- antetul: drumul, contoarele pe stari (filtreaza), progresul
            Antet {
                sursa: root.sursa-baza;
                tinta: root.tinta-baza;
                mediu: root.mediu;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    for c[i] in root.categorii: VerticalLayout {
                        alignment: center;
                        Filtru {
                            text: c.nume;
                            numar: c.numar;
                            culoare-numar: Stari.culoare(c.stare);
                            activ: root.categorie-activa == i;
                            apasat => { root.alege-categoria(root.categorie-activa == i ? -1 : i); }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 5px;
                    width: 130px;
                    HorizontalLayout {
                        Text { text: root.progres-revizuite; font-family: Tema.font-mono; font-size: 12px; color: Tema.text; }
                        Text { text: "revizuite"; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-secundar; horizontal-alignment: right; horizontal-stretch: 1; }
                    }
                    Rectangle {
                        height: 3px;
                        border-radius: 1.5px;
                        background: Tema.strat;
                        Rectangle { x: 0; width: parent.width * Math.max(0.02, root.progres-fractie); border-radius: 1.5px; background: Tema.add-bara; }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 5px;
                    width: 110px;
                    HorizontalLayout {
                        Text { text: root.progres-deployate; font-family: Tema.font-mono; font-size: 12px; color: Tema.text; }
                        Text { text: "deploy"; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-secundar; horizontal-alignment: right; horizontal-stretch: 1; }
                    }
                    Rectangle {
                        height: 3px;
                        border-radius: 1.5px;
                        background: Tema.strat;
                        Rectangle { x: 0; width: parent.width * Math.max(0.02, root.progres-deploy); border-radius: 1.5px; background: Tema.accent; }
                    }
                }
                VerticalLayout { alignment: center; Buton { text: "Recompara"; apasat => { root.recompara(); } } }
                VerticalLayout { alignment: center; ButonTema { alege(i) => { root.alege-tema(i); } } }
            }

            // ---- cautarea, tipurile, deploy-ul
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 10px;
                spacing: 8px;
                Rectangle {
                    width: 320px;
                    height: 34px;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: camp.has-focus ? Tema.accent : Tema.linie;
                    background: Tema.suprafata;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        Path {
                            width: 14px; height: 14px; y: (parent.height - 14px) / 2; viewbox-width: 14; viewbox-height: 14;
                            commands: "M 6 1.5 A 4.5 4.5 0 1 1 5.99 1.5 M 9.3 9.3 L 12.5 12.5";
                            stroke: Tema.text-tert; stroke-width: 1.5px; fill: transparent;
                        }
                        camp := TextInput {
                            text <=> root.cautare;
                            font-family: Tema.font-ui;
                            font-size: 13px;
                            color: Tema.text;
                            vertical-alignment: center;
                            single-line: true;
                            edited => { root.cauta(self.text); }
                        }
                    }
                    if root.cautare == "" && !camp.has-focus: Text {
                        x: 34px;
                        text: "Cauta obiect";
                        font-family: Tema.font-ui;
                        font-size: 13px;
                        color: Tema.text-tert;
                        vertical-alignment: center;
                    }
                }
                for t[i] in root.tipuri: VerticalLayout {
                    alignment: center;
                    Filtru {
                        text: t.nume;
                        numar: t.numar;
                        activ: root.tip-activ == i;
                        apasat => { root.alege-tipul(root.tip-activ == i ? -1 : i); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    MeniuFiltru {
                        eticheta: "Toate starile";
                        optiuni: root.stari;
                        ales: root.stare-activa;
                        alege(i) => { root.alege-starea(i); }
                    }
                }
                // intervalul de similaritate (v3.4: min–max %)
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 30px;
                        width: sm.preferred-width + 22px;
                        border-radius: 15px;
                        border-width: 1px;
                        border-color: root.scor-min != "0" || root.scor-max != "100" ? Tema.accent : Tema.linie;
                        background: Tema.suprafata;
                        sm := HorizontalLayout {
                            padding-left: 11px;
                            padding-right: 11px;
                            spacing: 6px;
                            Text { text: "Similar"; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; vertical-alignment: center; }
                            VerticalLayout {
                                alignment: center;
                                CampProcent {
                                    valoare <=> root.scor-min;
                                    schimbat(v) => { root.schimba-scorul(v, root.scor-max); }
                                }
                            }
                            Text { text: "–"; font-family: Tema.font-mono; font-size: 12px; color: Tema.text-tert; vertical-alignment: center; }
                            VerticalLayout {
                                alignment: center;
                                CampProcent {
                                    valoare <=> root.scor-max;
                                    schimbat(v) => { root.schimba-scorul(root.scor-min, v); }
                                }
                            }
                            Text { text: "%"; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-tert; vertical-alignment: center; }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    MeniuPlan { alege(cu) => { root.pune-vizibilele-in-plan(cu); } }
                }
                VerticalLayout { alignment: center; Buton { text: "Export CSV"; apasat => { root.exporta-csv(); } } }
                if root.mesaj-csv != "": VerticalLayout {
                    alignment: center;
                    Text { text: root.mesaj-csv; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-secundar; overflow: elide; }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    ButonPrincipal {
                        text: "Deploy (" + root.numar-deploy + ")";
                        apasat => { root.deschide-deploy(); }
                    }
                }
            }

            // ---- harta: ansamblul obiectelor afisate, pe tipuri
            if root.harta.length > 0: Rectangle {
                height: Math.min(root.harta-inaltime, 160px) + 28px;
                Rectangle {
                    x: 16px;
                    width: parent.width - 32px;
                    border-radius: 14px;
                    background: Tema.suprafata;
                    border-width: 1px;
                    border-color: Tema.linie;
                    clip: true;
                    Flickable {
                        x: 18px;
                        y: 14px;
                        width: parent.width - 36px;
                        height: parent.height - 28px;
                        content-height: root.harta-inaltime;
                        for g[gi] in root.harta: Rectangle {
                            x: g.x;
                            y: g.y;
                            width: g.latime;
                            height: 20px + img.height;
                            HorizontalLayout {
                                y: 0;
                                height: 16px;
                                spacing: 6px;
                                Text { text: g.titlu; font-family: Tema.font-ui; font-size: 12px; font-weight: 600; color: Tema.text-secundar; overflow: elide; }
                                Text { text: g.numar; font-family: Tema.font-mono; font-size: 11.5px; color: Tema.text-tert; horizontal-alignment: right; horizontal-stretch: 1; }
                            }
                            img := Image {
                                x: 0;
                                y: 20px;
                                source: g.imagine;
                                image-rendering: pixelated;
                            }
                            TouchArea {
                                x: img.x;
                                y: img.y;
                                width: img.width;
                                height: img.height;
                                // ce patrat e sub mouse se decide in Rust (`harta::indice_la`)
                                moved => { root.peste-harta(gi, self.mouse-x, self.mouse-y); }
                                changed has-hover => { if (!self.has-hover) { root.bula = ""; } }
                                clicked => { root.clic-harta(gi, self.mouse-x, self.mouse-y); }
                            }
                        }
                        // conturul patratului selectat
                        if root.sel-pe-harta: Rectangle {
                            x: root.sel-x - 3px;
                            y: root.sel-y - 3px;
                            width: 18px;
                            height: 18px;
                            border-radius: 5px;
                            border-width: 2px;
                            border-color: Tema.text;
                        }
                    }
                }
            }

            // ---- tabelul si previzualizarea
            HorizontalLayout {
                vertical-stretch: 1;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                spacing: 16px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    // capul tabelului
                    Rectangle {
                        height: 30px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text { width: Coloane.stare; text: ""; }
                            CapColoana {
                                titlu: "Obiect  " + root.rezumat-lista;
                                latime: 0px;
                                sortata: root.coloana-sortata == Sortare.nume;
                                descrescator: root.sens-descrescator;
                                apasat => { root.sorteaza-coloana(Sortare.nume); }
                            }
                            CapColoana {
                                titlu: "Tip";
                                latime: Coloane.tip;
                                sortata: root.coloana-sortata == Sortare.tip;
                                descrescator: root.sens-descrescator;
                                apasat => { root.sorteaza-coloana(Sortare.tip); }
                            }
                            CapColoana {
                                titlu: "Linii";
                                latime: Coloane.linii;
                                sortata: root.coloana-sortata == Sortare.linii;
                                descrescator: root.sens-descrescator;
                                apasat => { root.sorteaza-coloana(Sortare.linii); }
                            }
                            CapColoana {
                                titlu: "Similar";
                                latime: Coloane.scor;
                                sortata: root.coloana-sortata == Sortare.scor;
                                descrescator: root.sens-descrescator;
                                apasat => { root.sorteaza-coloana(Sortare.scor); }
                            }
                            CapColoana {
                                titlu: "Difera in";
                                latime: Coloane.difera;
                                sortata: root.coloana-sortata == Sortare.difera;
                                descrescator: root.sens-descrescator;
                                apasat => { root.sorteaza-coloana(Sortare.difera); }
                            }
                            CapColoana {
                                titlu: "Revizuit";
                                latime: Coloane.revizuit;
                                sortata: root.coloana-sortata == Sortare.revizuit;
                                descrescator: root.sens-descrescator;
                                apasat => { root.sorteaza-coloana(Sortare.revizuit); }
                            }
                            CapColoana {
                                titlu: "Deploy";
                                latime: Coloane.deploy;
                                sortata: root.coloana-sortata == Sortare.deploy;
                                descrescator: root.sens-descrescator;
                                apasat => { root.sorteaza-coloana(Sortare.deploy); }
                            }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Tema.linie; }
                    }
                    tabel := ListView {
                        vertical-stretch: 1;
                        for r[i] in root.randuri: RandTabel {
                            r: r;
                            selectat: i == root.selectat;
                            apasat => {
                                root.selectat = i;
                                root.alege-randul(i);
                                taste.focus();
                            }
                            comuta-revizuit => { root.comuta-revizuit(i); }
                        }
                    }
                    if root.randuri.length == 0: Text {
                        text: "Niciun obiect nu se potriveste. Sterge cautarea sau alege alt filtru.";
                        font-family: Tema.font-ui;
                        font-size: 13px;
                        color: Tema.text-secundar;
                        horizontal-alignment: center;
                    }
                }

                // previzualizarea obiectului selectat
                Card {
                    width: 460px;
                    clip: true;
                    VerticalLayout {
                        VerticalLayout {
                            padding: 18px;
                            padding-bottom: 12px;
                            spacing: 6px;
                            HorizontalLayout {
                                alignment: start;
                                Text { text: root.obiect-schema == "" ? "" : root.obiect-schema + "."; font-family: Tema.font-mono; font-size: 17px; color: Tema.text-tert; }
                                Text { text: root.obiect-nume; font-family: Tema.font-mono; font-size: 17px; font-weight: 500; color: Tema.text; overflow: elide; horizontal-stretch: 1; }
                            }
                            Text { text: root.ce-difera; font-family: Tema.font-ui; font-size: 13px; color: Tema.text-secundar; wrap: word-wrap; }
                            HorizontalLayout {
                                padding-top: 6px;
                                spacing: 8px;
                                alignment: start;
                                Buton {
                                    text: root.obiect-revizuit ? "Revizuit ✓" : "Revizuit";
                                    apasat => { root.comuta-revizuit(root.selectat); }
                                }
                                Buton { text: root.obiect-in-plan ? "In plan ✓" : "In plan"; apasat => { root.adauga-in-plan(); } }
                                ButonPrincipal { text: "Deschide"; apasat => { root.deschide-obiectul(); } }
                            }
                        }
                        Rectangle { height: 1px; background: Tema.linie; }
                        Rectangle {
                            vertical-stretch: 1;
                            background: Tema.cod-fundal;
                            previz := ListView {
                                for r in root.previzualizare: Rectangle {
                                    height: 20px;
                                    if r.fel == 1: Rectangle {
                                        background: Tema.fundal;
                                        Text {
                                            x: 47px;
                                            text: r.pliere;
                                            font-family: Tema.font-ui;
                                            font-size: 11.5px;
                                            color: Tema.text-secundar;
                                            vertical-alignment: center;
                                            height: parent.height;
                                        }
                                    }
                                    if r.fel == 0: Rectangle {
                                        Jumatate {
                                            x: 0px;
                                            width: parent.width / 2;
                                            nr: r.st-nr;
                                            bucati: r.st;
                                            stare: r.stare;
                                            fara-linie: r.st-nr == "";
                                            margine: true;
                                            tigla: root.tigla-hasura;
                                        }
                                        Jumatate {
                                            x: parent.width / 2;
                                            width: parent.width / 2;
                                            nr: r.dr-nr;
                                            bucati: r.dr;
                                            stare: r.stare;
                                            fara-linie: r.dr-nr == "";
                                            tigla: root.tigla-hasura;
                                        }
                                    }
                                }
                            }
                            if root.previzualizare.length > 0: Rectangle {
                                x: previz.visible-width / 2;
                                width: 1px;
                                background: Tema.linie;
                            }
                            if root.previzualizare.length == 0: Text {
                                x: 18px;
                                y: 14px;
                                text: "Alege un obiect ca sa vezi diferenta.";
                                font-family: Tema.font-ui;
                                font-size: 12.5px;
                                color: Tema.text-secundar;
                            }
                        }
                    }
                }
            }

            // ---- subsolul: scurtaturile si serverele
            Rectangle {
                height: 30px;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 18px;
                    for k in [{ t: "j k", e: "obiect" }, { t: "enter", e: "deschide" }, { t: "r", e: "revizuit" }, { t: "i", e: "in plan" }, { t: "ctrl f", e: "cauta" }]: HorizontalLayout {
                        spacing: 6px;
                        Text { text: k.t; font-family: Tema.font-mono; font-size: 11.5px; color: Tema.text; vertical-alignment: center; }
                        Text { text: k.e; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-tert; vertical-alignment: center; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.servere; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-tert; vertical-alignment: center; }
                }
            }
        }

        if root.bula != "": Rectangle {
            x: root.bula-x + 14px;
            y: root.bula-y + 14px;
            width: bt.preferred-width + 20px;
            height: 26px;
            border-radius: 6px;
            background: Tema.text;
            bt := Text { text: root.bula; font-family: Tema.font-mono; font-size: 12px; font-weight: 500; color: Tema.fundal; }
        }
    }

    init => { taste.focus(); }
}
