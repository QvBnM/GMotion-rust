// Ecranul listei: tabelul obiectelor; la clic pe un rand, detaliile lui in
// dreapta (panou redimensionabil, inchis cu X, Esc sau al doilea clic pe
// rand). Harta (`h`) e un ecran separat, peste lista. Arborele ca Object
// Explorer sta in coloana din stanga a editorului, nu aici (Mihai,
// 2026-11-19: „pe ecranul lista ramane cum era inainte").
//
// Se strica astfel: randul evidentiat nu e cel pe care il arata
// previzualizarea, sau un patrat de pe harta deschide alt obiect. Indicele
// selectat vine din `model_lista` (testat fara fereastra); asezarea si
// clicul pe harta, din `src/harta.rs`.

import { ListView } from "std-widgets.slint";
import { Texte, Tema, ButonLimba, Buton, ButonPrincipal, Bifa, Antet, ButonTema, Card, Semn, Chevron, Jumatate, RandUi, Ajutor, CampText } from "comune.slint";

export struct RandListaUi {
    // coloana din editor (etapa 16): un rand cu `antet` nevid e capul unui
    // grup de stare; `pozitie` e pozitia randului in lista vizibila
    antet: string,
    pozitie: int,
    // numele taiat pe mijloc, pe latimea coloanei (`taie_pe_mijloc`)
    nume-scurt: string,
    schema: string,
    nume: string,
    // baza comparata in care s-a gasit obiectul
    baza: string,
    // numele tipului pentru utilizator („procedura")
    tip: string,
    litera: string,
    // 0 modificat, 1 doar in sursa, 2 doar in baza, 3 identic, 4 criptat
    stare: int,
    // „+48" / „−31"; goale cand nu se stiu inca
    plus: string,
    minus: string,
    difera-in: string,
    revizuit: bool,
    // pus in planul de deploy
    in-plan: bool,
    // omis: analizat, lasat in afara deploy-ului
    omis: bool,
    // similaritatea, 0..1; `scor-text` e gol cand obiectul n-are scor
    scor: float,
    scor-text: string,
    // 0 neintrodus, 1 pregatit (in plan), 2 trimis, 3 versiune noua, 4 omis
    deploy: int,
    // cate obiecte din Modificata il folosesc („" = nu se stie)
    folosit-de: string,
    // impactul deploy-ului: 0 scazut, 1 mediu, 2 ridicat, -1 fara (identic)
    impact: int,
}

export struct CategorieUi {
    litera: string,
    nume: string,
    numar: string,
    stare: int,
}

export struct TipUi {
    nume: string,
    numar: string,
}

// Un grup de pe harta: titlul, pozitia, imaginea pictata in Rust, cate
// patrate are pe rand si, pentru fiecare patrat (pe randuri), randul lui din tabel.
export struct GrupHartaUi {
    titlu: string,
    numar: string,
    x: length,
    y: length,
    latime: length,
    inaltime: length,
    desparte: bool,
    coloane: int,
    imagine: image,
    bara: image,
    randuri: [int],
}

// Culoarea unei stari: M chihlimbar, S verde, B rosu, = / # gri.
export global Stari {
    public pure function culoare(stare: int) -> color {
        return stare == 0 ? Tema.mod-text
             : stare == 1 ? Tema.add-text
             : stare == 2 ? Tema.del-text
             : Tema.text-secundar;
    }
    // patratul de pe harta (si punctul din bula lui)
    public pure function harta(stare: int) -> color {
        return stare == 0 ? Tema.harta-mod
             : stare == 1 ? Tema.harta-add
             : stare == 2 ? Tema.harta-del
             : stare == 3 ? Tema.harta-gol
             : Tema.text-tert;
    }
    public pure function bara(stare: int) -> color {
        return stare == 0 ? Tema.mod-bara
             : stare == 1 ? Tema.add-bara
             : stare == 2 ? Tema.del-bara
             : stare == 3 ? Tema.ident
             : Tema.text-tert;
    }
}


// Latimile coloanelor tabelului, aceleasi in cap si pe randuri.
// Latimile coloanelor. `in-out`, fiindca marginea capului de coloana le
// trage; dublu clic pune latimea ceruta de continut (calculata in Rust).
export global Coloane {
    in-out property <length> stare: 34px;
    in-out property <length> baza: 152px;
    in-out property <length> tip: 84px;
    in-out property <length> linii: 84px;
    in-out property <length> scor: 118px;
    in-out property <length> difera: 124px;
    in-out property <length> revizuit: 62px;
    // incape „Extra · fara deploy"; varianta lunga, din v3.4, sta in panou
    in-out property <length> deploy: 130px;
    in-out property <length> folosit: 76px;
    in-out property <length> impact: 72px;
    /// Sub atat o coloana nu mai are ce arata.
    out property <length> minim: 48px;

    public function pune(coloana: int, latime: length) {
        if (coloana == Sortare.baza) { root.baza = Math.max(root.minim, latime); }
        if (coloana == Sortare.tip) { root.tip = Math.max(root.minim, latime); }
        if (coloana == Sortare.linii) { root.linii = Math.max(root.minim, latime); }
        if (coloana == Sortare.scor) { root.scor = Math.max(root.minim, latime); }
        if (coloana == Sortare.difera) { root.difera = Math.max(root.minim, latime); }
        if (coloana == Sortare.revizuit) { root.revizuit = Math.max(root.minim, latime); }
        if (coloana == Sortare.deploy) { root.deploy = Math.max(root.minim, latime); }
        if (coloana == Sortare.folosit) { root.folosit = Math.max(root.minim, latime); }
        if (coloana == Sortare.impact) { root.impact = Math.max(root.minim, latime); }
    }

    public pure function ia(coloana: int) -> length {
        return coloana == Sortare.baza ? root.baza
             : coloana == Sortare.tip ? root.tip
             : coloana == Sortare.linii ? root.linii
             : coloana == Sortare.scor ? root.scor
             : coloana == Sortare.difera ? root.difera
             : coloana == Sortare.revizuit ? root.revizuit
             : coloana == Sortare.deploy ? root.deploy
             : coloana == Sortare.folosit ? root.folosit
             : coloana == Sortare.impact ? root.impact
             : 0px;
    }
}

// Codurile coloanelor sortabile; aceeasi ordine ca `model_lista::Ordine`.
global Sortare {
    out property <int> nume: 0;
    out property <int> tip: 1;
    out property <int> linii: 2;
    out property <int> scor: 3;
    out property <int> difera: 4;
    out property <int> revizuit: 5;
    out property <int> deploy: 6;
    out property <int> baza: 7;
    out property <int> folosit: 8;
    out property <int> impact: 9;
}


// Un cap de coloana: clic = sorteaza; a doua oara, invers. Sageata arata
// sensul, ca in v3.4.
component CapColoana inherits Rectangle {
    in property <string> titlu;
    /// Codul coloanei (`Sortare`), pentru tragere si autofit.
    in property <int> coloana;
    /// Fiecare clic pe margine; dublul clic (autofit) il numara Rust-ul.
    callback clic-margine();
    // 0 = stretch (coloana „Obiect")
    in property <length> latime;
    in property <bool> sortata;
    in property <bool> descrescator;
    callback apasat();
    // latime 0 = coloana care se intinde (Obiect); `width` ar strivi-o la zero
    min-width: root.latime;
    max-width: root.latime == 0px ? 100000px : root.latime;
    horizontal-stretch: root.latime == 0px ? 1 : 0;
    HorizontalLayout {
        spacing: 4px;
        alignment: start;
        Text {
            text: root.titlu;
            font-family: Tema.font-ui;
            font-size: 12px;
            font-weight: 600;
            color: root.sortata ? Tema.text : Tema.text-tert;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.sortata: Text {
            text: root.descrescator ? "↓" : "↑";
            font-family: Tema.font-mono;
            font-size: 12px;
            color: Tema.accent-text;
            vertical-alignment: center;
        }
        // coloana care se intinde isi tine titlul la stanga, nu lipit de
        // capul urmator
        Rectangle { horizontal-stretch: 1; }
    }
    TouchArea { clicked => { root.apasat(); } }
    // marginea din dreapta: trasa, schimba latimea; dublu clic o potriveste
    // dupa continut (autofit, calculat in Rust; tot Rust-ul numara dublul
    // clic, vezi `dublu_clic.rs`)
    if root.latime > 0px: Rectangle {
        x: parent.width - 3px;
        width: 7px;
        height: parent.height;
        background: tragere.has-hover || tragere.pressed ? Tema.linie : transparent;
        tragere := TouchArea {
            mouse-cursor: col-resize;
            moved => {
                if (self.pressed) {
                    Coloane.pune(root.coloana, root.latime + (self.mouse-x - self.pressed-x));
                }
            }
            clicked => { root.clic-margine(); }
        }
    }
}


// Filtru cu meniu derulant (v3.4: „Stare"). `-1` = fara filtru.
component MeniuFiltru inherits Rectangle {
    in property <string> eticheta;
    in property <[string]> optiuni;
    in property <int> ales: -1;
    callback alege(int);
    height: 30px;
    width: rand.preferred-width + 22px;
    border-radius: 15px;
    border-width: 1px;
    border-color: root.ales >= 0 ? Tema.accent : Tema.linie;
    background: root.ales >= 0 || zona.has-hover ? Tema.strat : transparent;
    rand := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        Text {
            text: root.ales >= 0 ? root.optiuni[root.ales] : root.eticheta;
            font-family: Tema.font-ui;
            font-size: 12.5px;
            color: root.ales >= 0 ? Tema.text : Tema.text-secundar;
            vertical-alignment: center;
        }
        VerticalLayout { alignment: center; Chevron { drum: "M 3 6 L 8 11 L 13 6"; culoare: Tema.text-tert; } }
    }
    zona := TouchArea { clicked => { meniu.show(); } }
    meniu := PopupWindow {
        y: root.height + 6px;
        width: 190px;
        Rectangle {
            border-radius: 10px;
            border-width: 1px;
            border-color: Tema.linie;
            background: Tema.suprafata;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Tema.intunecat ? #00000080 : #0f111526;
            VerticalLayout {
                padding: 6px;
                Rectangle {
                    height: 30px;
                    border-radius: 7px;
                    background: zt.has-hover ? Tema.strat : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        Text { text: root.eticheta; font-family: Tema.font-ui; font-size: 13px; color: root.ales < 0 ? Tema.text : Tema.text-secundar; vertical-alignment: center; }
                    }
                    zt := TouchArea { clicked => { root.alege(-1); } }
                }
                for o[i] in root.optiuni: Rectangle {
                    height: 30px;
                    border-radius: 7px;
                    background: z.has-hover ? Tema.strat : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text { text: o; font-family: Tema.font-ui; font-size: 13px; color: Tema.text; vertical-alignment: center; horizontal-stretch: 1; }
                        if i == root.ales: VerticalLayout {
                            alignment: center;
                            Path {
                                width: 12px; height: 12px; viewbox-width: 16; viewbox-height: 16;
                                commands: "M 3 8.5 L 6 11.5 L 13 4.5"; stroke: Tema.accent-text; stroke-width: 2px; fill: transparent;
                            }
                        }
                    }
                    z := TouchArea { clicked => { root.alege(i); } }
                }
            }
        }
    }
}

// „Toate in plan", cu alegerea din v3.4: se includ si obiectele deja trimise
// la deploy, sau se sar.
component MeniuPlan inherits Rectangle {
    callback alege(bool /* cu deployate */);
    height: 30px;
    width: et.preferred-width + 22px;
    border-radius: 15px;
    border-width: 1px;
    border-color: Tema.linie;
    background: zona.has-hover ? Tema.strat : transparent;
    et := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        Text { text: Texte.toate-in-plan; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; vertical-alignment: center; }
        VerticalLayout { alignment: center; Chevron { drum: "M 3 6 L 8 11 L 13 6"; culoare: Tema.text-tert; } }
    }
    zona := TouchArea { clicked => { meniu.show(); } }
    meniu := PopupWindow {
        y: root.height + 6px;
        width: 260px;
        Rectangle {
            border-radius: 10px;
            border-width: 1px;
            border-color: Tema.linie;
            background: Tema.suprafata;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Tema.intunecat ? #00000080 : #0f111526;
            VerticalLayout {
                padding: 6px;
                for o in [
                    { t: Texte.fara-deployate, cu: false },
                    { t: Texte.include-deployate, cu: true },
                ]: Rectangle {
                    height: 32px;
                    border-radius: 7px;
                    background: z.has-hover ? Tema.strat : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text { text: o.t; font-family: Tema.font-ui; font-size: 13px; color: Tema.text; vertical-alignment: center; }
                    }
                    z := TouchArea { clicked => { root.alege(o.cu); } }
                }
            }
        }
    }
}

// Un capat al intervalului de similaritate.
component CampProcent inherits Rectangle {
    in-out property <string> valoare;
    callback schimbat(string);
    width: 38px;
    height: 22px;
    border-radius: 6px;
    background: Tema.strat;
    camp := TextInput {
        text <=> root.valoare;
        font-family: Tema.font-mono;
        font-size: 12px;
        color: Tema.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        single-line: true;
        input-type: number;
        edited => { root.schimbat(self.text); }
    }
}


component RandTabel inherits Rectangle {
    in property <RandListaUi> r;
    in property <bool> selectat;
    // coloana Baza apare doar cand chiar sunt mai multe baze comparate
    in property <bool> cu-baza;
    /// Fiecare clic; dublul clic (Deschide) il numara Rust-ul, din
    /// `clic-rand`: `double-clicked` din Slint nu ajungea pe Windows.
    callback apasat();
    callback comuta-revizuit();
    height: 34px;
    border-radius: 8px;
    background: root.selectat ? Tema.strat : zona.has-hover ? Tema.suprafata : transparent;
    zona := TouchArea {
        clicked => { root.apasat(); }
    }
    if root.selectat: Rectangle { x: 0; width: 3px; height: 20px; border-radius: 1.5px; background: Tema.accent; }
    // in plan: o crestatura pe marginea din dreapta
    if root.r.in-plan: Rectangle { x: parent.width - 4px; width: 4px; height: 22px; border-radius: 2px; background: Tema.accent; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        // starea: patratul de pe harta, cu litera alaturi
        HorizontalLayout {
            width: Coloane.stare;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 2.5px;
                    background: Stari.harta(root.r.stare);
                    opacity: root.r.revizuit ? 0.4 : 1;
                }
            }
            Text { text: root.r.litera; font-family: Tema.font-mono; font-size: 12px; font-weight: 500; color: Stari.culoare(root.r.stare); vertical-alignment: center; }
        }
        // numele nu intra peste coloana Tip cand panoul ingusteaza tabelul:
        // se taie cu „…", iar ce tot depaseste se decupeaza
        Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            clip: true;
            HorizontalLayout {
                padding-right: 8px;
                Text { text: root.r.schema + "."; font-family: Tema.font-mono; font-size: 12.5px; color: Tema.text-tert; vertical-alignment: center; }
                Text { horizontal-stretch: 1; min-width: 0px; text: root.r.nume; font-family: Tema.font-mono; font-size: 12.5px; color: root.r.revizuit ? Tema.text-secundar : Tema.text; vertical-alignment: center; overflow: elide; }
            }
        }
        if root.cu-baza: Text { width: Coloane.baza; text: root.r.baza; font-family: Tema.font-mono; font-size: 12px; color: Tema.text-secundar; vertical-alignment: center; overflow: elide; }
        Text { width: Coloane.tip; text: root.r.tip; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; vertical-alignment: center; }
        HorizontalLayout {
            width: Coloane.linii;
            spacing: 8px;
            Text { text: root.r.plus; font-family: Tema.font-mono; font-size: 12px; color: Tema.add-text; vertical-alignment: center; }
            Text { text: root.r.minus; font-family: Tema.font-mono; font-size: 12px; color: Tema.del-text; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
        }
        // similaritatea: bara + procent; gol pentru obiectele fara scor
        HorizontalLayout {
            width: Coloane.scor;
            spacing: 8px;
            padding-right: 12px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: Tema.ident;
                    Rectangle {
                        x: 0;
                        width: parent.width * root.r.scor;
                        border-radius: 2px;
                        background: Stari.harta(root.r.stare);
                    }
                }
            }
            Text { width: 38px; text: root.r.scor-text; font-family: Tema.font-mono; font-size: 12px; color: Tema.text; horizontal-alignment: right; vertical-alignment: center; }
        }
        Text { width: Coloane.difera; text: root.r.difera-in; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; vertical-alignment: center; overflow: elide; }
        // cine il foloseste: 0 se arata stins, ca sa iasa in fata cele folosite
        Text { width: Coloane.folosit; text: root.r.folosit-de; font-family: Tema.font-mono; font-size: 12px; color: root.r.folosit-de == "0" ? Tema.text-tert : Tema.text; vertical-alignment: center; }
        Text {
            width: Coloane.impact;
            text: root.r.impact == 2 ? Texte.impact-ridicat : root.r.impact == 1 ? Texte.impact-mediu : root.r.impact == 0 ? Texte.impact-scazut : "";
            color: root.r.impact == 2 ? Tema.del-text : root.r.impact == 1 ? Tema.mod-text : Tema.text-tert;
            font-family: Tema.font-ui;
            font-size: 12.5px;
            font-weight: root.r.impact == 2 ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        HorizontalLayout {
            width: Coloane.revizuit;
            alignment: center;
            VerticalLayout {
                alignment: center;
                Bifa {
                    text: "";
                    bifat: root.r.revizuit;
                    schimbat => { root.comuta-revizuit(); }
                }
            }
        }
        Text {
            width: Coloane.deploy;
            // Extra (doar in Modificata): nu are ce sa se deployeze, ca in v3.4
            text: root.r.stare == 2 ? Texte.extra-fara-deploy : root.r.deploy == 1 ? Texte.pregatit : root.r.deploy == 2 ? Texte.trimis : root.r.deploy == 3 ? Texte.versiune-noua : root.r.deploy == 4 ? Texte.omis : Texte.neintrodus;
            color: root.r.deploy == 1 ? Tema.accent-text : root.r.deploy == 2 ? Tema.add-text : root.r.deploy == 3 ? Tema.mod-text : Tema.text-tert;
            font-family: Tema.font-ui;
            font-size: 12.5px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}


// Un filtru: eticheta cu numar; activ = conturat in chihlimbar.
component Filtru inherits Rectangle {
    in property <string> text;
    in property <string> numar;
    in property <color> culoare-numar: Tema.text-secundar;
    in property <bool> activ;
    callback apasat();
    height: 30px;
    width: rand.preferred-width + 22px;
    border-radius: 15px;
    border-width: 1px;
    border-color: root.activ ? Tema.accent : Tema.linie;
    background: root.activ ? Tema.strat : zona.has-hover ? Tema.strat : transparent;
    rand := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        Text { text: root.numar; font-family: Tema.font-mono; font-size: 12px; font-weight: 500; color: root.culoare-numar; vertical-alignment: center; }
        Text { text: root.text; font-family: Tema.font-ui; font-size: 12.5px; color: root.activ ? Tema.text : Tema.text-secundar; vertical-alignment: center; }
    }
    zona := TouchArea { clicked => { root.apasat(); } }
}



// Un rand din panoul de detalii: eticheta in stanga, valoarea in dreapta.
component RandDetaliu inherits HorizontalLayout {
    in property <string> eticheta;
    height: 28px;
    spacing: 8px;
    Text { text: root.eticheta; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; vertical-alignment: center; horizontal-stretch: 1; }
    @children
}

// O lista de nume din panou („Folosit de", „Foloseste"): eticheta la stanga,
// numele unul sub altul, fiecare se poate apasa (il selecteaza in lista).
component ListaDependente inherits HorizontalLayout {
    in property <string> eticheta;
    in property <[string]> nume;
    in property <string> rest;
    callback alege(string);
    spacing: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    Text { text: root.eticheta; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; vertical-alignment: top; horizontal-stretch: 1; }
    VerticalLayout {
        alignment: start;
        if root.nume.length == 0: Text { text: Texte.nicio-dependenta; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-tert; horizontal-alignment: right; }
        for n in root.nume: Rectangle {
            height: 20px;
            Text {
                text: n;
                font-family: Tema.font-mono;
                font-size: 12px;
                color: zn.has-hover ? Tema.accent-text : Tema.text;
                horizontal-alignment: right;
                vertical-alignment: center;
                width: parent.width;
                overflow: elide;
            }
            zn := TouchArea { mouse-cursor: pointer; clicked => { root.alege(n); } }
        }
        if root.rest != "": Text { text: root.rest; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-tert; horizontal-alignment: right; }
    }
}

// Eticheta colorata (stare revizuire, impact): 0 verde, 1 chihlimbar,
// 2 rosu, 3 gri.
component Pastila inherits Rectangle {
    in property <string> text;
    in property <int> fel;
    height: 22px;
    width: et.preferred-width + 18px;
    border-radius: 11px;
    background: root.fel == 0 ? Tema.add-fundal : root.fel == 1 ? Tema.mod-fundal : root.fel == 2 ? Tema.del-fundal : Tema.strat;
    et := Text {
        text: root.text;
        font-family: Tema.font-ui;
        font-size: 12px;
        font-weight: 500;
        color: root.fel == 0 ? Tema.add-text : root.fel == 1 ? Tema.mod-text : root.fel == 2 ? Tema.del-text : Tema.text-secundar;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}


// Un nod din arborele ca Object Explorer (etapa 19), folosit de coloana
// din stanga a editorului. Aplatizat in Rust (`model_arbore`).
export struct NodUi {
    // 0 baza, 1 dosar, 2 obiect
    nivel: int,
    fel: int,
    eticheta: string,
    numar: int,
    deschis: bool,
    cheie: string,
    // la obiect: pozitia in lista vizibila; -1 la baza si dosar
    pozitie: int,
}

export component FereastraLista inherits Window {
    title: "gmotion"; // text-permis: marca
    preferred-width: 1440px;
    // sub atat, randul filtrelor nu mai incape nici singur
    min-width: 760px;
    preferred-height: 900px;
    background: Tema.fundal;
    default-font-family: Tema.font-ui;
    default-font-size: 13px;

    in property <string> sursa-baza;
    in property <string> tinta-baza;
    in property <string> servere;          // „srv-dev → srv-prod · comparat la 14:32"
    in-out property <string> cautare;
    in property <string> numar-deploy;

    in property <string> progres-revizuite;   // „124/336"
    in property <float> progres-fractie;      // 0..1
    in property <[CategorieUi]> categorii;
    in property <[TipUi]> tipuri;
    in property <[TipUi]> baze;
    in property <bool> mai-multe-baze;
    in property <int> baza-activa: -1;
    in property <[string]> nume-baze;
    in property <int> categorie-activa: -1;   // indice in `categorii`, -1 = toate
    in property <int> tip-activ: -1;

    in property <string> rezumat-lista;       // „212 nerevizuite din 312"
    // filtrul pe stare: indice in `stari`, -1 = toate
    in property <[string]> stari;
    in property <int> stare-activa: -1;
    // filtrul pe impact: indice in `impacturi` (Ridicat, Mediu, Scazut), -1 = toate
    in property <[string]> impacturi;
    in property <int> impact-activ: -1;
    // panoul: cine foloseste obiectul si ce foloseste el (`schema.nume`);
    // `-rest` = „+N" cand lista e taiata
    in property <[string]> folosit-de-lista;
    in property <string> folosit-de-rest;
    in property <[string]> foloseste-lista;
    in property <string> foloseste-rest;
    in-out property <string> scor-min: "0";
    in-out property <string> scor-max: "100";
    in property <string> progres-deployate;   // „8/336"
    // unde s-a scris ultimul CSV, sau de ce n-a mers
    in property <string> mesaj-csv;
    in property <float> progres-deploy;       // 0..1
    in property <[RandListaUi]> randuri;
    // coloana sortata (`Sortare`) si sensul ei
    in property <int> coloana-sortata;
    in property <bool> sens-descrescator;
    in-out property <int> selectat: 0;

    in property <string> obiect-schema;
    in property <string> obiect-nume;
    in property <string> ce-difera;           // „un singur caracter, intr-un sir: Nu → nu"
    in property <bool> obiect-revizuit;
    in property <bool> obiect-in-plan;
    // panoul de detalii: deschis, latimea (trasa de mana), impactul si nota
    in property <bool> detalii-deschise;
    in-out property <length> latime-detalii: 460px;
    // -1 = nu se stie, 0 scazut, 1 mediu, 2 ridicat
    in property <int> impact-nivel: -1;
    in property <string> impact-motive;
    // nota obiectului `nota-baza` / `nota-id`; pusa din Rust doar cand se schimba obiectul,
    // ca sa nu mute cursorul cat scrii
    in-out property <string> nota;
    in-out property <string> nota-baza;
    in-out property <string> nota-id;
    in property <[RandUi]> previzualizare;
    in property <image> tigla-hasura;

    callback recompara();
    callback ajutor();
    in property <string> text-ajutor;
    in-out property <bool> arata-ajutorul;
    /// „Deconecteaza": intai se cere confirmarea, apoi se face.
    callback cere-deconectarea();
    callback deconecteaza();
    callback renunta-la-deconectare();
    in property <bool> intreaba-deconectarea;
    callback deschide-deploy();
    callback alege-categoria(int);
    callback alege-tipul(int);
    callback alege-baza(int);
    callback alege-randul(int);
    // clic pe rand: selecteaza si deschide detaliile; pe acelasi, le inchide.
    // Doua clicuri repezi = Deschide (numarate in Rust)
    callback clic-rand(int);
    callback inchide-detalii();
    callback comuta-omis();
    // baza, schema.nume, textul
    callback nota-editata(string, string, string);
    callback comuta-revizuit(int);
    callback deschide-obiectul();
    callback adauga-in-plan();
    callback cauta(string);
    callback sorteaza-coloana(int);
    /// Clic pe marginea unei coloane; doua repezi = autofit (numarate in Rust).
    callback clic-margine-coloana(int);
    callback alege-starea(int);
    callback alege-impactul(int);
    // clic pe un nume din „Folosit de" / „Foloseste"
    callback alege-dependenta(string);
    callback schimba-scorul(string, string);
    callback exporta-csv();
    callback pune-vizibilele-in-plan(bool);
    callback alege-tema(bool);
    // comutatorul de limba: etichetele si indicele ales vin din Rust
    in property <[string]> limbi;
    in property <int> limba-aleasa;
    callback alege-limba(int);
    callback ecran-complet();

    // latimea ferestrei, copiata la schimbare: arborele o citeste de aici,
    // nu din `root.width`, care depinde de layout (bucla)
    // ---- harta (`h`): ecranul de ansamblu, peste lista. Grupurile sunt
    // asezate si pictate in Rust (`src/harta.rs`); patratul selectat e
    // obiectul selectat din arbore
    in-out property <bool> arata-harta: false;
    in property <[GrupHartaUi]> harta;
    in property <length> harta-inaltime;
    // pixeli fizici pe pixel logic: harta se picteaza la rezolutia ecranului
    in property <float> factor-harta: 1;
    in property <length> sel-x;
    in property <length> sel-y;
    in property <bool> sel-pe-harta;
    // bula: numele si starea patratului de sub mouse, si coltul lui in
    // coordonatele hartii; toate puse din Rust
    in-out property <string> bula;
    in-out property <int> bula-stare;
    in-out property <length> hover-x;
    in-out property <length> hover-y;
    // latura unui patrat, la treapta de zoom aleasa in Rust (`harta::SCARI`)
    in property <length> patrat: 14px;
    // deschide harta: Rust o aseaza in ecranul de acum
    callback deschide-harta();
    callback peste-harta(int, length, length);
    callback clic-harta(int, length, length);
    // fereastra si-a schimbat marimea cu harta deschisa: Rust o reaseaza
    callback harta-redimensionata();
    property <length> latime-fereastra: 1440px;
    changed width => {
        root.latime-fereastra = self.width;
        if (root.arata-harta) { root.harta-redimensionata(); }
        root.potriveste-coloanele();
    }

    // Pe un ecran ingust, coloanele lasate la latimea implicita se strang, ca
    // numele obiectului sa nu mai fie „dbo.TESTSIMILITUDINE_Ca..." pe fiecare
    // rand (auditul 2026-11-23, 1024x768). O latime trasa de mana nu se atinge.
    function potriveste-coloanele() {
        if (self.width < 1200px) {
            if (Coloane.scor == 118px) { Coloane.scor = 76px; }
            if (Coloane.difera == 124px) { Coloane.difera = 96px; }
            if (Coloane.deploy == 130px) { Coloane.deploy = 100px; }
            if (Coloane.tip == 84px) { Coloane.tip = 72px; }
        } else {
            if (Coloane.scor == 76px) { Coloane.scor = 118px; }
            if (Coloane.difera == 96px) { Coloane.difera = 124px; }
            if (Coloane.deploy == 100px) { Coloane.deploy = 130px; }
            if (Coloane.tip == 72px) { Coloane.tip = 84px; }
        }
    }
    changed height => {
        if (root.arata-harta) { root.harta-redimensionata(); }
    }

    public function muta-selectia(pas: int) {
        if (root.randuri.length == 0) { return; }
        root.selectat = Math.max(0, Math.min(root.randuri.length - 1, root.selectat + pas));
        root.alege-randul(root.selectat);
        root.arata-selectia();
    }

    // Derularea urmeaza selectia doar cand selectia iese din vedere: inainte
    // randul ales sarea mereu pe pozitia 7, iar o selectie venita din Rust
    // (clic pe harta, recomparare) nu se vedea deloc (V12).
    // derularea tabelului, doar pentru teste
    out property <length> derulare-tabel: tabel.content-y;
    public function arata-selectia() {
        if (root.selectat < 0) { return; }
        if (root.selectat * 34px < -tabel.content-y) {
            tabel.content-y = -Math.max(0, root.selectat - 2) * 34px;
        } else if ((root.selectat + 1) * 34px > -tabel.content-y + tabel.visible-height) {
            tabel.content-y = -Math.max(0px, (root.selectat + 3) * 34px - tabel.visible-height);
        }
    }

    taste := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.F11) { root.ecran-complet(); return accept; }
            // Scurtaturile cu litera cer Ctrl (Mihai, 2026-11-20): o litera
            // singura, scrisa in cautare, ajungea si aici si bifa, punea in
            // plan sau deschidea harta. Sagetile, Enter si Esc raman simple.
            // harta: Ctrl+H o deschide si o inchide, Esc o inchide inaintea oricui
            if (e.modifiers.control && (e.text == "h" || e.text == "H")) {
                if (root.arata-harta) { root.arata-harta = false; } else { root.deschide-harta(); }
                return accept;
            }
            if (e.text == Key.Escape && root.arata-harta) { root.arata-harta = false; return accept; }
            if (root.arata-harta) { return reject; }
            // un dialog deschis (deconectarea, ajutorul) e modal si la
            // tastatura: Enter, Ctrl+I, Ctrl+R lucrau pe sub el (auditul
            // 2026-11-23). Doar Esc (si F1 pe ajutor) il inchide.
            if (root.intreaba-deconectarea) {
                if (e.text == Key.Escape) { root.renunta-la-deconectare(); }
                return accept;
            }
            if (root.arata-ajutorul) {
                if (e.text == Key.Escape || e.text == Key.F1) { root.arata-ajutorul = false; }
                return accept;
            }
            if (e.text == Key.DownArrow || (e.modifiers.control && (e.text == "j" || e.text == "J"))) { root.muta-selectia(1); return accept; }
            if (e.text == Key.UpArrow || (e.modifiers.control && (e.text == "k" || e.text == "K"))) { root.muta-selectia(-1); return accept; }
            if (e.text == Key.Return) { root.deschide-obiectul(); return accept; }
            if (e.modifiers.control && (e.text == "r" || e.text == "R")) { root.comuta-revizuit(root.selectat); return accept; }
            if (e.modifiers.control && (e.text == "i" || e.text == "I")) { root.adauga-in-plan(); return accept; }
            if (e.modifiers.control && (e.text == "o" || e.text == "O")) { root.comuta-omis(); return accept; }
            // Ctrl+F: cursorul in cautare, ca in v3.4
            if (e.modifiers.control && (e.text == "f" || e.text == "F")) { camp.focuseaza(); return accept; }
            if (e.text == Key.F1) { root.arata-ajutorul = !root.arata-ajutorul; root.ajutor(); return accept; }
            if (e.text == Key.Escape && root.arata-ajutorul) { root.arata-ajutorul = false; return accept; }
            if (e.text == Key.Escape && root.intreaba-deconectarea) { root.renunta-la-deconectare(); return accept; }
            // dialogurile de deasupra se inchid primele
            if (e.text == Key.Escape && root.detalii-deschise) { root.inchide-detalii(); return accept; }
            return reject;
        }

        VerticalLayout {
            // ---- antetul: semnul si bazele; tema si limba in dreapta
            Antet {
                sursa: root.sursa-baza;
                tinta: root.tinta-baza;
                VerticalLayout { alignment: center; ButonTema { alege(i) => { root.alege-tema(i); } } }
                VerticalLayout {
                    alignment: center;
                    ButonLimba { limbi: root.limbi; aleasa: root.limba-aleasa; alege(i) => { root.alege-limba(i); } }
                }
            }

            // ---- sub antet, patru grupuri care curg dupa latimea ferestrei:
            // starile si actiunile pe un rand, cautarea si filtrele cu planul
            // pe altul; cand nu incap alaturi, grupul trece dedesubt. Grupurile
            // din dreapta (actiunile, planul) stau lipite de margine cand au loc
            // pe randul lor.
            Rectangle { height: 6px; }
            bara := Rectangle {
                property <length> util: self.width - 40px;
                property <length> rand: 44px;
                property <length> gol: 16px;
                // randul starilor: actiunile alaturi sau dedesubt
                property <bool> a-alaturi: g-stari.preferred-width + self.gol + g-actiuni.preferred-width <= self.util;
                property <int> randuri-a: self.a-alaturi ? 1 : 2;
                // randul cautarii: cautarea, filtrele si planul pe un rand; daca nu
                // incap, cautarea si planul raman sus si filtrele trec dedesubt;
                // altfel cate unul pe rand
                property <bool> b-toate: g-cautare.preferred-width + self.gol + g-filtre.preferred-width + self.gol + g-plan.preferred-width <= self.util;
                property <bool> b-cp: g-cautare.preferred-width + self.gol + g-plan.preferred-width <= self.util;
                property <int> randuri-b: self.b-toate ? 1 : self.b-cp ? 2 : 3;
                property <length> y-b: self.randuri-a * self.rand;
                height: self.y-b + self.randuri-b * self.rand;

                g-stari := HorizontalLayout {
                    width: self.preferred-width;
                    x: 24px;
                    y: 0;
                    height: bara.rand;
                    spacing: 8px;
                    for c[i] in root.categorii: VerticalLayout {
                        alignment: center;
                        Filtru {
                            text: c.nume;
                            numar: c.numar;
                            culoare-numar: Stari.culoare(c.stare);
                            activ: root.categorie-activa == i;
                            apasat => { root.alege-categoria(root.categorie-activa == i ? -1 : i); }
                        }
                    }
                }
                g-actiuni := HorizontalLayout {
                    width: self.preferred-width;
                    x: bara.a-alaturi ? bara.width - 16px - self.preferred-width : 24px;
                    y: bara.a-alaturi ? 0 : bara.rand;
                    height: bara.rand;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 5px;
                        width: 130px;
                        HorizontalLayout {
                            Text { text: root.progres-revizuite; font-family: Tema.font-mono; font-size: 12px; color: Tema.text; }
                            Text { text: Texte.revizuite; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-secundar; horizontal-alignment: right; horizontal-stretch: 1; }
                        }
                        Rectangle {
                            height: 3px;
                            border-radius: 1.5px;
                            background: Tema.strat;
                            Rectangle { x: 0; width: parent.width * Math.max(0.02, root.progres-fractie); border-radius: 1.5px; background: Tema.add-bara; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 5px;
                        width: 110px;
                        HorizontalLayout {
                            Text { text: root.progres-deployate; font-family: Tema.font-mono; font-size: 12px; color: Tema.text; }
                            Text { text: Texte.deploy-mic; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-secundar; horizontal-alignment: right; horizontal-stretch: 1; }
                        }
                        Rectangle {
                            height: 3px;
                            border-radius: 1.5px;
                            background: Tema.strat;
                            Rectangle { x: 0; width: parent.width * Math.max(0.02, root.progres-deploy); border-radius: 1.5px; background: Tema.accent; }
                        }
                    }
                    VerticalLayout { alignment: center; Buton { text: Texte.harta-tasta; apasat => { root.deschide-harta(); } } }
                    VerticalLayout { alignment: center; Buton { text: Texte.recompara; apasat => { root.recompara(); } } }
                    VerticalLayout { alignment: center; Buton { text: Texte.ajutor-tasta; apasat => { root.arata-ajutorul = true; root.ajutor(); } } }
                    VerticalLayout { alignment: center; Buton { text: Texte.deconecteaza; apasat => { root.cere-deconectarea(); } } }
                }
                g-cautare := HorizontalLayout {
                    width: self.preferred-width;
                    x: 24px;
                    y: bara.y-b;
                    height: bara.rand;
                    spacing: 8px;
                    Rectangle {
                        width: 320px;
                        height: 34px;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: camp.are-focus ? Tema.accent : Tema.linie;
                        background: Tema.suprafata;
                        // un text lung nu iese din camp (sesizat de Mihai)
                        clip: true;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;
                            Path {
                                width: 14px; height: 14px; y: (parent.height - 14px) / 2; viewbox-width: 14; viewbox-height: 14;
                                commands: "M 6 1.5 A 4.5 4.5 0 1 1 5.99 1.5 M 9.3 9.3 L 12.5 12.5";
                                stroke: Tema.text-tert; stroke-width: 1.5px; fill: transparent;
                            }
                            camp := CampText {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                text <=> root.cautare;
                                edited(t) => { root.cauta(t); }
                            }
                        }
                        if root.cautare == "" && !camp.are-focus: Text {
                            x: 34px;
                            text: Texte.cauta-obiect;
                            font-family: Tema.font-ui;
                            font-size: 13px;
                            color: Tema.text-tert;
                            vertical-alignment: center;
                        }
                    }
                    if root.mai-multe-baze: VerticalLayout {
                        alignment: center;
                        MeniuFiltru {
                            eticheta: Texte.toate-bazele;
                            optiuni: root.nume-baze;
                            ales: root.baza-activa;
                            alege(i) => { root.alege-baza(i); }
                        }
                    }
                }
                g-filtre := HorizontalLayout {
                    width: self.preferred-width;
                    x: bara.b-toate ? 24px + g-cautare.preferred-width + bara.gol : 24px;
                    y: bara.b-toate ? bara.y-b : bara.y-b + bara.rand;
                    height: bara.rand;
                    spacing: 8px;
                    for t[i] in root.tipuri: VerticalLayout {
                        alignment: center;
                        Filtru {
                            text: t.nume;
                            numar: t.numar;
                            activ: root.tip-activ == i;
                            apasat => { root.alege-tipul(root.tip-activ == i ? -1 : i); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        MeniuFiltru {
                            eticheta: Texte.toate-starile;
                            optiuni: root.stari;
                            ales: root.stare-activa;
                            alege(i) => { root.alege-starea(i); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        MeniuFiltru {
                            eticheta: Texte.orice-impact;
                            optiuni: root.impacturi;
                            ales: root.impact-activ;
                            alege(i) => { root.alege-impactul(i); }
                        }
                    }
                    // intervalul de similaritate (v3.4: min–max %)
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 30px;
                            width: sm.preferred-width + 22px;
                            border-radius: 15px;
                            border-width: 1px;
                            border-color: root.scor-min != "0" || root.scor-max != "100" ? Tema.accent : Tema.linie;
                            background: Tema.suprafata;
                            sm := HorizontalLayout {
                                padding-left: 11px;
                                padding-right: 11px;
                                spacing: 6px;
                                Text { text: Texte.similar; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; vertical-alignment: center; }
                                VerticalLayout {
                                    alignment: center;
                                    CampProcent {
                                        valoare <=> root.scor-min;
                                        schimbat(v) => { root.schimba-scorul(v, root.scor-max); }
                                    }
                                }
                                Text { text: "–"; font-family: Tema.font-mono; font-size: 12px; color: Tema.text-tert; vertical-alignment: center; }
                                VerticalLayout {
                                    alignment: center;
                                    CampProcent {
                                        valoare <=> root.scor-max;
                                        schimbat(v) => { root.schimba-scorul(root.scor-min, v); }
                                    }
                                }
                                Text { text: "%"; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-tert; vertical-alignment: center; }
                            }
                        }
                    }
                }
                g-plan := HorizontalLayout {
                    width: self.preferred-width;
                    x: bara.width - 16px - self.preferred-width;
                    y: bara.b-cp ? bara.y-b : bara.y-b + 2 * bara.rand;
                    height: bara.rand;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        MeniuPlan { alege(cu) => { root.pune-vizibilele-in-plan(cu); } }
                    }
                    VerticalLayout { alignment: center; Buton { text: Texte.export-csv; apasat => { root.exporta-csv(); } } }
                    if root.mesaj-csv != "": VerticalLayout {
                        alignment: center;
                        Text { text: root.mesaj-csv; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-secundar; overflow: elide; }
                    }
                    VerticalLayout {
                        alignment: center;
                        ButonPrincipal {
                            text: Texte.deploy-paranteza + root.numar-deploy + ")";
                            activ: root.numar-deploy != "0";
                            apasat => { root.deschide-deploy(); }
                        }
                    }
                }
            }
            Rectangle { height: 6px; }

            // ---- tabelul si previzualizarea
            HorizontalLayout {
                vertical-stretch: 1;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                spacing: 3px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    // capul tabelului
                    Rectangle {
                        height: 30px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text { width: Coloane.stare; text: ""; }
                            CapColoana {
                                titlu: Texte.obiect-cap + root.rezumat-lista;
                                coloana: Sortare.nume;
                                clic-margine => { root.clic-margine-coloana(Sortare.nume); }
                                latime: 0px;
                                sortata: root.coloana-sortata == Sortare.nume;
                                descrescator: root.sens-descrescator;
                                apasat => { root.sorteaza-coloana(Sortare.nume); }
                            }
                            if root.mai-multe-baze: CapColoana {
                                titlu: Texte.modificata;
                                coloana: Sortare.baza;
                                clic-margine => { root.clic-margine-coloana(Sortare.baza); }
                                latime: Coloane.baza;
                                sortata: root.coloana-sortata == Sortare.baza;
                                descrescator: root.sens-descrescator;
                                apasat => { root.sorteaza-coloana(Sortare.baza); }
                            }
                            CapColoana {
                                titlu: Texte.tip;
                                coloana: Sortare.tip;
                                clic-margine => { root.clic-margine-coloana(Sortare.tip); }
                                latime: Coloane.tip;
                                sortata: root.coloana-sortata == Sortare.tip;
                                descrescator: root.sens-descrescator;
                                apasat => { root.sorteaza-coloana(Sortare.tip); }
                            }
                            CapColoana {
                                titlu: Texte.linii;
                                coloana: Sortare.linii;
                                clic-margine => { root.clic-margine-coloana(Sortare.linii); }
                                latime: Coloane.linii;
                                sortata: root.coloana-sortata == Sortare.linii;
                                descrescator: root.sens-descrescator;
                                apasat => { root.sorteaza-coloana(Sortare.linii); }
                            }
                            CapColoana {
                                titlu: Texte.similar;
                                coloana: Sortare.scor;
                                clic-margine => { root.clic-margine-coloana(Sortare.scor); }
                                latime: Coloane.scor;
                                sortata: root.coloana-sortata == Sortare.scor;
                                descrescator: root.sens-descrescator;
                                apasat => { root.sorteaza-coloana(Sortare.scor); }
                            }
                            CapColoana {
                                titlu: Texte.difera-in;
                                coloana: Sortare.difera;
                                clic-margine => { root.clic-margine-coloana(Sortare.difera); }
                                latime: Coloane.difera;
                                sortata: root.coloana-sortata == Sortare.difera;
                                descrescator: root.sens-descrescator;
                                apasat => { root.sorteaza-coloana(Sortare.difera); }
                            }
                            CapColoana {
                                titlu: Texte.coloana-folosit-de;
                                coloana: Sortare.folosit;
                                clic-margine => { root.clic-margine-coloana(Sortare.folosit); }
                                latime: Coloane.folosit;
                                sortata: root.coloana-sortata == Sortare.folosit;
                                descrescator: root.sens-descrescator;
                                apasat => { root.sorteaza-coloana(Sortare.folosit); }
                            }
                            CapColoana {
                                titlu: Texte.coloana-impact;
                                coloana: Sortare.impact;
                                clic-margine => { root.clic-margine-coloana(Sortare.impact); }
                                latime: Coloane.impact;
                                sortata: root.coloana-sortata == Sortare.impact;
                                descrescator: root.sens-descrescator;
                                apasat => { root.sorteaza-coloana(Sortare.impact); }
                            }
                            CapColoana {
                                titlu: Texte.revizuit;
                                coloana: Sortare.revizuit;
                                clic-margine => { root.clic-margine-coloana(Sortare.revizuit); }
                                latime: Coloane.revizuit;
                                sortata: root.coloana-sortata == Sortare.revizuit;
                                descrescator: root.sens-descrescator;
                                apasat => { root.sorteaza-coloana(Sortare.revizuit); }
                            }
                            CapColoana {
                                titlu: Texte.deploy;
                                coloana: Sortare.deploy;
                                clic-margine => { root.clic-margine-coloana(Sortare.deploy); }
                                latime: Coloane.deploy;
                                sortata: root.coloana-sortata == Sortare.deploy;
                                descrescator: root.sens-descrescator;
                                apasat => { root.sorteaza-coloana(Sortare.deploy); }
                            }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Tema.linie; }
                    }
                    tabel := ListView {
                        vertical-stretch: 1;
                        for r[i] in root.randuri: RandTabel {
                            r: r;
                            cu-baza: root.mai-multe-baze;
                            selectat: i == root.selectat;
                            apasat => {
                                taste.focus();
                                root.selectat = i;
                                root.clic-rand(i);
                            }
                            comuta-revizuit => { root.comuta-revizuit(i); }
                        }
                    }
                    if root.randuri.length == 0: Text {
                        text: Texte.niciun-obiect;
                        font-family: Tema.font-ui;
                        font-size: 13px;
                        color: Tema.text-secundar;
                        horizontal-alignment: center;
                    }
                }

                // manerul: trage ca sa schimbi latimea panoului
                if root.detalii-deschise: Rectangle {
                    width: 10px;
                    maner := TouchArea {
                        mouse-cursor: ew-resize;
                        moved => {
                            if (self.pressed) {
                                root.latime-detalii = Math.max(340px, Math.min(root.latime-fereastra - 860px, root.latime-detalii - (self.mouse-x - self.pressed-x)));
                            }
                        }
                    }
                    Rectangle {
                        x: (parent.width - 3px) / 2;
                        width: 3px;
                        height: 48px;
                        y: (parent.height - 48px) / 2;
                        border-radius: 1.5px;
                        background: maner.pressed || maner.has-hover ? Tema.accent : Tema.linie;
                    }
                }

                // detaliile obiectului selectat
                if root.detalii-deschise: Card {
                    width: Math.max(340px, Math.min(root.latime-fereastra - 860px, root.latime-detalii));
                    clip: true;
                    property <RandListaUi> sel: root.randuri[root.selectat];
                    VerticalLayout {
                        // sus doar cat ii trebuie; restul inaltimii e al previzualizarii
                        VerticalLayout {
                            vertical-stretch: 0;
                            padding: 18px;
                            padding-bottom: 12px;
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    alignment: start;
                                    horizontal-stretch: 1;
                                    Text { text: root.obiect-schema == "" ? "" : root.obiect-schema + "."; font-family: Tema.font-mono; font-size: 17px; color: Tema.text-tert; }
                                    Text { text: root.obiect-nume; font-family: Tema.font-mono; font-size: 17px; font-weight: 500; color: Tema.text; overflow: elide; horizontal-stretch: 1; }
                                }
                                // X: inchide panoul (la fel ca al doilea clic pe rand, sau Esc)
                                Rectangle {
                                    width: 26px;
                                    height: 26px;
                                    border-radius: 7px;
                                    background: inchide.has-hover ? Tema.strat : transparent;
                                    Path {
                                        width: 12px; height: 12px; viewbox-width: 12; viewbox-height: 12;
                                        commands: "M 2 2 L 10 10 M 10 2 L 2 10";
                                        stroke: Tema.text-secundar; stroke-width: 1.5px; fill: transparent;
                                    }
                                    inchide := TouchArea { clicked => { root.inchide-detalii(); } }
                                }
                            }
                            Text { text: sel.tip; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-tert; }
                            Rectangle { height: 8px; }
                            RandDetaliu {
                                eticheta: Texte.detalii-stare;
                                VerticalLayout {
                                    alignment: center;
                                    Pastila {
                                        text: sel.omis ? Texte.omis : sel.revizuit ? Texte.revizuit : Texte.nerevizuit;
                                        fel: sel.omis ? 3 : sel.revizuit ? 0 : 1;
                                    }
                                }
                            }
                            RandDetaliu {
                                eticheta: Texte.detalii-modificari;
                                Text { text: sel.plus == "" ? "–" : sel.plus; font-family: Tema.font-mono; font-size: 12.5px; color: sel.plus == "" ? Tema.text-tert : Tema.add-text; vertical-alignment: center; }
                                Text { text: sel.minus; font-family: Tema.font-mono; font-size: 12.5px; color: Tema.del-text; vertical-alignment: center; }
                            }
                            RandDetaliu {
                                eticheta: Texte.detalii-similaritate;
                                Text { text: sel.scor-text == "" ? "–" : sel.scor-text; font-family: Tema.font-mono; font-size: 12.5px; color: Tema.text; vertical-alignment: center; }
                            }
                            RandDetaliu {
                                eticheta: Texte.detalii-impact;
                                VerticalLayout {
                                    alignment: center;
                                    Pastila {
                                        text: root.impact-nivel == 0 ? Texte.impact-scazut : root.impact-nivel == 1 ? Texte.impact-mediu : root.impact-nivel == 2 ? Texte.impact-ridicat : "–";
                                        fel: root.impact-nivel == 0 ? 0 : root.impact-nivel == 1 ? 1 : root.impact-nivel == 2 ? 2 : 3;
                                    }
                                }
                            }
                            if root.impact-motive != "": Text {
                                text: root.impact-motive;
                                font-family: Tema.font-ui;
                                font-size: 11.5px;
                                color: Tema.text-tert;
                                wrap: word-wrap;
                                horizontal-alignment: right;
                            }
                            ListaDependente {
                                eticheta: Texte.coloana-folosit-de;
                                nume: root.folosit-de-lista;
                                rest: root.folosit-de-rest;
                                alege(n) => { root.alege-dependenta(n); }
                            }
                            ListaDependente {
                                eticheta: Texte.detalii-foloseste;
                                nume: root.foloseste-lista;
                                rest: root.foloseste-rest;
                                alege(n) => { root.alege-dependenta(n); }
                            }
                            RandDetaliu {
                                eticheta: Texte.deploy;
                                Text {
                                    text: sel.stare == 2 ? Texte.extra-nu-se-deployeaza : sel.deploy == 1 ? Texte.pregatit : sel.deploy == 2 ? Texte.trimis : sel.deploy == 3 ? Texte.versiune-noua : sel.deploy == 4 ? Texte.omis : Texte.neintrodus;
                                    color: sel.deploy == 1 ? Tema.accent-text : sel.deploy == 2 ? Tema.add-text : sel.deploy == 3 ? Tema.mod-text : Tema.text-tert;
                                    font-family: Tema.font-ui;
                                    font-size: 12.5px;
                                    vertical-alignment: center;
                                }
                            }
                            HorizontalLayout {
                                padding-top: 10px;
                                spacing: 8px;
                                alignment: start;
                                Buton {
                                    text: root.obiect-revizuit ? Texte.revizuit-bifat : Texte.revizuit;
                                    apasat => { root.comuta-revizuit(root.selectat); }
                                }
                                Buton { text: root.obiect-in-plan ? Texte.in-plan-bifat : Texte.in-plan; apasat => { root.adauga-in-plan(); } }
                                Buton { text: sel.omis ? Texte.omis-bifat : Texte.omite; apasat => { root.comuta-omis(); } }
                                ButonPrincipal { text: Texte.deschide; apasat => { root.deschide-obiectul(); } }
                            }
                            // nota: se salveaza pe masura ce scrii, pe obiectul ei
                            Text { text: Texte.nota; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; }
                            Rectangle {
                                height: 64px;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: camp-nota.has-focus ? Tema.accent : Tema.linie;
                                background: Tema.fundal;
                                clip: true;
                                camp-nota := TextInput {
                                    x: 10px;
                                    y: 8px;
                                    width: parent.width - 20px;
                                    height: parent.height - 16px;
                                    text <=> root.nota;
                                    font-family: Tema.font-ui;
                                    font-size: 12.5px;
                                    color: Tema.text;
                                    single-line: false;
                                    wrap: word-wrap;
                                    edited => { root.nota-editata(root.nota-baza, root.nota-id, self.text); }
                                }
                                if root.nota == "" && !camp-nota.has-focus: Text {
                                    x: 10px;
                                    y: 8px;
                                    text: Texte.nota-indiciu;
                                    font-family: Tema.font-ui;
                                    font-size: 12.5px;
                                    color: Tema.text-tert;
                                }
                            }
                            Text { text: root.ce-difera; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; wrap: word-wrap; }
                        }
                        Rectangle { height: 1px; background: Tema.linie; }
                        Rectangle {
                            vertical-stretch: 1;
                            background: Tema.cod-fundal;
                            previz := ListView {
                                for r in root.previzualizare: Rectangle {
                                    height: 20px;
                                    if r.fel == 1: Rectangle {
                                        background: Tema.fundal;
                                        Text {
                                            x: 47px;
                                            text: r.pliere;
                                            font-family: Tema.font-ui;
                                            font-size: 11.5px;
                                            color: Tema.text-secundar;
                                            vertical-alignment: center;
                                            height: parent.height;
                                        }
                                    }
                                    if r.fel == 0: Rectangle {
                                        Jumatate {
                                            x: 0px;
                                            width: parent.width / 2;
                                            nr: r.st-nr;
                                            bucati: r.st;
                                            stare: r.stare;
                                            fara-linie: r.st-nr == "";
                                            margine: true;
                                            tigla: root.tigla-hasura;
                                        }
                                        Jumatate {
                                            x: parent.width / 2;
                                            width: parent.width / 2;
                                            nr: r.dr-nr;
                                            bucati: r.dr;
                                            stare: r.stare;
                                            fara-linie: r.dr-nr == "";
                                            tigla: root.tigla-hasura;
                                        }
                                    }
                                }
                            }
                            if root.previzualizare.length > 0: Rectangle {
                                x: previz.visible-width / 2;
                                width: 1px;
                                background: Tema.linie;
                            }
                            if root.previzualizare.length == 0: Text {
                                x: 18px;
                                y: 14px;
                                text: Texte.alege-un-obiect;
                                font-family: Tema.font-ui;
                                font-size: 12.5px;
                                color: Tema.text-secundar;
                            }
                        }
                    }
                }
            }

            // ---- subsolul: scurtaturile si serverele
            Rectangle {
                height: 30px;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 18px;
                    // scurtaturile se taie cand nu incap (1024 px), in loc sa
                    // impinga serverele afara din ecran (auditul 2026-11-22)
                    Rectangle {
                        clip: true;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        HorizontalLayout {
                            spacing: 18px;
                            alignment: start;
                            for k in [{ t: "ctrl j k", e: Texte.obiect-mic }, { t: Texte.tasta-clic, e: Texte.detalii-mic }, { t: Texte.tasta-dublu-clic, e: Texte.deschide-mic }, { t: "ctrl r", e: Texte.revizuit-mic }, { t: "ctrl i", e: Texte.in-plan-mic }, { t: "ctrl o", e: Texte.omite-mic }, { t: "esc", e: Texte.inchide-detaliile-mic }, { t: "ctrl h", e: Texte.harta-mic }, { t: "ctrl f", e: Texte.cauta-mic }]: HorizontalLayout {
                                spacing: 6px;
                                Text { text: k.t; font-family: Tema.font-mono; font-size: 11.5px; color: Tema.text; vertical-alignment: center; }
                                Text { text: k.e; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-tert; vertical-alignment: center; }
                            }
                        }
                    }
                    Text { text: root.servere; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-tert; vertical-alignment: center; overflow: elide; min-width: 0px; max-width: 420px; }
                }
            }
        }
    }

    // ---- harta (`h`): toate obiectele dintr-o privire, pe tot ecranul,
    // peste lista. Un clic pe patrat inchide harta si arata obiectul in arbore.
    if root.arata-harta: Rectangle {
        background: Tema.fundal;
        // clicurile nu trec la lista de dedesubt
        TouchArea { }
        Rectangle {
            y: 0;
            height: 60px;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 16px;
                spacing: 16px;
                VerticalLayout { alignment: center; Semn { } }
                Text { text: Texte.harta-titlu; font-family: Tema.font-ui; font-size: 15px; font-weight: 600; color: Tema.text; vertical-alignment: center; }
                Text { text: Texte.harta-explicatie; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                VerticalLayout { alignment: center; Buton { text: Texte.inapoi-la-lista; apasat => { root.arata-harta = false; } } }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Tema.linie; }
        }
        cartus := Rectangle {
            x: 16px;
            y: 76px;
            width: parent.width - 32px;
            // cat ii trebuie hartii, dar nu mai jos de marginea ferestrei
            height: Math.min(parent.height - 92px, root.harta-inaltime + 32px);
            border-radius: 14px;
            background: Tema.suprafata;
            border-width: 1px;
            border-color: Tema.linie;
            clip: true;
            // `chenar`: loc pentru conturul selectiei / al mouse-ului, care
            // iese cu 3 px din patrat; fara el, Flickable il taia la
            // marginea din stanga si de sus
            property <length> chenar: 4px;
            flick := Flickable {
                x: 18px - parent.chenar;
                y: 16px - parent.chenar;
                width: parent.width - 36px + 2 * parent.chenar;
                height: parent.height - 32px + 2 * parent.chenar;
                content-height: root.harta-inaltime + 2 * parent.chenar;
                Rectangle {
                    x: cartus.chenar;
                    y: cartus.chenar;
                    for g[gi] in root.harta: Rectangle {
                        x: g.x;
                        y: g.y;
                        width: g.latime;
                        height: g.inaltime;
                        // linia despartitoare, la mijlocul spatiului dintre coloane
                        // (`harta::SPATIU_X` / 2)
                        if g.desparte: Rectangle {
                            x: -20px;
                            width: 1px;
                            height: parent.height;
                            background: Tema.linie;
                        }
                        HorizontalLayout {
                            y: 0;
                            height: 20px;
                            Text { text: g.titlu; font-family: Tema.font-ui; font-size: 14px; font-weight: 500; color: Tema.text; vertical-alignment: center; horizontal-stretch: 0; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: g.numar; font-family: Tema.font-mono; font-size: 12.5px; color: Tema.text-secundar; vertical-alignment: center; horizontal-stretch: 0; }
                        }
                        // bara cu proportia starilor (`harta::Y_BARA`)
                        Image {
                            x: 0;
                            y: 28px;
                            width: g.latime;
                            height: self.source.height * 1px / root.factor-harta;
                            source: g.bara;
                            image-rendering: pixelated;
                        }
                        // grila (`harta::CAP`); pictata la pixelii fizici ai
                        // ecranului, deci afisata la marimea ei / factor (15 D)
                        img := Image {
                            x: 0;
                            y: 44px;
                            width: self.source.width * 1px / root.factor-harta;
                            height: self.source.height * 1px / root.factor-harta;
                            source: g.imagine;
                            image-rendering: pixelated;
                        }
                        TouchArea {
                            x: img.x;
                            y: img.y;
                            width: img.width;
                            height: img.height;
                            // ce patrat e sub mouse se decide in Rust (`harta::indice_la`)
                            // `moved` vine doar cu butonul apasat; la simpla trecere a
                            // mouse-ului se schimba doar `mouse-x` / `mouse-y`
                            changed mouse-x => { if (self.has-hover) { root.peste-harta(gi, self.mouse-x, self.mouse-y); } }
                            changed mouse-y => { if (self.has-hover) { root.peste-harta(gi, self.mouse-x, self.mouse-y); } }
                            changed has-hover => { if (!self.has-hover) { root.bula = ""; } }
                            clicked => { root.clic-harta(gi, self.mouse-x, self.mouse-y); }
                        }
                    }
                    // conturul patratului de sub mouse
                    if root.bula != "": Rectangle {
                        x: root.hover-x - 3px;
                        y: root.hover-y - 3px;
                        width: root.patrat + 6px;
                        height: root.patrat + 6px;
                        border-radius: root.patrat / 2;
                        border-width: 1.5px;
                        border-color: Tema.text-secundar;
                    }
                    // conturul patratului selectat
                    if root.sel-pe-harta: Rectangle {
                        x: root.sel-x - 3px;
                        y: root.sel-y - 3px;
                        width: root.patrat + 6px;
                        height: root.patrat + 6px;
                        border-radius: root.patrat / 2;
                        border-width: 2px;
                        border-color: Tema.text;
                        drop-shadow-blur: 8px;
                        drop-shadow-color: Tema.text.with-alpha(0.35);
                    }
                }
            }
            // bula: punctul starii si numele, in dreapta patratului de sub mouse,
            // la mijlocul lui (ca in macheta); in stanga, daca la dreapta nu incape
            if root.bula != "": Rectangle {
                property <length> px: flick.x + parent.chenar + flick.content-x + root.hover-x;
                property <length> py: flick.y + parent.chenar + flick.content-y + root.hover-y;
                x: self.px + root.patrat + 10px + self.width <= parent.width - 8px
                    ? self.px + root.patrat + 10px
                    : Math.max(4px, self.px - 10px - self.width);
                y: Math.max(4px, self.py + root.patrat / 2 - 14px);
                width: bl.preferred-width + 20px;
                height: 28px;
                border-radius: 7px;
                background: Tema.strat;
                border-width: 1px;
                border-color: Tema.linie;
                drop-shadow-blur: 10px;
                drop-shadow-offset-y: 2px;
                drop-shadow-color: Tema.fundal.with-alpha(0.5);
                bl := HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 7px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Stari.harta(root.bula-stare); }
                    }
                    Text { text: root.bula; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text; vertical-alignment: center; }
                }
            }
        }
    }

    // ---- „Te deconectezi?": v3.4 intreba, fiindca se pierde ecranul de
    // lucru. Progresul e salvat, deci asta si scrie in dialog.
    if root.intreaba-deconectarea: Rectangle {
        background: Tema.intunecat ? #00000099 : #0f111566;
        TouchArea { }
        Rectangle {
            width: 420px;
            height: 184px;
            border-radius: 14px;
            border-width: 1px;
            border-color: Tema.linie;
            background: Tema.suprafata;
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text { text: Texte.te-deconectezi; font-family: Tema.font-ui; font-size: 15px; font-weight: 600; color: Tema.text; }
                Text {
                    text: Texte.progresul-salvat;
                    font-family: Tema.font-ui;
                    font-size: 12.5px;
                    color: Tema.text-secundar;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    Buton { text: Texte.ramai-esc; apasat => { root.renunta-la-deconectare(); } }
                    ButonPrincipal { text: Texte.deconecteaza; apasat => { root.deconecteaza(); } }
                }
            }
        }
    }

    if root.arata-ajutorul: Ajutor {
        text: root.text-ajutor;
        inchide => { root.arata-ajutorul = false; }
    }

    init => {
        root.latime-fereastra = self.width;
        root.potriveste-coloanele();
        taste.focus();
    }
}
