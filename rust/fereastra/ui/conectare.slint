// Ecranul de conectare: ce se compara cu ce. Dupa macheta
// `cercetare/machete/conectare-noua/` (etapa 17): martorul si modificata
// alaturi, simetrice, fiecare cu conexiunea lui sus si lista bazelor
// dedesubt; Compara la mijloc; comparatiile recente si jurnalul jos.
//
// Se strica astfel: butonul „Compara" pare apasabil cand lipseste ceva (si
// omul afla abia dupa ce asteapta conectarea), sau parola ajunge unde nu
// trebuie. Primul se decide in `src/model_conectare.rs` (testat fara
// fereastra); al doilea tine de tipul care o pastreaza, fara `Debug` derivat.
// Proportiile (cardurile 3/4, jurnalul 1/4) se decid aici; scara intregului
// ecran, in `src/scara.rs`.

import { ListView } from "std-widgets.slint";
import { Texte, Tema, ButonLimba, Buton, ButonPrincipal, Antet, ButonTema, Card, Ajutor, Despre, Rotitor, BaraDerulare, ZonaSfat } from "comune.slint";

// Un server gasit in retea, cu etichetele din raspunsul SSRP.
export struct ServerGasitUi {
    nume: string,
    cluster: bool,
    implicita: bool,
}

export struct ParteUi {
    eticheta: string,
    rol: string,
    server: string,
    auth-windows: bool,
    utilizator: string,
    parola: string,
    baza: string,
    baze: [string],
    // ce e ales, in aceeasi ordine ca `baze`
    alese: [bool],
    // ce scrie cand e o singura baza aleasa: numele ei
    eticheta-baze: string,
    stare: string,
    // 0 neincercat, 1 se conecteaza, 2 conectat, 3 eroare
    fel-stare: int,
    // instantele gasite in retea, de ales cu un clic
    servere-gasite: [ServerGasitUi],
    // cautarea in retea ruleaza (lupa devine rotitor)
    se-cauta: bool,
}

// O etapa a compararii, in panoul de progres: ce face, cat a durat;
// stare 0 asteapta, 1 in curs, 2 gata
export struct EtapaUi {
    nume: string,
    durata: string,
    stare: int,
}

export struct RecentaUi {
    sursa: string,
    baza: string,
    // serverul (sau instantaneul) compararii, ca in v3.4
    server: string,
    cand: string,
    progres: string,
}

// o linie din jurnalul aplicatiei; nivel: 0 info, 2 atentie, 3 eroare
export struct LinieJurnalUi {
    nivel: int,
    text: string,
}

// Eticheta mica de langa un server gasit (IMPLICITA / CLUSTER).
component EticServer inherits Rectangle {
    in property <string> text;
    in property <color> culoare: Tema.text-tert;
    height: 18px;
    width: et.preferred-width + 12px;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.culoare;
    et := Text {
        text: root.text;
        font-family: Tema.font-mono;
        font-size: 10px;
        font-weight: 500;
        color: root.culoare;
        letter-spacing: 0.4px;
    }
}

// Un panou de cod lipit, pentru compararea offline.
component PanouCod inherits Rectangle {
    in-out property <string> text;
    vertical-stretch: 1;
    border-radius: 10px;
    border-width: 1px;
    border-color: Tema.linie;
    background: Tema.cod-fundal;
    clip: true;
    Flickable {
        x: 10px;
        y: 8px;
        width: parent.width - 20px;
        height: parent.height - 16px;
        TextInput {
            text <=> root.text;
            font-family: Tema.font-mono;
            font-size: 12.5px;
            color: Tema.text;
            wrap: no-wrap;
            single-line: false;
        }
    }
}

component Eticheta inherits Text {
    font-family: Tema.font-ui;
    font-size: 12px;
    color: Tema.text-secundar;
}

// Text apasabil din antet si din carduri: fara chenar, ca in macheta.
component Legatura inherits Rectangle {
    in property <string> text;
    in property <color> culoare: Tema.text-secundar;
    in property <length> marime: 13px;
    callback apasat();
    height: 30px;
    width: et.preferred-width + 16px;
    border-radius: 7px;
    background: zona.has-hover ? Tema.strat : transparent;
    et := Text { text: root.text; font-family: Tema.font-ui; font-size: root.marime; color: root.culoare; }
    zona := TouchArea { clicked => { root.apasat(); } }
}

// Bifa patrata, cu textul ei.
component Bifa inherits Rectangle {
    in property <bool> bifat;
    in property <string> text;
    callback comutat();
    height: 26px;
    width: rand.preferred-width + 12px;
    border-radius: 6px;
    background: zb.has-hover ? Tema.strat : transparent;
    rand := HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 15px;
                height: 15px;
                border-radius: 4px;
                border-width: 1.5px;
                border-color: root.bifat ? Tema.accent : Tema.text-tert;
                background: root.bifat ? Tema.accent : transparent;
                if root.bifat: Path {
                    width: 11px; height: 11px; viewbox-width: 16; viewbox-height: 16;
                    commands: "M 3 8.5 L 6 11.5 L 13 4.5";
                    stroke: Tema.pe-accent; stroke-width: 2.4px; fill: transparent;
                }
            }
        }
        Text { text: root.text; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text; vertical-alignment: center; }
    }
    zb := TouchArea { clicked => { root.comutat(); } }
}

// Camp de text, adancit in card. Cu `cauta`, are lupa in dreapta.
component Camp inherits Rectangle {
    in property <string> text;
    // Legatura `text: root.text` de pe `intrare` se rupe la prima tasta: din
    // momentul ala campul isi tine textul lui si nu mai urmeaza modelul. Deci
    // cand modelul se schimba din Rust (Inverseaza, un server ales din
    // cautare), textul se rescrie explicit (F-A2 din auditul QA).
    changed text => {
        // Campul de parola face exceptie: modelul nu-i da continutul, doar
        // buline cat lungimea lui. Rescris cu ele, prima tasta de dupa ar
        // trimite bulinele ca parola. Se goleste doar cand modelul spune ca
        // nu exista nicio parola (Deconecteaza, Inverseaza spre o parte fara
        // parola).
        if (root.ascuns) {
            if (root.text == "" && intrare.text != "") { intrare.text = ""; }
        } else if (intrare.text != root.text) {
            intrare.text = root.text;
        }
    }
    in property <bool> mono: false;
    in property <bool> ascuns: false;
    in property <string> gol;
    in property <bool> cauta: false;
    // cautarea in retea ruleaza
    in property <bool> lucreaza: false;
    callback schimbat(string);
    callback la-cautare();
    height: 36px;
    min-width: 60px;
    border-radius: 8px;
    border-width: 1px;
    border-color: intrare.has-focus ? Tema.accent : Tema.linie;
    background: Tema.suprafata;
    forward-focus: intrare;
    clip: true;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: root.cauta ? 4px : 12px;
        spacing: 6px;
        intrare := TextInput {
            text: root.text;
            font-family: root.mono ? Tema.font-mono : Tema.font-ui;
            font-size: 13px;
            color: Tema.text;
            vertical-alignment: center;
            single-line: true;
            input-type: root.ascuns ? InputType.password : InputType.text;
            edited => { root.schimbat(self.text); }
        }
        // lupa: un singur semn, intr-un buton al lui, despartit de text;
        // cat cauta, trei puncte care pulseaza
        if root.cauta: HorizontalLayout {
            spacing: 4px;
            Rectangle { width: 1px; background: Tema.linie-slaba; }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 30px;
                    height: 28px;
                    border-radius: 6px;
                    background: lupa.has-hover && !root.lucreaza ? Tema.strat : transparent;
                    if !root.lucreaza: Path {
                        width: 15px; height: 15px; viewbox-width: 16; viewbox-height: 16;
                        commands: "M 6.8 1.8 A 5 5 0 1 1 6.79 1.8 M 10.4 10.4 L 14.4 14.4";
                        stroke: lupa.has-hover ? Tema.accent-text : Tema.text-secundar; stroke-width: 1.7px; fill: transparent;
                    }
                    if root.lucreaza: Rotitor { culoare: Tema.accent-text; }
                    lupa := ZonaSfat {
                        sfat: Texte.sfat-cauta-servere;
                        enabled: !root.lucreaza;
                        mouse-cursor: pointer;
                        clicked => { root.la-cautare(); }
                    }
                }
            }
        }
    }
    if root.text == "" && !intrare.has-focus && root.gol != "": Text {
        x: 12px;
        width: root.width - 24px;
        text: root.gol;
        font-family: Tema.font-ui;
        font-size: 13px;
        color: Tema.text-tert;
        vertical-alignment: center;
        overflow: elide;
    }
}

// SQL Server / Windows, ca un comutator in doua.
component Segment inherits Rectangle {
    in property <bool> windows;
    callback ales(bool);
    height: 36px;
    border-radius: 8px;
    background: Tema.suprafata;
    border-width: 1px;
    border-color: Tema.linie;
    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for o[i] in ["SQL Server", "Windows"]: Rectangle {
            property <bool> pornit: (i == 1) == root.windows;
            border-radius: 6px;
            background: self.pornit ? Tema.strat : transparent;
            Text {
                text: o;
                font-family: Tema.font-ui;
                font-size: 13px;
                font-weight: parent.pornit ? 600 : 400;
                color: parent.pornit ? Tema.text : Tema.text-secundar;
            }
            TouchArea { clicked => { root.ales(i == 1); } }
        }
    }
}

// Lista bazelor unei parti: un rand pe baza, cu cerc, derulabila. O singura
// baza aleasa. `blocata` e baza martorului in lista modificatei, cand
// conexiunea e aceeasi: se vede, dar nu se poate alege.
component ListaBaze inherits Rectangle {
    in property <[string]> baze;
    in property <[bool]> alese;
    in property <string> blocata;
    in property <string> gol;
    in property <bool> se-incarca;
    in property <bool> poate-cere;
    in property <bool> fara-servere;
    callback aleasa(string);
    callback cere();
    min-height: 104px;
    vertical-stretch: 1;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tema.linie;
    background: Tema.fundal;
    clip: true;
    // goala: cat se citesc, rotitorul; altfel butonul explicit „Adu bazele"
    // (Mihai, 2026-11-25: nu se mai incarca singure la un clic pe lista)
    if root.baze.length == 0: VerticalLayout {
        alignment: center;
        spacing: 12px;
        padding: 16px;
        if root.se-incarca: Rotitor { }
        if !root.se-incarca: HorizontalLayout {
            alignment: center;
            Rectangle {
                height: 36px;
                width: ta.preferred-width + 36px;
                border-radius: 9px;
                background: root.poate-cere ? Tema.accent : Tema.strat;
                opacity: root.poate-cere && za.has-hover ? 0.88 : 1;
                animate opacity { duration: 90ms; }
                ta := Text {
                    text: Texte.adu-bazele;
                    font-family: Tema.font-ui;
                    font-size: 13px;
                    font-weight: 600;
                    color: root.poate-cere ? Tema.pe-accent : Tema.text-tert;
                }
                za := TouchArea {
                    enabled: root.poate-cere;
                    mouse-cursor: root.poate-cere ? pointer : default;
                    clicked => { root.cere(); }
                }
            }
        }
        Text {
            text: root.gol;
            font-family: Tema.font-ui;
            font-size: 12.5px;
            color: Tema.text-tert;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    lista-baze := ListView {
        for b[i] in root.baze: rb := Rectangle {
            property <bool> e-aleasa: root.alese[i];
            property <bool> e-blocata: b == root.blocata;
            height: 34px;
            background: rb.e-aleasa ? Tema.mod-fundal : zr.has-hover && !rb.e-blocata ? Tema.strat : transparent;
            if rb.e-aleasa: Rectangle { x: 0; width: 3px; background: Tema.accent; }
            Rectangle { y: parent.height - 1px; height: 1px; background: Tema.linie-slaba; }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        border-width: 1.2px;
                        border-color: rb.e-aleasa ? Tema.accent : Tema.text-tert;
                        opacity: rb.e-blocata ? 0.4 : 1;
                        if rb.e-aleasa: Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: Tema.accent;
                        }
                    }
                }
                Text {
                    text: b;
                    font-family: Tema.font-mono;
                    font-size: 13px;
                    color: rb.e-aleasa ? Tema.accent-text : rb.e-blocata ? Tema.text-tert : Tema.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if rb.e-blocata: Text {
                    text: Texte.e-martorul;
                    font-family: Tema.font-ui;
                    font-size: 12px;
                    color: Tema.text-tert;
                    vertical-alignment: center;
                }
            }
            zr := TouchArea {
                enabled: !rb.e-blocata;
                clicked => { root.aleasa(b); }
            }
        }
    }
    BaraDerulare {
        x: parent.width - self.width;
        height: parent.height;
        pozitie <=> lista-baze.content-y;
        continut: lista-baze.content-height;
        vizibil: lista-baze.visible-height;
    }
}

// O parte (martorul sau modificata): sus conexiunea, dedesubt bazele.
component PanouParte inherits Card {
    in property <ParteUi> p;
    in property <bool> fara-servere;
    // doar la modificata: bifa „Aceeasi conexiune"
    in property <bool> are-bifa;
    in property <bool> aceeasi;
    in property <string> server-martor;
    in property <string> blocata;
    in property <bool> strans;
    // ca zona „aceeasi conexiune" sa fie cat conexiunea martorului, si
    // listele sa inceapa la aceeasi linie
    in property <length> inaltime-aceeasi;
    out property <length> inaltime-conexiune: interior.preferred-height;
    property <bool> arata-conexiune: !root.fara-servere && !(root.are-bifa && root.aceeasi);
    callback server-schimbat(string);
    callback auth-schimbat(bool);
    callback utilizator-schimbat(string);
    callback parola-schimbata(string);
    callback baza-aleasa(string);
    callback cere-bazele();
    callback testeaza();
    callback cauta-servere();
    callback server-ales(string);
    callback aceeasi-comutat();
    min-width: 360px;
    clip: true;

    VerticalLayout {
        padding: root.strans ? 14px : 18px;
        padding-top: root.strans ? 12px : 16px;
        spacing: root.strans ? 10px : 12px;

        HorizontalLayout {
            spacing: 10px;
            height: 26px;
            Text { text: p.eticheta; font-family: Tema.font-ui; font-size: 17px; font-weight: 600; color: Tema.text; vertical-alignment: center; letter-spacing: -0.3px; }
            // baza aleasa, langa rol: „Martor · CharismaERP_GetsBet"
            if p.eticheta-baze != "": VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 22px;
                    width: Math.min(eb.preferred-width + 16px, 320px);
                    border-radius: 11px;
                    background: root.are-bifa ? Tema.mod-fundal : Tema.add-fundal;
                    eb := Text {
                        x: 8px;
                        width: parent.width - 16px;
                        text: p.eticheta-baze;
                        font-family: Tema.font-mono;
                        font-size: 12px;
                        color: root.are-bifa ? Tema.mod-text : Tema.add-text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            Text { text: p.rol; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            if root.are-bifa && !root.fara-servere: Bifa {
                bifat: root.aceeasi;
                text: Texte.aceeasi-conexiune;
                comutat => { root.aceeasi-comutat(); }
            }
        }

        // o singura zona, cat conexiunea martorului: fie campurile, fie
        // „Aceeasi conexiune ca martorul". Doua elemente separate ar fi adus
        // un spatiu in plus si listele n-ar mai incepe la aceeasi linie.
        conexiune := Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: Tema.linie;
            background: root.arata-conexiune ? Tema.fundal : transparent;
            height: root.arata-conexiune ? interior.preferred-height : root.fara-servere ? 0px : root.inaltime-aceeasi;
            visible: !root.fara-servere;
            clip: true;
            if !root.arata-conexiune && !root.fara-servere: VerticalLayout {
                alignment: center;
                spacing: 6px;
                Text { text: Texte.aceeasi-conexiune-ca; font-family: Tema.font-ui; font-size: 13px; color: Tema.text-secundar; horizontal-alignment: center; }
                Text { text: root.server-martor; font-family: Tema.font-mono; font-size: 12.5px; color: Tema.text-secundar; horizontal-alignment: center; overflow: elide; }
            }
            interior := VerticalLayout {
                visible: root.arata-conexiune;
                padding: root.strans ? 8px : 10px;
                spacing: root.strans ? 6px : 8px;
                HorizontalLayout {
                    spacing: 10px;
                    Segment {
                        min-width: 150px;
                        max-width: 200px;
                        horizontal-stretch: 1;
                        windows: p.auth-windows;
                        ales(w) => { root.auth-schimbat(w); }
                    }
                    Camp {
                        horizontal-stretch: 3;
                        text: p.server;
                        mono: true;
                        cauta: true;
                        lucreaza: p.se-cauta;
                        gol: Texte.exemplu-server;
                        schimbat(t) => { root.server-schimbat(t); }
                        la-cautare => { root.cauta-servere(); }
                    }
                }
                // ce a gasit cautarea in retea; un clic pune serverul in camp
                if p.servere-gasite.length > 0: Rectangle {
                    height: gasite.preferred-height;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Tema.linie;
                    background: Tema.suprafata;
                    gasite := VerticalLayout {
                        padding: 4px;
                        for s in p.servere-gasite: Rectangle {
                            height: 28px;
                            border-radius: 6px;
                            background: zs.has-hover ? Tema.strat : transparent;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 6px;
                                Text { text: s.nume; font-family: Tema.font-mono; font-size: 12.5px; color: Tema.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                if s.implicita: EticServer { text: Texte.server-implicit; }
                                if s.cluster: EticServer { text: Texte.server-cluster; culoare: Tema.mod-text; }
                            }
                            zs := TouchArea { clicked => { root.server-ales(s.nume); } }
                        }
                    }
                }
                // la autentificarea Windows randul ramane, cu acelasi rost:
                // cine se conecteaza. Asa cele doua carduri au aceeasi inaltime.
                if !p.auth-windows: HorizontalLayout {
                    spacing: 10px;
                    Camp {
                        horizontal-stretch: 1;
                        text: p.utilizator;
                        gol: Texte.utilizator;
                        schimbat(t) => { root.utilizator-schimbat(t); }
                    }
                    Camp {
                        horizontal-stretch: 1;
                        text: p.parola;
                        ascuns: true;
                        gol: Texte.parola;
                        schimbat(t) => { root.parola-schimbata(t); }
                    }
                }
                if p.auth-windows: Rectangle {
                    height: 36px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Tema.linie-slaba;
                    Text {
                        x: 12px;
                        text: Texte.cont-windows;
                        font-family: Tema.font-ui;
                        font-size: 13px;
                        color: Tema.text-tert;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    height: 22px;
                    if p.stare != "": VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 3.5px;
                            background: p.fel-stare == 3 ? Tema.del-bara : p.fel-stare == 2 ? Tema.add-bara : Tema.text-tert;
                        }
                    }
                    Text {
                        text: p.stare;
                        font-family: Tema.font-ui;
                        font-size: 12.5px;
                        color: p.fel-stare == 3 ? Tema.del-text : p.fel-stare == 2 ? Tema.add-text : Tema.text-secundar;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Legatura {
                        height: 22px;
                        text: Texte.testeaza;
                        culoare: Tema.accent-text;
                        marime: 12.5px;
                        // doar proba conexiunii: bazele le aduce butonul lor
                        apasat => { root.testeaza(); }
                    }
                }
            }
        }

        ListaBaze {
            baze: p.baze;
            alese: p.alese;
            blocata: root.blocata;
            se-incarca: p.fel-stare == 1 && !p.se-cauta;
            // fara server nu are ce aduce (dintr-un instantaneu, da); cu
            // „Aceeasi conexiune" le aduce martorul
            poate-cere: (root.fara-servere || p.server != "") && !(root.are-bifa && root.aceeasi);
            fara-servere: root.fara-servere;
            gol: p.fel-stare == 1 ? p.stare : root.fara-servere ? Texte.adu-din-instantaneu : p.server == "" ? Texte.conecteaza-te-intai : Texte.apasa-adu-bazele;
            aleasa(b) => { root.baza-aleasa(b); }
            cere => { if (!(root.are-bifa && root.aceeasi)) { root.cere-bazele(); } }
        }
    }
}

// Un rand din comparatiile recente: reluabil cu un clic; „Ignora" la hover.
component RandRecenta inherits Rectangle {
    in property <RecentaUi> r;
    callback reia();
    callback ignora();
    height: 36px;
    background: rand.has-hover ? Tema.strat : transparent;
    Rectangle { y: parent.height - 1px; height: 1px; background: Tema.linie-slaba; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            alignment: start;
            Text { text: r.sursa; font-family: Tema.font-mono; font-size: 13px; color: Tema.text; vertical-alignment: center; }
            Text { text: "→"; font-family: Tema.font-mono; color: Tema.text-tert; vertical-alignment: center; }
            Text { text: r.baza; font-family: Tema.font-mono; font-size: 13px; color: Tema.text; vertical-alignment: center; }
            Text { text: r.server; font-family: Tema.font-mono; font-size: 11.5px; color: Tema.text-tert; vertical-alignment: center; overflow: elide; }
        }
        Text { width: 130px; text: r.cand; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; vertical-alignment: center; }
        Text { width: 200px; text: r.progres; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; vertical-alignment: center; overflow: elide; }
        // „Ignora": sterge progresul salvat al compararii
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: ig.preferred-width + 14px;
                height: 24px;
                border-radius: 6px;
                background: zig.has-hover ? Tema.linie : transparent;
                opacity: rand.has-hover ? 1 : 0;
                ig := Text { text: Texte.ignora; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-secundar; }
                zig := TouchArea { clicked => { root.ignora(); } }
            }
        }
        Text { width: 60px; text: Texte.continua; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.accent-text; horizontal-alignment: right; vertical-alignment: center; }
    }
    rand := TouchArea { clicked => { root.reia(); } }
}

export component FereastraConectare inherits Rectangle {
    // tastele vin aici cand ecranul devine vizibil (shell-ul cheama focus)
    forward-focus: taste;
    out property <string> titlu: "gmotion"; // text-permis: marca
    preferred-width: 1440px;
    preferred-height: 900px;
    // cele doua carduri, unul langa altul, cu campurile lor (C-S6)
    min-width: 860px;
    min-height: 560px;
    background: Tema.fundal;

    in property <ParteUi> sursa;
    in property <ParteUi> baza;
    in property <string> certificat;
    // gol, sau ca martorul si modificata sunt pe aceeasi instanta (15 F)
    in property <string> nota-instanta;
    // de ce n-a mers ultima comparare; gol cand a mers sau n-a rulat
    in property <string> eroare-comparare;
    in property <string> instantaneu;
    in property <[RecentaUi]> recente;
    // care recenta se arata pe ecranul de conectare, si daca e potrivita cu
    // ce e ales acum (altfel e doar cea mai noua)
    in property <int> recenta-aleasa;
    in property <bool> recenta-potrivita;
    /// Ce lipseste ca sa se poata compara; gol = se poate.
    in property <string> ce-lipseste;
    /// Ultimele linii din jurnalul aplicatiei, cea mai noua la sfarsit.
    in property <[LinieJurnalUi]> jurnal;
    /// Bifa „Aceeasi conexiune" de pe modificata.
    in property <bool> aceeasi-conexiune;
    /// Baza martorului, cum apare in lista modificatei, cand nu se poate
    /// alege acolo (conexiunea e aceeasi); altfel gol.
    in property <string> baza-blocata;
    /// 0 Conectare, 1 Sesiuni (comparatiile recente, toate).
    in-out property <int> tab;
    in-out property <bool> arata-setarile;

    callback server-schimbat(bool, string);
    callback auth-schimbat(bool, bool);
    callback utilizator-schimbat(bool, string);
    callback parola-schimbata(bool, string);
    callback baza-schimbata(bool, string);
    callback cere-bazele(bool);
    callback cauta-servere(bool);
    callback server-ales(bool, string);
    callback aceeasi-conexiune-comutata();
    callback schimba-certificatul();
    callback deschide-instantaneu();
    // fereastra de alegere a instantaneului: fisierele gasite pe disc si o
    // cale scrisa de mana
    in-out property <bool> alege-fisierul;
    callback alege-cu-dialogul();
    in property <[string]> instantanee;
    in-out property <string> cale-scrisa;
    callback alege-instantaneul(string);
    callback compara();
    callback anuleaza();
    callback testeaza(bool);
    callback sterge-jurnalul();
    callback deschide-offline();
    callback compara-offline(string, string);
    callback inchide-offline();
    callback ajutor();
    in property <string> text-ajutor;
    in-out property <bool> arata-ajutorul;
    // „Despre" (etapa 25): textul vine din Rust, in limba aleasa
    in property <string> text-despre;
    in-out property <bool> arata-despre;
    callback ignora-recenta(int);
    // fereastra de comparare offline: doua bucati de cod lipite
    in-out property <bool> offline;
    in-out property <string> offline-sursa;
    in-out property <string> offline-tinta;
    in property <string> offline-eroare;
    // compararea ruleaza pe alt fir: formularul se inlocuieste cu progresul
    in property <bool> ruleaza;
    in property <float> progres;
    in property <string> progres-text;
    in property <string> progres-timp;
    // etapele compararii, cu durata fiecareia
    in property <[EtapaUi]> etape;
    callback reia(int);
    callback alege-tema(bool);
    // comutatorul de limba: etichetele si indicele ales vin din Rust
    in property <[string]> limbi;
    in property <int> limba-aleasa;
    callback alege-limba(int);
    callback ecran-complet();
    // fereastra s-a redimensionat: Rust pune scara (`src/scara.rs`)
    callback dimensiune-schimbata();
    changed width => { root.dimensiune-schimbata(); }
    changed height => { root.dimensiune-schimbata(); }

    // sub 820 px (dupa scara) nu mai incap si comparatiile recente: raman in
    // tabul Sesiuni, iar spatiile se strang. Il pune Rust, odata cu scara:
    // calculat aici din `height`, ar fi o bucla (inaltimea vine din layout).
    in property <bool> scund;

    taste := FocusScope {
        key-pressed(e) => {
            // cat ruleaza compararea, restul e blocat: doar Esc (opreste)
            if (root.ruleaza) {
                if (e.text == Key.Escape) { root.anuleaza(); }
                return accept;
            }
            if (e.text == Key.F11) { root.ecran-complet(); return accept; }
            if (e.text == Key.F1) { root.arata-ajutorul = !root.arata-ajutorul; root.ajutor(); return accept; }
            if (e.text == Key.Escape && root.arata-ajutorul) { root.arata-ajutorul = false; return accept; }
            if (e.text == Key.Escape && root.arata-despre) { root.arata-despre = false; return accept; }
            if (e.text == Key.Escape && root.arata-setarile) { root.arata-setarile = false; return accept; }
            if (e.text == Key.Escape && root.offline) { root.inchide-offline(); return accept; }
            if (e.text == Key.Escape && root.alege-fisierul) { root.alege-fisierul = false; return accept; }
            if (e.text == Key.Escape && root.ruleaza) { root.anuleaza(); return accept; }
            if (e.modifiers.control && e.text == Key.Return && root.ce-lipseste == "" && !root.ruleaza) { root.compara(); return accept; }
            return reject;
        }
    VerticalLayout {
        Antet {
            // taburile Conectare / Sesiuni, in locul numelui ecranului
            HorizontalLayout {
                spacing: 4px;
                horizontal-stretch: 0;
                for t[i] in [Texte.conectare, Texte.sesiuni]: Rectangle {
                    width: tt.preferred-width + (i == 1 ? 40px : 20px);
                    tt := Text {
                        x: 10px;
                        text: t;
                        font-family: Tema.font-ui;
                        font-size: 13px;
                        color: root.tab == i ? Tema.text : Tema.text-secundar;
                    }
                    if i == 1: Rectangle {
                        x: tt.preferred-width + 16px;
                        y: (parent.height - 18px) / 2;
                        width: nr.preferred-width + 10px;
                        height: 18px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Tema.linie;
                        nr := Text { text: root.recente.length; font-family: Tema.font-mono; font-size: 11px; color: Tema.text-tert; }
                    }
                    if root.tab == i: Rectangle { y: parent.height - 2px; height: 2px; background: Tema.accent; }
                    TouchArea { clicked => { root.tab = i; } }
                }
            }
            // impinge restul la dreapta; spatiul din `Antet` ramane ~0
            Rectangle { horizontal-stretch: 1000; }
            VerticalLayout { alignment: center; Legatura { text: Texte.comparare-offline; apasat => { root.deschide-offline(); } } }
            VerticalLayout {
                alignment: center;
                Legatura {
                    text: root.instantaneu == "" ? Texte.deschide-instantaneu : root.instantaneu;
                    apasat => { root.deschide-instantaneu(); }
                }
            }
            VerticalLayout { alignment: center; Legatura { text: Texte.setari; apasat => { root.arata-setarile = true; } } }
            VerticalLayout { alignment: center; Legatura { text: Texte.ajutor-tasta; apasat => { root.arata-ajutorul = true; root.ajutor(); } } }
            VerticalLayout { alignment: center; ButonTema { alege(i) => { root.alege-tema(i); } } }
            VerticalLayout {
                alignment: center;
                ButonLimba { limbi: root.limbi; aleasa: root.limba-aleasa; alege(i) => { root.alege-limba(i); } }
            }
        }

        // corpul, cel mult 1760 px, centrat: pe un monitor lat nu se intinde
        HorizontalLayout {
            vertical-stretch: 1;
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                horizontal-stretch: 1000;
                max-width: 1760px;
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 16px;
                padding-bottom: 16px;
                spacing: 12px;

                // cele doua parti, jumatate fiecare: aceeasi latime preferata
                // (1px) si acelasi stretch, deci spatiul se imparte egal oricat
                // de lung e un mesaj (Mihai, 2026-11-19)
                if root.tab == 0: HorizontalLayout {
                    vertical-stretch: 3;
                    min-height: 300px;
                    max-height: 640px;
                    spacing: 16px;
                    martor := PanouParte {
                        preferred-width: 1px;
                        horizontal-stretch: 1;
                        p: root.sursa;
                        strans: root.scund;
                        fara-servere: root.instantaneu != "";
                        server-schimbat(t) => { root.server-schimbat(true, t); }
                        auth-schimbat(w) => { root.auth-schimbat(true, w); }
                        utilizator-schimbat(t) => { root.utilizator-schimbat(true, t); }
                        parola-schimbata(t) => { root.parola-schimbata(true, t); }
                        baza-aleasa(t) => { root.baza-schimbata(true, t); }
                        cere-bazele => { root.cere-bazele(true); }
                        testeaza => { root.testeaza(true); }
                        cauta-servere => { root.cauta-servere(true); }
                        server-ales(t) => { root.server-ales(true, t); }
                    }
                    PanouParte {
                        preferred-width: 1px;
                        horizontal-stretch: 1;
                        p: root.baza;
                        strans: root.scund;
                        are-bifa: true;
                        aceeasi: root.aceeasi-conexiune;
                        server-martor: root.sursa.server;
                        blocata: root.baza-blocata;
                        inaltime-aceeasi: martor.inaltime-conexiune;
                        fara-servere: root.instantaneu != "";
                        server-schimbat(t) => { root.server-schimbat(false, t); }
                        auth-schimbat(w) => { root.auth-schimbat(false, w); }
                        utilizator-schimbat(t) => { root.utilizator-schimbat(false, t); }
                        parola-schimbata(t) => { root.parola-schimbata(false, t); }
                        baza-aleasa(t) => { root.baza-schimbata(false, t); }
                        cere-bazele => { root.cere-bazele(false); }
                        testeaza => { root.testeaza(false); }
                        cauta-servere => { root.cauta-servere(false); }
                        server-ales(t) => { root.server-ales(false, t); }
                        aceeasi-comutat => { root.aceeasi-conexiune-comutata(); }
                    }
                }

                // tabul Sesiuni: toate comparatiile recente, in locul cardurilor
                if root.tab == 1: Card {
                    vertical-stretch: 3;
                    min-height: 300px;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 6px;
                        Text { text: Texte.comparari-recente; font-family: Tema.font-ui; font-size: 15px; font-weight: 600; color: Tema.text; }
                        if root.recente.length == 0: Text { text: Texte.nicio-comparare; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-tert; }
                        Rectangle {
                            vertical-stretch: 1;
                            lista-sesiuni := ListView {
                                for s[i] in root.recente: RandRecenta {
                                    r: s;
                                    reia => { root.tab = 0; root.reia(i); }
                                    ignora => { root.ignora-recenta(i); }
                                }
                            }
                            BaraDerulare {
                                x: parent.width - self.width;
                                height: parent.height;
                                pozitie <=> lista-sesiuni.content-y;
                                continut: lista-sesiuni.content-height;
                                vizibil: lista-sesiuni.visible-height;
                            }
                        }
                    }
                }

                // Compara la mijloc; cat ruleaza, progresul in locul lui
                if !root.ruleaza: VerticalLayout {
                    vertical-stretch: 0;
                    spacing: 6px;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            height: 42px;
                            width: 300px;
                            border-radius: 10px;
                            background: root.ce-lipseste == "" ? Tema.accent : Tema.strat;
                            opacity: root.ce-lipseste == "" && zp.has-hover ? 0.88 : 1;
                            Text {
                                text: Texte.compara;
                                font-family: Tema.font-ui;
                                font-size: 15px;
                                font-weight: 600;
                                color: root.ce-lipseste == "" ? Tema.pe-accent : Tema.text-tert;
                            }
                            zp := TouchArea {
                                enabled: root.ce-lipseste == "";
                                clicked => { root.compara(); }
                            }
                        }
                    }
                    Text {
                        text: root.ce-lipseste == "" ? Texte.doar-citire-mesaj : root.ce-lipseste;
                        font-family: Tema.font-ui;
                        font-size: 12px;
                        color: root.ce-lipseste == "" ? Tema.text-secundar : Tema.mod-text;
                        horizontal-alignment: center;
                    }
                    if root.eroare-comparare != "": Text {
                        text: root.eroare-comparare;
                        font-family: Tema.font-ui;
                        font-size: 12px;
                        color: Tema.del-text;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    if root.nota-instanta != "": Text {
                        text: root.nota-instanta;
                        font-family: Tema.font-ui;
                        font-size: 12px;
                        color: Tema.mod-text;
                        horizontal-alignment: center;
                    }
                }
                // ultima sesiune: cea potrivita cu ce e ales acum, altfel cea
                // mai noua; toate sunt in tabul Sesiuni (Mihai, 2026-11-25)
                if root.tab == 0 && !root.scund && root.recente.length > 0: VerticalLayout {
                    vertical-stretch: 0;
                    spacing: 8px;
                    HorizontalLayout {
                        height: 22px;
                        Text { text: root.recenta-potrivita ? Texte.sesiune-potrivita : Texte.ultima-sesiune; font-family: Tema.font-ui; font-size: 13px; font-weight: 600; color: Tema.text; vertical-alignment: center; horizontal-stretch: 1; }
                        Legatura {
                            height: 22px;
                            text: Texte.toate-sesiunile + " (" + root.recente.length + ") →";
                            culoare: Tema.accent-text;
                            marime: 12.5px;
                            apasat => { root.tab = 1; }
                        }
                    }
                    Card {
                        border-radius: 8px;
                        height: 38px;
                        clip: true;
                        RandRecenta {
                            y: 1px;
                            r: root.recente[root.recenta-aleasa];
                            reia => { root.reia(root.recenta-aleasa); }
                            ignora => { root.ignora-recenta(root.recenta-aleasa); }
                        }
                    }
                }

                // jurnalul: 1/4 din inaltime, cel putin cat patru randuri
                // (`LINII_JURNAL`), ca cel mai nou sa nu fie taiat
                VerticalLayout {
                    vertical-stretch: 1;
                    min-height: 130px;
                    spacing: 8px;
                    HorizontalLayout {
                        height: 22px;
                        spacing: 10px;
                        Text { text: Texte.jurnal; font-family: Tema.font-ui; font-size: 13px; font-weight: 600; color: Tema.text; vertical-alignment: center; }
                        Text { text: Texte.ce-face-aplicatia; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-tert; vertical-alignment: center; horizontal-stretch: 1; }
                        Legatura { height: 22px; text: Texte.sterge-log; marime: 12.5px; apasat => { root.sterge-jurnalul(); } }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Tema.linie;
                        background: Tema.cod-fundal;
                        clip: true;
                        VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 0px;
                            alignment: start;
                            if root.jurnal.length == 0: Text { text: Texte.inca-nimic; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-tert; }
                            for l in root.jurnal: Text {
                                height: 21px;
                                text: l.text;
                                font-family: Tema.font-mono;
                                font-size: 12px;
                                color: l.nivel == 3 ? Tema.del-text : l.nivel == 2 ? Tema.mod-text : Tema.text-secundar;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    }

    // ---- compararea offline: doua bucati de cod lipite, fara server
    if root.offline: Rectangle {
        background: Tema.intunecat ? #00000099 : #0f111566;
        TouchArea { }
        Rectangle {
            width: Math.min(root.width - 80px, 1000px);
            height: Math.min(root.height - 80px, 620px);
            border-radius: 14px;
            border-width: 1px;
            border-color: Tema.linie;
            background: Tema.suprafata;
            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                HorizontalLayout {
                    Text { text: Texte.comparare-offline; font-family: Tema.font-ui; font-size: 16px; font-weight: 600; color: Tema.text; horizontal-stretch: 1; }
                    Buton { text: Texte.inchide-esc; apasat => { root.inchide-offline(); } }
                }
                Text {
                    text: Texte.lipeste-codul;
                    font-family: Tema.font-ui;
                    font-size: 12.5px;
                    color: Tema.text-secundar;
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        Eticheta { text: Texte.martor; }
                        PanouCod { text <=> root.offline-sursa; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        Eticheta { text: Texte.modificata; }
                        PanouCod { text <=> root.offline-tinta; }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: root.offline-eroare;
                        font-family: Tema.font-ui;
                        font-size: 12.5px;
                        color: Tema.del-text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    ButonPrincipal {
                        text: Texte.compara;
                        apasat => { root.compara-offline(root.offline-sursa, root.offline-tinta); }
                    }
                }
            }
        }
    }

    // ---- Setari: deocamdata doar certificatul serverului (Mihai, 2026-11-19:
    // nu mai sta pe ecranul de conectare)
    if root.arata-setarile: Rectangle {
        background: Tema.intunecat ? #00000099 : #0f111566;
        TouchArea { clicked => { root.arata-setarile = false; } }
        Rectangle {
            width: Math.min(root.width - 80px, 560px);
            height: setari.preferred-height;
            border-radius: 14px;
            border-width: 1px;
            border-color: Tema.linie;
            background: Tema.suprafata;
            TouchArea { }
            setari := VerticalLayout {
                padding: 18px;
                spacing: 14px;
                HorizontalLayout {
                    Text { text: Texte.setari; font-family: Tema.font-ui; font-size: 16px; font-weight: 600; color: Tema.text; horizontal-stretch: 1; vertical-alignment: center; }
                    Buton { text: Texte.inchide-esc; apasat => { root.arata-setarile = false; } }
                }
                Rectangle { height: 1px; background: Tema.linie; }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Text { text: Texte.certificatul-serverului; font-family: Tema.font-ui; font-size: 13px; font-weight: 600; color: Tema.text; }
                        Text { text: root.certificat; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; wrap: word-wrap; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Buton { text: Texte.schimba; apasat => { root.schimba-certificatul(); } }
                    }
                }
            }
        }
    }

    if root.arata-ajutorul: Ajutor {
        text: root.text-ajutor;
        inchide => { root.arata-ajutorul = false; }
        despre => { root.arata-ajutorul = false; root.arata-despre = true; }
    }
    if root.arata-despre: Despre {
        text: root.text-despre;
        inchide => { root.arata-despre = false; }
    }

    // ---- „Deschide un instantaneu": fisierele gasite, sau o cale scrisa
    if root.alege-fisierul: Rectangle {
        background: Tema.intunecat ? #00000099 : #0f111566;
        TouchArea { clicked => { root.alege-fisierul = false; } }
        Rectangle {
            width: Math.min(root.width - 80px, 720px);
            height: Math.min(root.height - 80px, 480px);
            border-radius: 14px;
            border-width: 1px;
            border-color: Tema.linie;
            background: Tema.suprafata;
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                HorizontalLayout {
                    Text { text: Texte.deschide-instantaneu; font-family: Tema.font-ui; font-size: 16px; font-weight: 600; color: Tema.text; horizontal-stretch: 1; }
                    // dialogul nativ (etapa 25); lista de dedesubt ramane, pentru
                    // fisierele gasite deja
                    Buton { text: Texte.alege-fisierul; apasat => { root.alege-cu-dialogul(); } }
                    Buton { text: Texte.inchide-esc; apasat => { root.alege-fisierul = false; } }
                }
                if root.instantanee.length == 0: Text {
                    text: Texte.niciun-json;
                    font-family: Tema.font-ui;
                    font-size: 12.5px;
                    color: Tema.text-tert;
                    wrap: word-wrap;
                }
                ListView {
                    vertical-stretch: 1;
                    for f in root.instantanee: Rectangle {
                        height: 30px;
                        border-radius: 7px;
                        background: zf.has-hover ? Tema.strat : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            Text {
                                text: f;
                                font-family: Tema.font-mono;
                                font-size: 12.5px;
                                color: Tema.text;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        zf := TouchArea { clicked => { root.alege-instantaneul(f); } }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 34px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Tema.linie;
                        background: Tema.fundal;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            TextInput {
                                text <=> root.cale-scrisa;
                                font-family: Tema.font-mono;
                                font-size: 12.5px;
                                color: Tema.text;
                                vertical-alignment: center;
                                single-line: true;
                                accepted => { root.alege-instantaneul(self.text); }
                            }
                        }
                        if root.cale-scrisa == "": Text {
                            x: 12px;
                            text: Texte.sau-scrie-calea;
                            font-family: Tema.font-ui;
                            font-size: 12.5px;
                            color: Tema.text-tert;
                            vertical-alignment: center;
                        }
                    }
                    ButonPrincipal { text: Texte.deschide; apasat => { root.alege-instantaneul(root.cale-scrisa); } }
                }
            }
        }
    }

    init => { taste.focus(); }

    // ---- cat ruleaza compararea: tot restul e acoperit si nu raspunde (nici
    // tabul Sesiuni, nici setarile), iar in mijloc se vede unde a ajuns, cat
    // a durat fiecare etapa si cat a trecut (Mihai, 2026-11-25)
    if root.ruleaza: Rectangle {
        background: Tema.intunecat ? #000000a0 : #0f111570;
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 160ms; easing: ease-out; }
        TouchArea { }
        Rectangle {
            width: Math.min(root.width - 64px, 560px);
            height: progres-interior.preferred-height;
            border-radius: 14px;
            border-width: 1px;
            border-color: Tema.linie;
            background: Tema.suprafata;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000050;
            progres-interior := VerticalLayout {
                padding: 22px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 12px;
                    Rotitor { }
                    Text { text: Texte.compar-in-curs; font-family: Tema.font-ui; font-size: 16px; font-weight: 600; color: Tema.text; vertical-alignment: center; horizontal-stretch: 1; }
                    Text { text: root.progres-timp; font-family: Tema.font-mono; font-size: 13px; color: Tema.text-secundar; vertical-alignment: center; }
                }
                Rectangle {
                    height: 6px;
                    border-radius: 3px;
                    background: Tema.strat;
                    Rectangle {
                        x: 0;
                        width: parent.width * Math.max(0.03, root.progres);
                        border-radius: 3px;
                        background: Tema.accent;
                        animate width { duration: 300ms; easing: ease-out; }
                    }
                }
                Text { text: root.progres-text; font-family: Tema.font-ui; font-size: 13px; color: Tema.text; overflow: elide; }
                VerticalLayout {
                    spacing: 4px;
                    for e in root.etape: HorizontalLayout {
                        height: 22px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 9px;
                                height: 9px;
                                border-radius: 4.5px;
                                border-width: e.stare == 0 ? 1.3px : 0px;
                                border-color: Tema.text-tert;
                                background: e.stare == 2 ? Tema.add-bara : e.stare == 1 ? Tema.accent : transparent;
                            }
                        }
                        Text { text: e.nume; font-family: Tema.font-ui; font-size: 12.5px; color: e.stare == 0 ? Tema.text-tert : Tema.text; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: e.durata; font-family: Tema.font-mono; font-size: 12px; color: Tema.text-secundar; vertical-alignment: center; }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Buton { text: Texte.opreste; apasat => { root.anuleaza(); } }
                }
            }
        }
    }

}
