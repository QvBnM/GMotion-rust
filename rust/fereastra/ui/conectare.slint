// Ecranul de conectare: ce se compara cu ce. Dupa schita aprobata
// (`cercetare/schita-slint/ui/conectare.slint`), pe jetoanele din `Tema`:
// cele doua parti ca doua carduri, cautarea serverelor ca iconita in camp,
// jurnalul ca banda jos.
//
// Se strica astfel: butonul „Compara" pare apasabil cand lipseste ceva (si
// omul afla abia dupa ce asteapta conectarea), sau parola ajunge unde nu
// trebuie. Primul se decide in `src/model_conectare.rs` (testat fara
// fereastra); al doilea tine de tipul care o pastreaza, fara `Debug` derivat.

import { ListView } from "std-widgets.slint";
import { Tema, Chevron, Buton, ButonPrincipal, Antet, ButonTema, EticMediu, Card } from "comune.slint";

export struct ParteUi {
    eticheta: string,
    rol: string,
    mediu: string,
    cod-mediu: int,
    server: string,
    auth-windows: bool,
    utilizator: string,
    parola: string,
    // ce scrie in camp: baza aleasa sau, la cele bifate, toate
    baza: string,
    baze: [string],
    // partea comparata: bazele se bifeaza (una sau mai multe)
    multipla: bool,
    // paralel cu `baze`: bifata sau nu
    bifate: [bool],
    stare: string,
    // 0 neincercat, 1 se conecteaza, 2 conectat, 3 eroare
    fel-stare: int,
    // instantele gasite in retea, de ales cu un clic
    servere-gasite: [string],
}

export struct RecentaUi {
    sursa: string,
    baza: string,
    mediu: string,
    cod-mediu: int,
    cand: string,
    progres: string,
}

// o linie din jurnalul aplicatiei; nivel: 0 info, 2 atentie, 3 eroare
export struct LinieJurnalUi {
    nivel: int,
    text: string,
}

component Eticheta inherits Text {
    font-family: Tema.font-ui;
    font-size: 12px;
    color: Tema.text-secundar;
}

// Camp de text, adancit in card. Cu `cauta`, are lupa in dreapta.
component Camp inherits Rectangle {
    in property <string> text;
    in property <bool> mono: false;
    in property <bool> ascuns: false;
    in property <string> gol;
    in property <bool> cauta: false;
    callback schimbat(string);
    callback la-cautare();
    height: 36px;
    border-radius: 8px;
    border-width: 1px;
    border-color: intrare.has-focus ? Tema.accent : Tema.linie;
    background: Tema.fundal;
    forward-focus: intrare;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: root.cauta ? 4px : 12px;
        spacing: 6px;
        intrare := TextInput {
            text: root.text;
            font-family: root.mono ? Tema.font-mono : Tema.font-ui;
            font-size: 13px;
            color: Tema.text;
            vertical-alignment: center;
            single-line: true;
            input-type: root.ascuns ? InputType.password : InputType.text;
            edited => { root.schimbat(self.text); }
        }
        if root.cauta: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 7px;
                background: lupa.has-hover ? Tema.strat : transparent;
                // lupa peste trei puncte: „cauta in retea"
                Path {
                    width: 16px; height: 16px; viewbox-width: 16; viewbox-height: 16;
                    commands: "M 7 2 A 5 5 0 1 1 6.99 2 M 10.6 10.6 L 14.2 14.2";
                    stroke: lupa.has-hover ? Tema.accent-text : Tema.text-secundar; stroke-width: 1.6px; fill: transparent;
                }
                Path {
                    width: 16px; height: 16px; viewbox-width: 16; viewbox-height: 16;
                    commands: "M 4.3 7 A 0.9 0.9 0 1 1 4.29 7 M 7 7 A 0.9 0.9 0 1 1 6.99 7 M 9.7 7 A 0.9 0.9 0 1 1 9.69 7";
                    fill: lupa.has-hover ? Tema.accent-text : Tema.text-secundar;
                }
                lupa := TouchArea { clicked => { root.la-cautare(); } }
            }
        }
    }
    if root.text == "" && !intrare.has-focus && root.gol != "": Text {
        x: 12px;
        text: root.gol;
        font-family: Tema.font-ui;
        font-size: 13px;
        color: Tema.text-tert;
        vertical-alignment: center;
    }
}

// Alegerea dintr-o lista scurta (bazele). Deschisa, arata optiunile sub camp,
// peste restul ecranului.
component Alegere inherits Rectangle {
    in property <string> ales;
    in property <[string]> optiuni;
    // cu bife: clicul bifeaza / debifeaza, lista ramane deschisa
    in property <bool> multipla;
    in property <[bool]> bifate;
    in property <string> gol: "—";
    callback schimbat(string);
    /// Lista e goala: cineva trebuie sa o umple (adica sa se conecteze).
    callback cerut();
    height: 36px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tema.linie;
    background: zona.has-hover ? Tema.strat : Tema.fundal;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Text {
            horizontal-stretch: 1;
            text: root.ales == "" ? root.gol : root.ales;
            font-family: root.ales == "" ? Tema.font-ui : Tema.font-mono;
            font-size: 13px;
            color: root.ales == "" ? Tema.text-tert : Tema.text;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Chevron { drum: "M 3 6 L 8 11 L 13 6"; culoare: Tema.text-secundar; }
        }
    }
    zona := TouchArea {
        clicked => {
            if (root.optiuni.length == 0) {
                root.cerut();
            } else {
                lista.show();
            }
        }
    }
    lista := PopupWindow {
        // fara bife, lista se inchide la alegere (in `clicked`, mai jos)
        close-policy: PopupClosePolicy.close-on-click-outside;
        y: root.height + 4px;
        width: root.width;
        height: Math.min(240px, root.optiuni.length * 32px + 10px);
        Rectangle {
            border-radius: 10px;
            border-width: 1px;
            border-color: Tema.linie;
            background: Tema.suprafata;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Tema.intunecat ? #00000080 : #0f111526;
            ListView {
                x: 5px;
                y: 5px;
                width: parent.width - 10px;
                height: parent.height - 10px;
                for o[i] in root.optiuni: Rectangle {
                    height: 32px;
                    border-radius: 7px;
                    background: optiune.has-hover ? Tema.strat : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 8px;
                        if root.multipla: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 16px;
                                height: 16px;
                                border-radius: 4px;
                                border-width: root.bifate[i] ? 0 : 1.5px;
                                border-color: Tema.text-tert;
                                background: root.bifate[i] ? Tema.accent : transparent;
                                if root.bifate[i]: Path {
                                    width: 12px; height: 12px; viewbox-width: 12; viewbox-height: 12;
                                    stroke: Tema.pe-accent; stroke-width: 2px; fill: transparent;
                                    commands: "M 2.5 6.2 L 5 8.6 L 9.6 3.4";
                                }
                            }
                        }
                        Text {
                            text: o;
                            font-family: Tema.font-mono;
                            font-size: 13px;
                            color: Tema.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    optiune := TouchArea {
                        clicked => {
                            root.schimbat(o);
                            if (!root.multipla) {
                                lista.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

// SQL Server / Windows, ca un comutator in doua.
component Segment inherits Rectangle {
    in property <bool> windows;
    callback ales(bool);
    height: 36px;
    border-radius: 9px;
    background: Tema.fundal;
    border-width: 1px;
    border-color: Tema.linie;
    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for o[i] in ["SQL Server", "Windows"]: Rectangle {
            property <bool> pornit: (i == 1) == root.windows;
            border-radius: 7px;
            background: self.pornit ? Tema.strat : transparent;
            Text {
                text: o;
                font-family: Tema.font-ui;
                font-size: 13px;
                font-weight: parent.pornit ? 600 : 400;
                color: parent.pornit ? Tema.text : Tema.text-secundar;
            }
            TouchArea { clicked => { root.ales(i == 1); } }
        }
    }
}

// O parte (Sursa sau Baza), ca un card cu campurile ei.
component PanouParte inherits Card {
    in property <ParteUi> p;
    in property <bool> fara-servere;
    callback server-schimbat(string);
    callback auth-schimbat(bool);
    callback utilizator-schimbat(string);
    callback parola-schimbata(string);
    callback baza-schimbata(string);
    callback cere-bazele();
    callback cauta-servere();
    callback server-ales(string);

    VerticalLayout {
        padding: 20px;
        spacing: 11px;
        alignment: start;

        HorizontalLayout {
            spacing: 10px;
            Text { text: p.eticheta; font-family: Tema.font-ui; font-size: 18px; font-weight: 600; color: Tema.text; vertical-alignment: center; letter-spacing: -0.3px; }
            Text { text: p.rol; font-family: Tema.font-ui; font-size: 13px; color: Tema.text-secundar; vertical-alignment: center; horizontal-stretch: 1; }
            VerticalLayout { alignment: center; EticMediu { mediu: p.cod-mediu; } }
        }

        if !root.fara-servere: Segment {
            windows: p.auth-windows;
            ales(w) => { root.auth-schimbat(w); }
        }
        if !root.fara-servere: VerticalLayout {
            spacing: 5px;
            Eticheta { text: "Server SQL"; }
            Camp {
                text: p.server;
                mono: true;
                cauta: true;
                gol: "SRV\\INSTANTA sau srv.domeniu.local,1433";
                schimbat(t) => { root.server-schimbat(t); }
                la-cautare => { root.cauta-servere(); }
            }
        }
        // ce a gasit cautarea in retea; un clic pune serverul in camp
        if !root.fara-servere && p.servere-gasite.length > 0: Rectangle {
            height: gasite.preferred-height;
            border-radius: 10px;
            border-width: 1px;
            border-color: Tema.linie;
            background: Tema.fundal;
            gasite := VerticalLayout {
                padding: 4px;
                for s in p.servere-gasite: Rectangle {
                    height: 28px;
                    border-radius: 7px;
                    background: zs.has-hover ? Tema.strat : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        Text { text: s; font-family: Tema.font-mono; font-size: 12.5px; color: Tema.text; vertical-alignment: center; overflow: elide; }
                    }
                    zs := TouchArea { clicked => { root.server-ales(s); } }
                }
            }
        }
        if !root.fara-servere && !p.auth-windows: HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                spacing: 6px;
                Eticheta { text: "Utilizator"; }
                Camp {
                    text: p.utilizator;
                    schimbat(t) => { root.utilizator-schimbat(t); }
                }
            }
            VerticalLayout {
                spacing: 6px;
                Eticheta { text: "Parola"; }
                Camp {
                    text: p.parola;
                    ascuns: true;
                    schimbat(t) => { root.parola-schimbata(t); }
                }
            }
        }
        VerticalLayout {
            spacing: 6px;
            Eticheta { text: "Baza"; }
            Alegere {
                ales: p.baza;
                optiuni: p.baze;
                multipla: p.multipla;
                bifate: p.bifate;
                gol: root.fara-servere ? "alege baza" : "conecteaza-te intai";
                schimbat(t) => { root.baza-schimbata(t); }
                cerut => { root.cere-bazele(); }
            }
        }
        if p.stare != "": HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: p.fel-stare == 3 ? Tema.del-bara : p.fel-stare == 2 ? Tema.add-bara : Tema.text-tert;
                }
            }
            Text {
                text: p.stare;
                font-family: Tema.font-ui;
                font-size: 12.5px;
                color: p.fel-stare == 3 ? Tema.del-text : p.fel-stare == 2 ? Tema.add-text : Tema.text-secundar;
                vertical-alignment: center;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
        }
    }
}

export component FereastraConectare inherits Window {
    title: "gmotion";
    preferred-width: 1440px;
    preferred-height: 900px;
    background: Tema.fundal;
    default-font-family: Tema.font-ui;
    default-font-size: 13px;

    in property <ParteUi> sursa;
    in property <ParteUi> baza;
    in property <string> certificat;
    in property <string> instantaneu;
    in property <[RecentaUi]> recente;
    /// Ce lipseste ca sa se poata compara; gol = se poate.
    in property <string> ce-lipseste;
    in property <int> mediu: 0;
    // compararea pornita: progresul inlocuieste pornirea, formularul e blocat
    in property <bool> ruleaza;
    in property <float> progres;            // 0..1
    in property <string> progres-text;      // „Citesc CharismaProd (1 din 2)..."
    in property <string> progres-timp;      // „0:07"
    /// Ultimele linii din jurnalul aplicatiei, cea mai noua la sfarsit.
    in property <[LinieJurnalUi]> jurnal;
    in-out property <bool> jurnal-ascuns: false;

    callback server-schimbat(bool, string);
    callback auth-schimbat(bool, bool);
    callback utilizator-schimbat(bool, string);
    callback parola-schimbata(bool, string);
    callback baza-schimbata(bool, string);
    callback cere-bazele(bool);
    callback cauta-servere(bool);
    callback server-ales(bool, string);
    callback inverseaza();
    callback schimba-certificatul();
    callback deschide-instantaneu();
    callback compara();
    callback anuleaza();
    callback reia(int);
    callback alege-tema(bool);

    VerticalLayout {
        Antet {
            loc: "Conectare";
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 32px;
                    width: inst.preferred-width + 24px;
                    border-radius: 8px;
                    background: zi.has-hover ? Tema.strat : transparent;
                    inst := Text {
                        text: root.instantaneu == "" ? "Deschide un instantaneu" : root.instantaneu;
                        font-family: root.instantaneu == "" ? Tema.font-ui : Tema.font-mono;
                        font-size: 13px;
                        color: Tema.text-secundar;
                    }
                    zi := TouchArea { clicked => { root.deschide-instantaneu(); } }
                }
            }
            VerticalLayout { alignment: center; ButonTema { alege(i) => { root.alege-tema(i); } } }
        }

        // corpul
        VerticalLayout {
            vertical-stretch: 1;
            padding: 22px;
            padding-bottom: 16px;
            spacing: 14px;

            // cele doua parti, cu inversarea intre ele; cat ruleaza compararea,
            // blocate (un strat deasupra prinde clicurile)
            Rectangle {
                vertical-stretch: 0;
                opacity: root.ruleaza ? 0.55 : 1;
            HorizontalLayout {
                spacing: 0px;
                PanouParte {
                    horizontal-stretch: 1;
                    p: root.sursa;
                    fara-servere: root.instantaneu != "";
                    server-schimbat(t) => { root.server-schimbat(true, t); }
                    auth-schimbat(w) => { root.auth-schimbat(true, w); }
                    utilizator-schimbat(t) => { root.utilizator-schimbat(true, t); }
                    parola-schimbata(t) => { root.parola-schimbata(true, t); }
                    baza-schimbata(t) => { root.baza-schimbata(true, t); }
                    cere-bazele => { root.cere-bazele(true); }
                    cauta-servere => { root.cauta-servere(true); }
                    server-ales(t) => { root.server-ales(true, t); }
                }
                VerticalLayout {
                    width: 56px;
                    alignment: start;
                    padding-top: 22px;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 17px;
                            border-width: 1px;
                            border-color: Tema.linie;
                            background: inv.has-hover ? Tema.strat : Tema.suprafata;
                            Path {
                                width: 14px; height: 14px; viewbox-width: 16; viewbox-height: 16;
                                commands: "M 2 5 L 13 5 M 10 2 L 13 5 L 10 8 M 14 11 L 3 11 M 6 8 L 3 11 L 6 14";
                                stroke: Tema.text-secundar; stroke-width: 1.5px; fill: transparent;
                            }
                            inv := TouchArea { clicked => { root.inverseaza(); } }
                        }
                    }
                }
                PanouParte {
                    horizontal-stretch: 1;
                    p: root.baza;
                    fara-servere: root.instantaneu != "";
                    server-schimbat(t) => { root.server-schimbat(false, t); }
                    auth-schimbat(w) => { root.auth-schimbat(false, w); }
                    utilizator-schimbat(t) => { root.utilizator-schimbat(false, t); }
                    parola-schimbata(t) => { root.parola-schimbata(false, t); }
                    baza-schimbata(t) => { root.baza-schimbata(false, t); }
                    cere-bazele => { root.cere-bazele(false); }
                    cauta-servere => { root.cauta-servere(false); }
                    server-ales(t) => { root.server-ales(false, t); }
                }
            }
            if root.ruleaza: TouchArea { }
            }

            // progresul, cat ruleaza compararea: in locul pornirii
            if root.ruleaza: VerticalLayout {
                vertical-stretch: 0;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: root.progres-text;
                        font-family: Tema.font-ui;
                        font-size: 13px;
                        color: Tema.text;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: root.progres-timp;
                        font-family: Tema.font-mono;
                        font-size: 12px;
                        color: Tema.text-secundar;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        Buton { text: "Anuleaza"; apasat => { root.anuleaza(); } }
                    }
                }
                Rectangle {
                    height: 6px;
                    border-radius: 3px;
                    background: Tema.strat;
                    Rectangle {
                        x: 0;
                        width: parent.width * root.progres;
                        border-radius: 3px;
                        background: Tema.accent;
                    }
                }
            }

            // certificatul si pornirea
            if !root.ruleaza: HorizontalLayout {
                vertical-stretch: 0;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Text { text: root.certificat; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Rectangle {
                        // pe un instantaneu nu exista server, deci nici certificat
                        visible: root.certificat != "";
                        height: 24px;
                        width: schimba.preferred-width + 12px;
                        border-radius: 6px;
                        background: zc.has-hover ? Tema.strat : transparent;
                        schimba := Text { text: "Schimba"; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.accent-text; }
                        zc := TouchArea { clicked => { root.schimba-certificatul(); } }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Text {
                        text: root.ce-lipseste == "" ? "Se citeste, nu se scrie nimic." : root.ce-lipseste;
                        font-family: Tema.font-ui;
                        font-size: 12.5px;
                        color: root.ce-lipseste == "" ? Tema.text-secundar : Tema.mod-text;
                    }
                }
                // butonul mare: activ doar cand nu lipseste nimic
                Rectangle {
                    height: 48px;
                    width: 220px;
                    border-radius: 12px;
                    background: root.ce-lipseste == "" ? Tema.accent : Tema.strat;
                    opacity: root.ce-lipseste == "" && zp.has-hover ? 0.88 : 1;
                    Text {
                        text: "Compara";
                        font-family: Tema.font-ui;
                        font-size: 15px;
                        font-weight: 600;
                        color: root.ce-lipseste == "" ? Tema.pe-accent : Tema.text-tert;
                    }
                    zp := TouchArea {
                        enabled: root.ce-lipseste == "";
                        clicked => { root.compara(); }
                    }
                }
            }

            // compararile recente, reluabile
            Card {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 14px;
                    padding-left: 18px;
                    padding-top: 12px;
                    spacing: 4px;
                    Text { text: "Comparari recente"; font-family: Tema.font-ui; font-size: 13px; font-weight: 600; color: Tema.text; }
                    if root.recente.length == 0: Text {
                        text: "Nicio comparare salvata inca. Dupa prima, o reiei de aici cu un clic.";
                        font-family: Tema.font-ui;
                        font-size: 12.5px;
                        color: Tema.text-tert;
                    }
                    ListView {
                        vertical-stretch: 1;
                        for s[i] in root.recente: Rectangle {
                            height: 34px;
                            border-radius: 8px;
                            background: rand.has-hover ? Tema.strat : transparent;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 12px;
                                HorizontalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 8px;
                                    alignment: start;
                                    Text { text: s.sursa; font-family: Tema.font-mono; font-size: 12.5px; color: Tema.text; vertical-alignment: center; }
                                    Text { text: "→"; font-family: Tema.font-mono; color: Tema.text-tert; vertical-alignment: center; }
                                    Text { text: s.baza; font-family: Tema.font-mono; font-size: 12.5px; color: Tema.text; vertical-alignment: center; }
                                    VerticalLayout { alignment: center; EticMediu { mediu: s.cod-mediu; } }
                                }
                                Text { width: 160px; text: s.cand; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; vertical-alignment: center; }
                                Text { width: 220px; text: s.progres; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; vertical-alignment: center; overflow: elide; }
                                Text { width: 80px; text: "Continua"; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.accent-text; horizontal-alignment: right; vertical-alignment: center; }
                            }
                            rand := TouchArea { clicked => { root.reia(i); } }
                        }
                    }
                }
            }
        }

        // jurnalul: o banda jos, pe toata latimea, din jurnalul aplicatiei
        Rectangle {
            height: root.jurnal-ascuns ? 40px : 132px;
            background: Tema.suprafata;
            Rectangle { y: 0; height: 1px; background: Tema.linie; }
            VerticalLayout {
                padding-left: 24px;
                padding-right: 16px;
                padding-top: 6px;
                padding-bottom: 10px;
                spacing: 6px;
                HorizontalLayout {
                    height: 28px;
                    spacing: 12px;
                    Text { text: "Jurnal"; font-family: Tema.font-ui; font-size: 13px; font-weight: 600; color: Tema.text; vertical-alignment: center; }
                    Text { text: "ce face aplicatia, pas cu pas"; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-tert; vertical-alignment: center; horizontal-stretch: 1; }
                    Rectangle {
                        width: ta.preferred-width + 20px;
                        border-radius: 7px;
                        background: zj.has-hover ? Tema.strat : transparent;
                        ta := Text { text: root.jurnal-ascuns ? "Arata" : "Ascunde"; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; }
                        zj := TouchArea { clicked => { root.jurnal-ascuns = !root.jurnal-ascuns; } }
                    }
                }
                if !root.jurnal-ascuns: VerticalLayout {
                    spacing: 2px;
                    alignment: start;
                    if root.jurnal.length == 0: Text { text: "Inca nimic."; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-tert; }
                    for l in root.jurnal: HorizontalLayout {
                        height: 18px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: l.nivel == 3 ? Tema.del-bara : l.nivel == 2 ? Tema.mod-bara : Tema.text-tert;
                            }
                        }
                        Text {
                            text: l.text;
                            font-family: Tema.font-mono;
                            font-size: 11.5px;
                            color: l.nivel == 3 ? Tema.del-text : l.nivel == 2 ? Tema.mod-text : Tema.text-secundar;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}
