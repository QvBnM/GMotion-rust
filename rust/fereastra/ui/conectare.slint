// Ecranul de conectare: ce se compara cu ce. Dupa schita aprobata
// (`cercetare/schita-slint/ui/conectare.slint`), pe jetoanele din `Tema`:
// cele doua parti ca doua carduri, cautarea serverelor ca iconita in camp,
// jurnalul ca banda jos.
//
// Se strica astfel: butonul „Compara" pare apasabil cand lipseste ceva (si
// omul afla abia dupa ce asteapta conectarea), sau parola ajunge unde nu
// trebuie. Primul se decide in `src/model_conectare.rs` (testat fara
// fereastra); al doilea tine de tipul care o pastreaza, fara `Debug` derivat.

import { ListView } from "std-widgets.slint";
import { Texte, Tema, ButonLimba, Chevron, Buton, ButonPrincipal, Antet, ButonTema, Card, Ajutor } from "comune.slint";

// Un server gasit in retea, cu etichetele din raspunsul SSRP.
export struct ServerGasitUi {
    nume: string,
    cluster: bool,
    implicita: bool,
}

export struct ParteUi {
    eticheta: string,
    rol: string,
    server: string,
    auth-windows: bool,
    utilizator: string,
    parola: string,
    baza: string,
    baze: [string],
    // bifele bazelor, in aceeasi ordine ca `baze`
    alese: [bool],
    // ce scrie in camp: „Client1" sau „3 baze"
    eticheta-baze: string,
    stare: string,
    // 0 neincercat, 1 se conecteaza, 2 conectat, 3 eroare
    fel-stare: int,
    // instantele gasite in retea, de ales cu un clic
    servere-gasite: [ServerGasitUi],
}


export struct RecentaUi {
    sursa: string,
    baza: string,
    cand: string,
    progres: string,
}

// o linie din jurnalul aplicatiei; nivel: 0 info, 2 atentie, 3 eroare
export struct LinieJurnalUi {
    nivel: int,
    text: string,
}

// Eticheta mica de langa un server gasit (IMPLICITA / CLUSTER).
component EticServer inherits Rectangle {
    in property <string> text;
    in property <color> culoare: Tema.text-tert;
    height: 18px;
    width: et.preferred-width + 12px;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.culoare;
    et := Text {
        text: root.text;
        font-family: Tema.font-mono;
        font-size: 10px;
        font-weight: 500;
        color: root.culoare;
        letter-spacing: 0.4px;
    }
}

// Un panou de cod lipit, pentru compararea offline.
component PanouCod inherits Rectangle {
    in-out property <string> text;
    vertical-stretch: 1;
    border-radius: 10px;
    border-width: 1px;
    border-color: Tema.linie;
    background: Tema.cod-fundal;
    clip: true;
    Flickable {
        x: 10px;
        y: 8px;
        width: parent.width - 20px;
        height: parent.height - 16px;
        TextInput {
            text <=> root.text;
            font-family: Tema.font-mono;
            font-size: 12.5px;
            color: Tema.text;
            wrap: no-wrap;
            single-line: false;
        }
    }
}

component Eticheta inherits Text {
    font-family: Tema.font-ui;
    font-size: 12px;
    color: Tema.text-secundar;
}

// Camp de text, adancit in card. Cu `cauta`, are lupa in dreapta.
component Camp inherits Rectangle {
    in property <string> text;
    // Legatura `text: root.text` de pe `intrare` se rupe la prima tasta: din
    // momentul ala campul isi tine textul lui si nu mai urmeaza modelul. Deci
    // cand modelul se schimba din Rust (Inverseaza, un server ales din
    // cautare), textul se rescrie explicit (F-A2 din auditul QA).
    changed text => {
        // Campul de parola face exceptie: modelul nu-i da continutul, doar
        // buline cat lungimea lui. Rescris cu ele, prima tasta de dupa ar
        // trimite bulinele ca parola. Se goleste doar cand modelul spune ca
        // nu exista nicio parola (Deconecteaza, Inverseaza spre o parte fara
        // parola).
        if (root.ascuns) {
            if (root.text == "" && intrare.text != "") { intrare.text = ""; }
        } else if (intrare.text != root.text) {
            intrare.text = root.text;
        }
    }
    in property <bool> mono: false;
    in property <bool> ascuns: false;
    in property <string> gol;
    in property <bool> cauta: false;
    callback schimbat(string);
    callback la-cautare();
    height: 36px;
    border-radius: 8px;
    border-width: 1px;
    border-color: intrare.has-focus ? Tema.accent : Tema.linie;
    background: Tema.fundal;
    forward-focus: intrare;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: root.cauta ? 4px : 12px;
        spacing: 6px;
        intrare := TextInput {
            text: root.text;
            font-family: root.mono ? Tema.font-mono : Tema.font-ui;
            font-size: 13px;
            color: Tema.text;
            vertical-alignment: center;
            single-line: true;
            input-type: root.ascuns ? InputType.password : InputType.text;
            edited => { root.schimbat(self.text); }
        }
        if root.cauta: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 7px;
                background: lupa.has-hover ? Tema.strat : transparent;
                // lupa peste trei puncte: „cauta in retea"
                Path {
                    width: 16px; height: 16px; viewbox-width: 16; viewbox-height: 16;
                    commands: "M 7 2 A 5 5 0 1 1 6.99 2 M 10.6 10.6 L 14.2 14.2";
                    stroke: lupa.has-hover ? Tema.accent-text : Tema.text-secundar; stroke-width: 1.6px; fill: transparent;
                }
                Path {
                    width: 16px; height: 16px; viewbox-width: 16; viewbox-height: 16;
                    commands: "M 4.3 7 A 0.9 0.9 0 1 1 4.29 7 M 7 7 A 0.9 0.9 0 1 1 6.99 7 M 9.7 7 A 0.9 0.9 0 1 1 9.69 7";
                    fill: lupa.has-hover ? Tema.accent-text : Tema.text-secundar;
                }
                lupa := TouchArea { clicked => { root.la-cautare(); } }
            }
        }
    }
    if root.text == "" && !intrare.has-focus && root.gol != "": Text {
        x: 12px;
        text: root.gol;
        font-family: Tema.font-ui;
        font-size: 13px;
        color: Tema.text-tert;
        vertical-alignment: center;
    }
}

// Alegerea dintr-o lista scurta (bazele). Deschisa, arata optiunile sub camp,
// peste restul ecranului.
component Alegere inherits Rectangle {
    in property <string> ales;
    in property <[string]> optiuni;
    in property <string> gol: "—";
    // bifare multipla: lista ramane deschisa si fiecare optiune are bifa
    in property <bool> multiplu;
    // bifele, in aceeasi ordine ca `optiuni` (Slint n-are cautare in liste)
    in property <[bool]> bifate;
    callback schimbat(string);
    /// Lista e goala: cineva trebuie sa o umple (adica sa se conecteze).
    callback cerut();
    height: 36px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tema.linie;
    background: zona.has-hover ? Tema.strat : Tema.fundal;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Text {
            horizontal-stretch: 1;
            text: root.ales == "" ? root.gol : root.ales;
            font-family: root.ales == "" ? Tema.font-ui : Tema.font-mono;
            font-size: 13px;
            color: root.ales == "" ? Tema.text-tert : Tema.text;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Chevron { drum: "M 3 6 L 8 11 L 13 6"; culoare: Tema.text-secundar; }
        }
    }
    zona := TouchArea {
        clicked => {
            if (root.optiuni.length == 0) {
                root.cerut();
            } else {
                lista.show();
            }
        }
    }
    lista := PopupWindow {
        y: root.height + 4px;
        width: root.width;
        height: Math.min(240px, root.optiuni.length * 32px + 10px);
        Rectangle {
            border-radius: 10px;
            border-width: 1px;
            border-color: Tema.linie;
            background: Tema.suprafata;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Tema.intunecat ? #00000080 : #0f111526;
            ListView {
                x: 5px;
                y: 5px;
                width: parent.width - 10px;
                height: parent.height - 10px;
                for o[i] in root.optiuni: Rectangle {
                    height: 32px;
                    border-radius: 7px;
                    background: optiune.has-hover ? Tema.strat : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        if root.multiplu: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 15px;
                                height: 15px;
                                border-radius: 4px;
                                border-width: 1.5px;
                                border-color: root.bifate[i] ? Tema.accent : Tema.linie;
                                background: root.bifate[i] ? Tema.accent : transparent;
                                if root.bifate[i]: Path {
                                    width: 11px; height: 11px; viewbox-width: 16; viewbox-height: 16;
                                    commands: "M 3 8.5 L 6 11.5 L 13 4.5";
                                    stroke: Tema.pe-accent; stroke-width: 2.4px; fill: transparent;
                                }
                            }
                        }
                        Text {
                            text: o;
                            font-family: Tema.font-mono;
                            font-size: 13px;
                            color: Tema.text;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                    // la bifare multipla lista ramane deschisa: altfel ar
                    // trebui redeschisa pentru fiecare baza
                    optiune := TouchArea { clicked => { root.schimbat(o); } }
                }
            }
        }
    }
}

// SQL Server / Windows, ca un comutator in doua.
component Segment inherits Rectangle {
    in property <bool> windows;
    callback ales(bool);
    height: 36px;
    border-radius: 9px;
    background: Tema.fundal;
    border-width: 1px;
    border-color: Tema.linie;
    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for o[i] in ["SQL Server", "Windows"]: Rectangle {
            property <bool> pornit: (i == 1) == root.windows;
            border-radius: 7px;
            background: self.pornit ? Tema.strat : transparent;
            Text {
                text: o;
                font-family: Tema.font-ui;
                font-size: 13px;
                font-weight: parent.pornit ? 600 : 400;
                color: parent.pornit ? Tema.text : Tema.text-secundar;
            }
            TouchArea { clicked => { root.ales(i == 1); } }
        }
    }
}

// O parte (Sursa sau Baza), ca un card cu campurile ei.
component PanouParte inherits Card {
    in property <ParteUi> p;
    in property <bool> fara-servere;
    // partea „baza": se pot bifa mai multe baze deodata
    in property <bool> multiplu;
    callback server-schimbat(string);
    callback auth-schimbat(bool);
    callback utilizator-schimbat(string);
    callback parola-schimbata(string);
    callback baza-schimbata(string);
    callback cere-bazele();
    callback testeaza();
    callback cauta-servere();
    callback server-ales(string);

    VerticalLayout {
        padding: 20px;
        spacing: 11px;
        alignment: start;

        HorizontalLayout {
            spacing: 10px;
            Text { text: p.eticheta; font-family: Tema.font-ui; font-size: 18px; font-weight: 600; color: Tema.text; vertical-alignment: center; letter-spacing: -0.3px; }
            Text { text: p.rol; font-family: Tema.font-ui; font-size: 13px; color: Tema.text-secundar; vertical-alignment: center; horizontal-stretch: 1; }
        }

        if !root.fara-servere: Segment {
            windows: p.auth-windows;
            ales(w) => { root.auth-schimbat(w); }
        }
        if !root.fara-servere: VerticalLayout {
            spacing: 5px;
            Eticheta { text: Texte.server-sql; }
            Camp {
                text: p.server;
                mono: true;
                cauta: true;
                gol: "SRV\\INSTANTA sau srv.domeniu.local,1433";
                schimbat(t) => { root.server-schimbat(t); }
                la-cautare => { root.cauta-servere(); }
            }
        }
        // ce a gasit cautarea in retea; un clic pune serverul in camp
        if !root.fara-servere && p.servere-gasite.length > 0: Rectangle {
            height: gasite.preferred-height;
            border-radius: 10px;
            border-width: 1px;
            border-color: Tema.linie;
            background: Tema.fundal;
            gasite := VerticalLayout {
                padding: 4px;
                for s in p.servere-gasite: Rectangle {
                    height: 28px;
                    border-radius: 7px;
                    background: zs.has-hover ? Tema.strat : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 6px;
                        Text { text: s.nume; font-family: Tema.font-mono; font-size: 12.5px; color: Tema.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        if s.implicita: EticServer { text: "IMPLICITA"; }
                        if s.cluster: EticServer { text: "CLUSTER"; culoare: Tema.mod-text; }
                    }
                    zs := TouchArea { clicked => { root.server-ales(s.nume); } }
                }
            }
        }
        if !root.fara-servere && !p.auth-windows: HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                spacing: 6px;
                Eticheta { text: Texte.utilizator; }
                Camp {
                    text: p.utilizator;
                    schimbat(t) => { root.utilizator-schimbat(t); }
                }
            }
            VerticalLayout {
                spacing: 6px;
                Eticheta { text: Texte.parola; }
                Camp {
                    text: p.parola;
                    ascuns: true;
                    schimbat(t) => { root.parola-schimbata(t); }
                }
            }
        }
        VerticalLayout {
            spacing: 6px;
            Eticheta { text: root.multiplu ? Texte.baze : Texte.modificata; }
            Alegere {
                ales: root.multiplu ? p.eticheta-baze : p.baza;
                multiplu: root.multiplu;
                bifate: p.alese;
                optiuni: p.baze;
                gol: root.fara-servere ? Texte.alege-baza : Texte.conecteaza-te-intai;
                schimbat(t) => { root.baza-schimbata(t); }
                cerut => { root.cere-bazele(); }
            }
        }
        HorizontalLayout {
            alignment: start;
            Buton { text: Texte.testeaza-conexiunea; apasat => { root.testeaza(); } }
        }
        if p.stare != "": HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: p.fel-stare == 3 ? Tema.del-bara : p.fel-stare == 2 ? Tema.add-bara : Tema.text-tert;
                }
            }
            Text {
                text: p.stare;
                font-family: Tema.font-ui;
                font-size: 12.5px;
                color: p.fel-stare == 3 ? Tema.del-text : p.fel-stare == 2 ? Tema.add-text : Tema.text-secundar;
                vertical-alignment: center;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
        }
    }
}

export component FereastraConectare inherits Window {
    title: "gmotion";
    preferred-width: 1440px;
    preferred-height: 900px;
    background: Tema.fundal;
    default-font-family: Tema.font-ui;
    default-font-size: 13px;

    in property <ParteUi> sursa;
    in property <ParteUi> baza;
    in property <string> certificat;
    in property <string> instantaneu;
    in property <[RecentaUi]> recente;
    /// Ce lipseste ca sa se poata compara; gol = se poate.
    in property <string> ce-lipseste;
    /// Ultimele linii din jurnalul aplicatiei, cea mai noua la sfarsit.
    in property <[LinieJurnalUi]> jurnal;
    in-out property <bool> jurnal-ascuns: false;

    callback server-schimbat(bool, string);
    callback auth-schimbat(bool, bool);
    callback utilizator-schimbat(bool, string);
    callback parola-schimbata(bool, string);
    callback baza-schimbata(bool, string);
    callback cere-bazele(bool);
    callback cauta-servere(bool);
    callback server-ales(bool, string);
    callback inverseaza();
    callback schimba-certificatul();
    callback deschide-instantaneu();
    // fereastra de alegere a instantaneului: fisierele gasite pe disc si o
    // cale scrisa de mana
    in-out property <bool> alege-fisierul;
    in property <[string]> instantanee;
    in-out property <string> cale-scrisa;
    callback alege-instantaneul(string);
    callback compara();
    callback anuleaza();
    callback testeaza(bool);
    callback sterge-jurnalul();
    callback deschide-offline();
    callback compara-offline(string, string);
    callback inchide-offline();
    callback ajutor();
    in property <string> text-ajutor;
    in-out property <bool> arata-ajutorul;
    callback ignora-recenta(int);
    // fereastra de comparare offline: doua bucati de cod lipite
    in-out property <bool> offline;
    in-out property <string> offline-sursa;
    in-out property <string> offline-tinta;
    in property <string> offline-eroare;
    // compararea ruleaza pe alt fir: formularul se inlocuieste cu progresul
    in property <bool> ruleaza;
    in property <float> progres;
    in property <string> progres-text;
    in property <string> progres-timp;
    callback reia(int);
    callback alege-tema(bool);
    // comutatorul de limba: etichetele si indicele ales vin din Rust
    in property <[string]> limbi;
    in property <int> limba-aleasa;
    callback alege-limba(int);
    callback ecran-complet();

    taste := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.F11) { root.ecran-complet(); return accept; }
            if (e.text == Key.F1) { root.arata-ajutorul = !root.arata-ajutorul; root.ajutor(); return accept; }
            if (e.text == Key.Escape && root.arata-ajutorul) { root.arata-ajutorul = false; return accept; }
            if (e.text == Key.Escape && root.offline) { root.inchide-offline(); return accept; }
            if (e.text == Key.Escape && root.alege-fisierul) { root.alege-fisierul = false; return accept; }
            if (e.text == Key.Escape && root.ruleaza) { root.anuleaza(); return accept; }
            return reject;
        }
    VerticalLayout {
        Antet {
            loc: Texte.conectare;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 32px;
                    width: inst.preferred-width + 24px;
                    border-radius: 8px;
                    background: zi.has-hover ? Tema.strat : transparent;
                    inst := Text {
                        text: root.instantaneu == "" ? Texte.deschide-instantaneu : root.instantaneu;
                        font-family: root.instantaneu == "" ? Tema.font-ui : Tema.font-mono;
                        font-size: 13px;
                        color: Tema.text-secundar;
                    }
                    zi := TouchArea { clicked => { root.deschide-instantaneu(); } }
                }
            }
            VerticalLayout { alignment: center; Buton { text: Texte.comparare-offline; apasat => { root.deschide-offline(); } } }
            VerticalLayout { alignment: center; Buton { text: Texte.ajutor-tasta; apasat => { root.arata-ajutorul = true; root.ajutor(); } } }
            VerticalLayout { alignment: center; ButonTema { alege(i) => { root.alege-tema(i); } }
                }
                VerticalLayout {
                    alignment: center;
                    ButonLimba { limbi: root.limbi; aleasa: root.limba-aleasa; alege(i) => { root.alege-limba(i); } } }
        }

        // corpul
        VerticalLayout {
            vertical-stretch: 1;
            padding: 22px;
            padding-bottom: 16px;
            spacing: 14px;

            // cele doua parti, cu inversarea intre ele
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: 0px;
                PanouParte {
                    horizontal-stretch: 1;
                    p: root.sursa;
                    fara-servere: root.instantaneu != "";
                    server-schimbat(t) => { root.server-schimbat(true, t); }
                    auth-schimbat(w) => { root.auth-schimbat(true, w); }
                    utilizator-schimbat(t) => { root.utilizator-schimbat(true, t); }
                    parola-schimbata(t) => { root.parola-schimbata(true, t); }
                    baza-schimbata(t) => { root.baza-schimbata(true, t); }
                    cere-bazele => { root.cere-bazele(true); }
                    testeaza => { root.testeaza(true); }
                    cauta-servere => { root.cauta-servere(true); }
                    server-ales(t) => { root.server-ales(true, t); }
                }
                VerticalLayout {
                    width: 56px;
                    alignment: start;
                    padding-top: 22px;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 17px;
                            border-width: 1px;
                            border-color: Tema.linie;
                            background: inv.has-hover ? Tema.strat : Tema.suprafata;
                            Path {
                                width: 14px; height: 14px; viewbox-width: 16; viewbox-height: 16;
                                commands: "M 2 5 L 13 5 M 10 2 L 13 5 L 10 8 M 14 11 L 3 11 M 6 8 L 3 11 L 6 14";
                                stroke: Tema.text-secundar; stroke-width: 1.5px; fill: transparent;
                            }
                            inv := TouchArea { clicked => { root.inverseaza(); } }
                        }
                    }
                }
                PanouParte {
                    horizontal-stretch: 1;
                    p: root.baza;
                    multiplu: true;
                    fara-servere: root.instantaneu != "";
                    server-schimbat(t) => { root.server-schimbat(false, t); }
                    auth-schimbat(w) => { root.auth-schimbat(false, w); }
                    utilizator-schimbat(t) => { root.utilizator-schimbat(false, t); }
                    parola-schimbata(t) => { root.parola-schimbata(false, t); }
                    baza-schimbata(t) => { root.baza-schimbata(false, t); }
                    cere-bazele => { root.cere-bazele(false); }
                    testeaza => { root.testeaza(false); }
                    cauta-servere => { root.cauta-servere(false); }
                    server-ales(t) => { root.server-ales(false, t); }
                }
            }

            // certificatul si pornirea
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Text { text: root.certificat; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Rectangle {
                        // pe un instantaneu nu exista server, deci nici certificat
                        visible: root.certificat != "";
                        height: 24px;
                        width: schimba.preferred-width + 12px;
                        border-radius: 6px;
                        background: zc.has-hover ? Tema.strat : transparent;
                        schimba := Text { text: Texte.schimba; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.accent-text; }
                        zc := TouchArea { clicked => { root.schimba-certificatul(); } }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if !root.ruleaza: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Text {
                        text: root.ce-lipseste == "" ? Texte.doar-citire-mesaj : root.ce-lipseste;
                        font-family: Tema.font-ui;
                        font-size: 12.5px;
                        color: root.ce-lipseste == "" ? Tema.text-secundar : Tema.mod-text;
                    }
                }
                // butonul mare: activ doar cand nu lipseste nimic
                if !root.ruleaza: Rectangle {
                    height: 48px;
                    width: 220px;
                    border-radius: 12px;
                    background: root.ce-lipseste == "" ? Tema.accent : Tema.strat;
                    opacity: root.ce-lipseste == "" && zp.has-hover ? 0.88 : 1;
                    Text {
                        text: Texte.compara;
                        font-family: Tema.font-ui;
                        font-size: 15px;
                        font-weight: 600;
                        color: root.ce-lipseste == "" ? Tema.pe-accent : Tema.text-tert;
                    }
                    zp := TouchArea {
                        enabled: root.ce-lipseste == "";
                        clicked => { root.compara(); }
                    }
                }
                // cat ruleaza, in locul butonului: ce se citeste, de cat timp,
                // si Anuleaza. Fara asta fereastra pare inghetata (12 s pe o
                // baza adevarata).
                if root.ruleaza: VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: root.progres-text;
                            font-family: Tema.font-ui;
                            font-size: 13px;
                            color: Tema.text;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text { text: root.progres-timp; font-family: Tema.font-mono; font-size: 12px; color: Tema.text-secundar; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            Buton { text: Texte.opreste; apasat => { root.anuleaza(); } }
                        }
                    }
                    Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: Tema.strat;
                        Rectangle {
                            x: 0;
                            width: parent.width * Math.max(0.03, root.progres);
                            border-radius: 3px;
                            background: Tema.accent;
                        }
                    }
                }
            }

            // compararile recente, reluabile
            Card {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 14px;
                    padding-left: 18px;
                    padding-top: 12px;
                    spacing: 4px;
                    Text { text: Texte.comparari-recente; font-family: Tema.font-ui; font-size: 13px; font-weight: 600; color: Tema.text; }
                    if root.recente.length == 0: Text {
                        text: Texte.nicio-comparare;
                        font-family: Tema.font-ui;
                        font-size: 12.5px;
                        color: Tema.text-tert;
                    }
                    ListView {
                        vertical-stretch: 1;
                        for s[i] in root.recente: Rectangle {
                            height: 34px;
                            border-radius: 8px;
                            background: rand.has-hover ? Tema.strat : transparent;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 12px;
                                HorizontalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 8px;
                                    alignment: start;
                                    Text { text: s.sursa; font-family: Tema.font-mono; font-size: 12.5px; color: Tema.text; vertical-alignment: center; }
                                    Text { text: "→"; font-family: Tema.font-mono; color: Tema.text-tert; vertical-alignment: center; }
                                    Text { text: s.baza; font-family: Tema.font-mono; font-size: 12.5px; color: Tema.text; vertical-alignment: center; }
                                }
                                Text { width: 160px; text: s.cand; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; vertical-alignment: center; }
                                Text { width: 220px; text: s.progres; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; vertical-alignment: center; overflow: elide; }
                                Text { width: 70px; text: Texte.continua; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.accent-text; horizontal-alignment: right; vertical-alignment: center; }
                                // „Ignora": sterge progresul salvat al compararii
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: ig.preferred-width + 14px;
                                        height: 24px;
                                        border-radius: 6px;
                                        background: zig.has-hover ? Tema.strat : transparent;
                                        opacity: rand.has-hover ? 1 : 0;
                                        ig := Text { text: Texte.ignora; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-secundar; }
                                        zig := TouchArea { clicked => { root.ignora-recenta(i); } }
                                    }
                                }
                            }
                            rand := TouchArea { clicked => { root.reia(i); } }
                        }
                    }
                }
            }
        }

        // jurnalul: o banda jos, pe toata latimea, din jurnalul aplicatiei
        Rectangle {
            height: root.jurnal-ascuns ? 40px : 132px;
            background: Tema.suprafata;
            Rectangle { y: 0; height: 1px; background: Tema.linie; }
            VerticalLayout {
                padding-left: 24px;
                padding-right: 16px;
                padding-top: 6px;
                padding-bottom: 10px;
                spacing: 6px;
                HorizontalLayout {
                    height: 28px;
                    spacing: 12px;
                    Text { text: Texte.jurnal; font-family: Tema.font-ui; font-size: 13px; font-weight: 600; color: Tema.text; vertical-alignment: center; }
                    Text { text: Texte.ce-face-aplicatia; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-tert; vertical-alignment: center; horizontal-stretch: 1; }
                    Rectangle {
                        width: ta.preferred-width + 20px;
                        border-radius: 7px;
                        background: zj.has-hover ? Tema.strat : transparent;
                        ta := Text { text: root.jurnal-ascuns ? Texte.arata : Texte.ascunde; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; }
                        zj := TouchArea { clicked => { root.jurnal-ascuns = !root.jurnal-ascuns; } }
                    }
                    Rectangle {
                        width: ts.preferred-width + 20px;
                        border-radius: 7px;
                        background: zst.has-hover ? Tema.strat : transparent;
                        ts := Text { text: Texte.sterge-log; font-family: Tema.font-ui; font-size: 12.5px; color: Tema.text-secundar; }
                        zst := TouchArea { clicked => { root.sterge-jurnalul(); } }
                    }
                }
                if !root.jurnal-ascuns: VerticalLayout {
                    spacing: 2px;
                    alignment: start;
                    if root.jurnal.length == 0: Text { text: Texte.inca-nimic; font-family: Tema.font-ui; font-size: 12px; color: Tema.text-tert; }
                    for l in root.jurnal: HorizontalLayout {
                        height: 18px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: l.nivel == 3 ? Tema.del-bara : l.nivel == 2 ? Tema.mod-bara : Tema.text-tert;
                            }
                        }
                        Text {
                            text: l.text;
                            font-family: Tema.font-mono;
                            font-size: 11.5px;
                            color: l.nivel == 3 ? Tema.del-text : l.nivel == 2 ? Tema.mod-text : Tema.text-secundar;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
    }

    // ---- compararea offline: doua bucati de cod lipite, fara server
    if root.offline: Rectangle {
        background: Tema.intunecat ? #00000099 : #0f111566;
        TouchArea { }
        Rectangle {
            width: Math.min(root.width - 80px, 1000px);
            height: Math.min(root.height - 80px, 620px);
            border-radius: 14px;
            border-width: 1px;
            border-color: Tema.linie;
            background: Tema.suprafata;
            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                HorizontalLayout {
                    Text { text: Texte.comparare-offline; font-family: Tema.font-ui; font-size: 16px; font-weight: 600; color: Tema.text; horizontal-stretch: 1; }
                    Buton { text: Texte.inchide-esc; apasat => { root.inchide-offline(); } }
                }
                Text {
                    text: Texte.lipeste-codul;
                    font-family: Tema.font-ui;
                    font-size: 12.5px;
                    color: Tema.text-secundar;
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        Eticheta { text: Texte.martor; }
                        PanouCod { text <=> root.offline-sursa; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        Eticheta { text: Texte.modificata; }
                        PanouCod { text <=> root.offline-tinta; }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: root.offline-eroare;
                        font-family: Tema.font-ui;
                        font-size: 12.5px;
                        color: Tema.del-text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    ButonPrincipal {
                        text: Texte.compara;
                        apasat => { root.compara-offline(root.offline-sursa, root.offline-tinta); }
                    }
                }
            }
        }
    }

    if root.arata-ajutorul: Ajutor {
        text: root.text-ajutor;
        inchide => { root.arata-ajutorul = false; }
    }

    // ---- „Deschide un instantaneu": fisierele gasite, sau o cale scrisa
    if root.alege-fisierul: Rectangle {
        background: Tema.intunecat ? #00000099 : #0f111566;
        TouchArea { clicked => { root.alege-fisierul = false; } }
        Rectangle {
            width: Math.min(root.width - 80px, 720px);
            height: Math.min(root.height - 80px, 480px);
            border-radius: 14px;
            border-width: 1px;
            border-color: Tema.linie;
            background: Tema.suprafata;
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                HorizontalLayout {
                    Text { text: Texte.deschide-instantaneu; font-family: Tema.font-ui; font-size: 16px; font-weight: 600; color: Tema.text; horizontal-stretch: 1; }
                    Buton { text: Texte.inchide-esc; apasat => { root.alege-fisierul = false; } }
                }
                if root.instantanee.length == 0: Text {
                    text: Texte.niciun-json;
                    font-family: Tema.font-ui;
                    font-size: 12.5px;
                    color: Tema.text-tert;
                    wrap: word-wrap;
                }
                ListView {
                    vertical-stretch: 1;
                    for f in root.instantanee: Rectangle {
                        height: 30px;
                        border-radius: 7px;
                        background: zf.has-hover ? Tema.strat : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            Text {
                                text: f;
                                font-family: Tema.font-mono;
                                font-size: 12.5px;
                                color: Tema.text;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        zf := TouchArea { clicked => { root.alege-instantaneul(f); } }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 34px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Tema.linie;
                        background: Tema.fundal;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            TextInput {
                                text <=> root.cale-scrisa;
                                font-family: Tema.font-mono;
                                font-size: 12.5px;
                                color: Tema.text;
                                vertical-alignment: center;
                                single-line: true;
                                accepted => { root.alege-instantaneul(self.text); }
                            }
                        }
                        if root.cale-scrisa == "": Text {
                            x: 12px;
                            text: Texte.sau-scrie-calea;
                            font-family: Tema.font-ui;
                            font-size: 12.5px;
                            color: Tema.text-tert;
                            vertical-alignment: center;
                        }
                    }
                    ButonPrincipal { text: Texte.deschide; apasat => { root.alege-instantaneul(root.cale-scrisa); } }
                }
            }
        }
    }

    init => { taste.focus(); }
}
