// Schita de fezabilitate: Harta (lista obiectelor) si Panza (editorul).
// Cercetare, nu cod livrat. In aplicatie culorile se muta in
// rust/fereastra/src/jetoane.rs (regula „nicio culoare in .slint"), unde le
// vede testul de contrast; aici stau intr-un singur global, ca sa fie un loc.

import { ListView } from "std-widgets.slint";

import "../fonturi/Geist-300.ttf";
import "../fonturi/Geist-400.ttf";
import "../fonturi/Geist-500.ttf";
import "../fonturi/Geist-600.ttf";
import "../fonturi/GeistMono-400.ttf";
import "../fonturi/GeistMono-500.ttf";

export global P {
    out property <string> ui: "Geist";
    out property <string> mono: "Geist Mono";
    // --- Harta (intunecat)
    out property <color> h-fond: #0d1120;
    out property <color> h-strat: #151a2e;
    out property <color> h-strat-2: #1d2440;
    out property <color> h-linie: #2a3255;
    out property <color> h-text: #eef1ff;
    out property <color> h-sec: #a3acd0;
    out property <color> h-tert: #7f88ae;
    out property <color> mod: #ffb547;
    out property <color> add: #3ddc97;
    out property <color> del: #ff6b81;
    out property <color> set: #8f9bff;
    out property <color> ident: #232a45;
    out property <color> prod: #d92b2b;
    out property <color> h-minus: #ff6b8121;
    out property <color> h-plus: #3ddc9721;
    out property <color> h-tare: #ffb54759;
    out property <color> h-cuvant: #8fb4ff;
    out property <color> h-sir: #ffcf8a;
    out property <color> h-var: #d6a8ff;
    // --- Panza (luminos)
    out property <color> p-fond: #ffffff;
    out property <color> p-text: #0f1115;
    out property <color> p-sec: #5d6370;
    out property <color> p-tert: #5f6572;
    out property <color> p-stins: #8b919d; // doar text mare (48 px): pragul e 3:1
    out property <color> p-linie: #e8eaee;
    out property <color> p-hover: #f3f4f6;
    out property <color> p-mod: #f5a524;
    // numerele de linie: textul trebuie sa treaca 4,5:1 si pe fundalul colorat
    out property <color> p-nr: #5f6572;
    out property <color> p-nr-mod: #9a6200;
    out property <color> p-nr-add: #12703b;
    out property <color> p-nr-del: #c40e4a;
    out property <color> p-add: #17c964;
    out property <color> p-del: #c40e4a;
    out property <color> p-tare: #f5a52473;
    out property <color> p-cuvant: #7828c8;
    out property <color> p-sir: #b13a0a;
    out property <color> p-var: #005fd1;
    out property <color> p-umbra: #0f11152e;
    out property <color> p-voal: #ffffffb3;
}

// o bucata de text de aceeasi culoare; s: 0 text, 1 cuvant, 2 variabila,
// 3 numar, 4 sir, 5 comentariu
export struct BucataUi { text: string, s: int, tare: bool }

// ---------------------------------------------------------------- Harta

export struct GrupUi {
    x: length, y: length, w: length, h: length,
    titlu: string, contor: string, rest: string,
    imagine: image, proportie: float,
}

// k: 0 identic, 1 minus, 2 plus
export struct LinieH { nr: string, k: int, pliu: string, bucati: [BucataUi] }

component BucatiH inherits HorizontalLayout {
    in property <[BucataUi]> bucati;
    for b in bucati: Rectangle {
        background: b.tare ? P.h-tare : transparent;
        border-radius: 2px;
        Text {
            text: b.text;
            font-family: P.mono; font-size: 12px;
            color: b.s == 1 ? P.h-cuvant : b.s == 2 ? P.h-var : (b.s == 3 || b.s == 4) ? P.h-sir : b.s == 5 ? P.h-tert : P.h-text;
            font-italic: b.s == 5;
        }
    }
}

component ButonH inherits Rectangle {
    in property <string> eticheta;
    in property <string> tasta;
    in property <bool> principal;
    callback apasat;
    height: 36px;
    min-width: rand.preferred-width + 32px;
    border-radius: 8px;
    background: principal ? P.mod : (zona.has-hover ? P.h-linie : P.h-strat-2);
    border-width: principal ? 0 : 1px;
    border-color: P.h-linie;
    rand := HorizontalLayout {
        alignment: center; spacing: 6px;
        Text { text: eticheta; font-family: P.ui; font-size: 13px; font-weight: principal ? 600 : 400; color: principal ? #1a1200 : P.h-text; vertical-alignment: center; }
        Text { text: tasta; font-family: P.mono; font-size: 11px; color: principal ? #1a120099 : P.h-tert; vertical-alignment: center; }
    }
    zona := TouchArea { clicked => { apasat(); } }
}

export component Harta inherits Window {
    preferred-width: 1440px; preferred-height: 900px;
    background: P.h-fond;
    default-font-family: P.ui;

    in property <string> sursa;
    in property <string> tinta;
    in property <string> nr-mod; in property <string> nr-add; in property <string> nr-del; in property <string> procent;
    in property <string> titlu-nr; in property <string> titlu-rest;
    in property <[GrupUi]> grupuri;
    in property <length> harta-h;
    // obiectul selectat
    in property <length> sel-x; in property <length> sel-y;
    in property <string> o-stare; in property <color> o-culoare;
    in property <string> o-schema; in property <string> o-nume; in property <string> o-fraza;
    in property <[LinieH]> o-linii;
    in property <string> plan-nr;
    // bula de la hover, umpluta din Rust dupa coordonate
    in-out property <string> bula;
    in-out property <length> bula-x; in-out property <length> bula-y;
    callback mouse(int /* grup */, length, length);
    callback click(int, length, length);

    VerticalLayout {
        // ---- antet
        Rectangle {
            height: 72px;
            HorizontalLayout {
                padding-left: 28px; padding-right: 28px; spacing: 28px;
                HorizontalLayout {
                    alignment: start; spacing: 0; horizontal-stretch: 0;
                    Text { text: "g"; font-size: 19px; font-weight: 600; color: P.h-text; vertical-alignment: center; }
                    Rectangle { width: 9px; Rectangle { width: 7px; height: 7px; y: parent.height / 2 - 1px; border-radius: 3.5px; background: P.mod; } }
                    Text { text: "motion"; font-size: 19px; font-weight: 600; color: P.h-text; vertical-alignment: center; letter-spacing: -0.4px; }
                }
                HorizontalLayout {
                    spacing: 10px; alignment: start; horizontal-stretch: 0;
                    Text { text: sursa; font-size: 13px; font-weight: 500; color: P.h-text; vertical-alignment: center; }
                    Text { text: "→"; font-family: P.mono; font-size: 13px; color: P.h-tert; vertical-alignment: center; }
                    Text { text: tinta; font-size: 13px; font-weight: 500; color: P.h-text; vertical-alignment: center; }
                    VerticalLayout { alignment: center;
                        Rectangle { height: 20px; width: 46px; border-radius: 4px; background: P.prod;
                            Text { text: "PROD"; font-size: 11px; font-weight: 600; color: white; letter-spacing: 0.5px; } } }
                }
                Rectangle { horizontal-stretch: 1; }
                for c in [
                    { n: nr-mod, e: "modificate", col: P.mod },
                    { n: nr-add, e: "doar în sursă", col: P.add },
                    { n: nr-del, e: "doar în bază", col: P.del },
                    { n: procent, e: "revizuit", col: P.h-text },
                ]: VerticalLayout {
                    alignment: center; spacing: 0;
                    Text { text: c.n; font-size: 22px; font-weight: 600; color: c.col; horizontal-alignment: right; letter-spacing: -0.5px; }
                    Text { text: c.e; font-size: 11.5px; color: P.h-sec; horizontal-alignment: right; }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: P.h-linie; }
        }

        HorizontalLayout {
            // ---- harta
            Flickable {
                horizontal-stretch: 1;
                content-height: harta-h + 150px;
                HorizontalLayout { x: 28px; y: 22px; spacing: 9px; alignment: start;
                    Text { text: titlu-nr; font-size: 28px; font-weight: 600; color: P.h-text; letter-spacing: -0.8px; }
                    Text { text: titlu-rest; font-size: 28px; font-weight: 300; color: P.h-text; letter-spacing: -0.8px; } }
                Text { x: 28px; y: 64px; text: "Fiecare pătrat e un obiect care diferă, grupat pe schemă și tip. Bara de sub grup arată cât din el e identic."; font-size: 13px; color: P.h-sec; }
                for g[i] in grupuri: Rectangle {
                    x: g.x; y: g.y; width: g.w; height: g.h;
                    Text { x: 0; y: 0; text: g.titlu; font-size: 12px; font-weight: 600; color: P.h-sec; }
                    Text { x: parent.width - self.width; y: 0; text: g.contor; font-size: 12px; font-weight: 600; color: P.h-sec; }
                    img := Image { x: 0; y: 24px; source: g.imagine; image-rendering: pixelated; }
                    TouchArea {
                        x: img.x; y: img.y; width: img.width; height: img.height;
                        moved => { mouse(i, self.mouse-x, self.mouse-y); }
                        clicked => { click(i, self.mouse-x, self.mouse-y); }
                    }
                    // cat din grup e identic: o bara subtire, cu numarul
                    Rectangle { x: 0; y: parent.height - 22px; width: parent.width; height: 4px; border-radius: 2px; background: P.ident;
                        Rectangle { x: 0; width: parent.width * max(0.015, g.proportie); border-radius: 2px; background: P.h-tert; } }
                    Text { x: 0; y: parent.height - 14px; text: g.rest; font-size: 11px; color: P.h-tert; }
                }
                // selectia: un contur peste pictura, pus din Rust
                Rectangle { x: sel-x - 3px; y: sel-y - 3px; width: 20px; height: 20px; border-radius: 5px; border-width: 2px; border-color: white; }
                // legenda
                HorizontalLayout {
                    x: 28px; y: harta-h + 30px; height: 18px; spacing: 18px; alignment: start;
                    for l in [{ c: P.mod, t: "modificat" }, { c: P.add, t: "doar în sursă" }, { c: P.del, t: "doar în bază" }, { c: P.set, t: "doar setări SET" }, { c: P.mod.with-alpha(0.35), t: "revizuit" }]:
                        HorizontalLayout { spacing: 6px; alignment: start;
                            VerticalLayout { alignment: center; Rectangle { width: 10px; height: 10px; border-radius: 2px; background: l.c; } }
                            Text { text: l.t; font-size: 12px; color: P.h-sec; } }
                }
            }

            // ---- panoul obiectului
            Rectangle {
                width: 520px;
                background: P.h-strat;
                Rectangle { x: 0; width: 1px; background: P.h-linie; }
                VerticalLayout {
                    padding: 26px; padding-top: 24px; spacing: 0;
                    HorizontalLayout { spacing: 8px; alignment: start;
                        VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: o-culoare; } }
                        Text { text: o-stare; font-size: 12px; font-weight: 600; color: o-culoare; } }
                    HorizontalLayout { padding-top: 8px; padding-bottom: 6px; alignment: start;
                        Text { text: o-schema; font-family: P.mono; font-size: 22px; color: P.h-tert; letter-spacing: -0.6px; }
                        Text { text: o-nume; font-family: P.mono; font-size: 22px; font-weight: 500; color: P.h-text; letter-spacing: -0.6px; overflow: elide; horizontal-stretch: 1; } }
                    Text { text: o-fraza; font-size: 13.5px; color: P.h-sec; wrap: word-wrap; }
                    HorizontalLayout { padding-top: 16px; padding-bottom: 18px; spacing: 8px; alignment: start;
                        ButonH { eticheta: "Revizuit"; tasta: "r"; }
                        ButonH { eticheta: "Pune în plan"; tasta: "p"; principal: true; }
                        ButonH { eticheta: "Deschide"; tasta: "↵"; } }
                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: 10px; border-width: 1px; border-color: P.h-linie; background: P.h-fond;
                        clip: true;
                        ListView {
                            for l in o-linii: Rectangle {
                                height: 21px;
                                background: l.k == 1 ? P.h-minus : l.k == 2 ? P.h-plus : transparent;
                                if l.pliu != "": Text { x: 58px; text: l.pliu; font-size: 12px; color: P.h-tert; vertical-alignment: center; }
                                if l.pliu == "": HorizontalLayout {
                                    Text { width: 40px; text: l.nr; font-family: P.mono; font-size: 12px; color: P.h-tert; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { width: 22px; text: l.k == 1 ? "−" : l.k == 2 ? "+" : ""; font-family: P.mono; font-size: 12px; horizontal-alignment: center; vertical-alignment: center;
                                        color: l.k == 1 ? P.del : P.add; }
                                    BucatiH { bucati: l.bucati; }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 62px + 16px;
                        Rectangle {
                            y: 16px; height: 62px; border-radius: 10px; background: P.h-strat-2;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 14px; spacing: 12px;
                                Text { text: plan-nr; font-size: 20px; font-weight: 600; color: P.h-text; vertical-alignment: center; }
                                Text { text: "obiecte în plan, ordonate după dependențe"; font-size: 12.5px; color: P.h-sec; vertical-alignment: center; horizontal-stretch: 1; }
                                VerticalLayout { alignment: center;
                                    Rectangle { height: 34px; width: 80px; border-radius: 8px; background: P.prod;
                                        Text { text: "Deploy"; font-size: 13px; font-weight: 600; color: white; } } }
                            }
                        }
                    }
                }
            }
        }
    }

    // bula: deasupra a tot, pusa din Rust
    if bula != "": Rectangle {
        x: bula-x + 14px; y: bula-y + 14px;
        width: bt.preferred-width + 20px; height: 26px;
        border-radius: 6px; background: white;
        bt := Text { text: bula; font-family: P.mono; font-size: 12px; font-weight: 500; color: P.h-fond; }
    }
}

// ---------------------------------------------------------------- Panza

// k: 0 identic, 1 schimbat; pliu: textul plierii (atunci restul nu conteaza)
export struct LinieP { k: int, pliu: string, nr-st: string, nr-dr: string, st: [BucataUi], dr: [BucataUi] }
export struct SemnP { k: int /* 0 nimic 1 mod 2 add 3 del 4 curent */ }
export struct ComandaUi { grup: string, text: string, sub: string, punct: color, mono: bool, activ: bool }

component BucatiP inherits HorizontalLayout {
    in property <[BucataUi]> bucati;
    for b in bucati: Rectangle {
        background: b.tare ? P.p-tare : transparent;
        border-radius: 3px;
        Text {
            text: b.text;
            font-family: P.mono; font-size: 13px;
            color: b.s == 1 ? P.p-cuvant : b.s == 2 ? P.p-var : (b.s == 3 || b.s == 4) ? P.p-sir : b.s == 5 ? P.p-tert : P.p-text;
            font-italic: b.s == 5;
        }
    }
}

component Hud inherits Rectangle {
    background: P.p-fond;
    border-radius: 14px; border-width: 1px; border-color: P.p-linie;
    drop-shadow-blur: 30px; drop-shadow-offset-y: 8px; drop-shadow-color: P.p-umbra;
}

component Tasta inherits Rectangle {
    in property <string> t;
    in property <bool> pe-inchis;
    height: 18px; width: tx.preferred-width + 10px; border-radius: 5px;
    background: pe-inchis ? #2a2d35 : #f0f1f4;
    tx := Text { text: t; font-family: P.mono; font-size: 11px; color: pe-inchis ? #c5c9d2 : P.p-sec; }
}

component ButonP inherits Rectangle {
    in property <string> eticheta;
    in property <string> tasta;
    in property <bool> principal;
    height: 38px; width: r.preferred-width + 28px; border-radius: 10px;
    background: principal ? P.p-text : (z.has-hover ? P.p-hover : transparent);
    r := HorizontalLayout { alignment: center; spacing: 8px;
        Text { text: eticheta; font-size: 14px; color: principal ? white : P.p-text; vertical-alignment: center; }
        if tasta != "": VerticalLayout { alignment: center; Tasta { t: tasta; pe-inchis: principal; } } }
    z := TouchArea { }
}

export component Panza inherits Window {
    preferred-width: 1440px; preferred-height: 900px;
    background: P.p-fond;
    default-font-family: P.ui;

    in property <string> sursa; in property <string> tinta;
    in property <string> tip; in property <string> schema; in property <string> nume; in property <string> fraza;
    in property <string> eticheta-st; in property <string> eticheta-dr;
    in property <[LinieP]> linii;
    in property <[SemnP]> rigla;
    in property <string> revizuite; in property <string> din;
    in property <string> arc;   // calea inelului de progres, calculata in Rust
    in property <string> plan;
    in property <bool> paleta;
    in property <string> cautare;
    in property <[ComandaUi]> comenzi;

    // ---- panza: titlul fix sus, codul virtualizat dedesubt
    VerticalLayout {
        x: 0; y: 0; width: root.width; height: root.height;
        padding-top: 96px;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(1180px, root.width - 80px);
                spacing: 0;
                Text { text: tip; font-size: 13px; color: P.p-sec; }
                HorizontalLayout { alignment: start; padding-top: 4px; padding-bottom: 8px;
                    Text { text: schema; font-size: 48px; font-weight: 300; color: P.p-stins; letter-spacing: -2px; }
                    Text { text: nume; font-size: 48px; font-weight: 600; color: P.p-text; letter-spacing: -2px; overflow: elide; horizontal-stretch: 1; } }
                Text { text: fraza; font-size: 17px; color: P.p-sec; wrap: word-wrap; }
                HorizontalLayout { padding-top: 26px; padding-bottom: 8px; spacing: 28px;
                    Text { text: eticheta-st; font-size: 12px; font-weight: 500; color: P.p-tert; horizontal-stretch: 1; }
                    Text { text: eticheta-dr; font-size: 12px; font-weight: 500; color: P.p-tert; horizontal-stretch: 1; } }
            }
        }
        HorizontalLayout {
            alignment: center;
            vertical-stretch: 1;
            ListView {
                width: min(1180px + 40px, root.width - 40px);
                for l in linii: Rectangle {
                    height: l.pliu != "" ? 38px : 24px;
                    if l.pliu != "": Rectangle {
                        x: 20px; width: parent.width - 40px;
                        Rectangle { y: 6px; height: 1px; background: P.p-linie; }
                        Rectangle { y: parent.height - 7px; height: 1px; background: P.p-linie; }
                        Text { text: l.pliu; font-size: 12px; color: P.p-tert; }
                    }
                    if l.pliu == "": HorizontalLayout {
                        padding-left: 20px; padding-right: 20px; spacing: 28px;
                        for parte[j] in [{ nr: l.nr-st, b: l.st }, { nr: l.nr-dr, b: l.dr }]: Rectangle {
                            horizontal-stretch: 1; min-width: 0px; preferred-width: 0px;
                            border-radius: 6px; clip: true;
                            // k: 1 modificat, 2 se adauga, 3 se sterge — fundalul doar pe partea care are linia
                            background: (l.k == 1) ? @linear-gradient(90deg, #f5a52429 0%, #f5a5240a 100%)
                                : (l.k == 2 && j == 1) ? @linear-gradient(90deg, #17c96429 0%, #17c9640a 100%)
                                : (l.k == 3 && j == 0) ? @linear-gradient(90deg, #f3126024 0%, #f312600a 100%)
                                : transparent;
                            HorizontalLayout {
                                Text { width: 36px; text: parte.nr; font-family: P.mono; font-size: 13px; horizontal-alignment: right; vertical-alignment: center;
                                    color: (l.k == 1) ? P.p-nr-mod : (l.k == 2 && j == 1) ? P.p-nr-add : (l.k == 3 && j == 0) ? P.p-nr-del : P.p-nr;
                                    font-weight: l.k == 0 ? 400 : 500; }
                                Rectangle { width: 12px; }
                                BucatiP { bucati: parte.b; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                }
            }
        }
        Rectangle { height: 120px; }
    }

    // ---- rigla diferentelor, in stanga
    VerticalLayout {
        x: 18px; y: (root.height - self.preferred-height) / 2;
        spacing: 4px;
        for s in rigla: Rectangle {
            width: s.k == 4 ? 34px : 22px; height: 4px; border-radius: 2px;
            background: s.k == 1 ? P.p-mod : s.k == 2 ? P.p-add : s.k == 3 ? P.p-del : s.k == 4 ? P.p-text : #e3e5ea;
        }
    }

    // ---- insulele care plutesc
    Hud {
        x: 18px; y: 18px; height: 44px; width: hs.preferred-width + 20px;
        hs := HorizontalLayout { padding-left: 7px; padding-right: 12px; spacing: 10px;
            VerticalLayout { alignment: center; Rectangle { width: 30px; height: 30px; border-radius: 9px; background: P.p-text;
                Text { text: "g"; font-size: 15px; font-weight: 600; color: white; } } }
            Text { text: sursa; font-size: 13px; font-weight: 600; color: P.p-text; vertical-alignment: center; }
            Text { text: "→"; font-family: P.mono; font-size: 13px; color: P.p-tert; vertical-alignment: center; }
            Text { text: tinta; font-size: 13px; font-weight: 600; color: P.p-text; vertical-alignment: center; }
            VerticalLayout { alignment: center; Rectangle { height: 18px; width: 40px; border-radius: 6px; background: P.p-del;
                Text { text: "PROD"; font-family: P.mono; font-size: 11px; font-weight: 500; color: white; } } }
        }
    }
    Hud {
        x: root.width - self.width - 18px; y: 18px; height: 46px; width: hd.preferred-width + 16px;
        hd := HorizontalLayout { padding-left: 6px; padding-right: 12px; spacing: 8px;
            VerticalLayout { alignment: center;
                Rectangle { width: 34px; height: 34px;
                    Path { width: 34px; height: 34px; viewbox-width: 36; viewbox-height: 36; stroke: #eceef2; stroke-width: 4px; commands: "M 18 3 A 15 15 0 1 1 17.99 3"; }
                    Path { width: 34px; height: 34px; viewbox-width: 36; viewbox-height: 36; stroke: P.p-text; stroke-width: 4px; commands: arc; } } }
            Text { text: revizuite; font-size: 12.5px; font-weight: 600; color: P.p-text; vertical-alignment: center; }
            Text { text: din; font-size: 12.5px; color: P.p-sec; vertical-alignment: center; }
        }
    }
    Hud {
        x: (root.width - self.width) / 2; y: root.height - self.height - 36px; height: 50px; width: hj.preferred-width + 12px;
        hj := HorizontalLayout { padding: 6px; spacing: 4px;
            ButonP { eticheta: "←"; tasta: "k"; }
            ButonP { eticheta: "Obiecte"; tasta: "Ctrl K"; }
            VerticalLayout { alignment: center; Rectangle { width: 1px; height: 22px; background: P.p-linie; } }
            ButonP { eticheta: "Revizuit"; tasta: "r"; }
            ButonP { eticheta: "Pune în plan"; tasta: "p"; principal: true; }
            VerticalLayout { alignment: center; Rectangle { width: 1px; height: 22px; background: P.p-linie; } }
            ButonP { eticheta: plan; tasta: ""; }
            ButonP { eticheta: "→"; tasta: "j"; }
        }
    }

    // ---- paleta Ctrl K: un strat peste panza, nu o fereastra noua
    if paleta: Rectangle {
        background: P.p-voal;
        TouchArea { }
        Rectangle {
            x: (parent.width - self.width) / 2; y: parent.height * 0.14;
            width: min(640px, parent.width - 32px); height: cv.preferred-height;
            background: P.p-fond; border-radius: 18px; border-width: 1px; border-color: P.p-linie;
            drop-shadow-blur: 60px; drop-shadow-offset-y: 24px; drop-shadow-color: #0f111559;
            cv := VerticalLayout {
                Rectangle { height: 58px;
                    Text { x: 20px; text: cautare; font-size: 18px; color: P.p-text; vertical-alignment: center; }
                    Rectangle { y: parent.height - 1px; height: 1px; background: P.p-linie; } }
                VerticalLayout { padding: 8px;
                    for c in comenzi: VerticalLayout {
                        if c.grup != "": HorizontalLayout { padding-left: 12px; height: 30px; Text { text: c.grup; font-size: 12px; color: P.p-tert; vertical-alignment: bottom; } }
                        Rectangle { height: 40px; border-radius: 10px; background: c.activ ? P.p-hover : transparent;
                            HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 12px;
                                VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: c.punct; } }
                                Text { text: c.text; font-family: c.mono ? P.mono : P.ui; font-size: c.mono ? 13px : 14px; color: P.p-text; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: c.sub; font-size: 12.5px; color: P.p-tert; vertical-alignment: center; } } }
                    }
                }
            }
        }
    }
}
